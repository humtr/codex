+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread")]
+async fn bound_chat_synchronization_orders_native_input_and_retains_cancelled_or_failed_drafts() {
+    use std::os::unix::fs::PermissionsExt;
+    for scenario in ["ready", "cancel", "failure"] {
+        let root = tempfile::tempdir().unwrap();
+        let binary = root.path().join("provider");
+        let shell = std::env::var_os("PREFIX")
+            .map(PathBuf::from)
+            .map(|prefix| prefix.join("bin/sh"))
+            .unwrap_or_else(|| PathBuf::from("/bin/sh"));
+        std::fs::write(&binary, format!(r##"#!{}
+: > "$6/observed"
+if [ -f "$6/failure" ]; then printf '{{"error":"bound_chat_native_route_changed"}}'; exit 2; fi
+if [ -f "$6/ready" ]; then
+  printf '{{"thread_id":"%s","status":"ready","inference_submitted":false}}' "$4"
+else
+  printf '{{"thread_id":"%s","status":"waiting","reason":"bound_chat_turn_active","retry_after_seconds":1,"inference_submitted":false}}' "$4"
+fi
+"##, shell.display())).unwrap();
+        std::fs::set_permissions(&binary, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let profile = root.path().join("chatgpt.config.toml");
+        std::fs::write(&profile, format!(
+            "# codex-chatgpt-provider generated v1\nmodel_provider=\"chatgpt_desktop\"\nmodel_catalog_json=\"/catalog.json\"\n[model_providers.chatgpt_desktop]\nbase_url=\"http://127.0.0.1:12345/v1\"\nwire_api=\"responses\"\nrequires_openai_auth=false\n[model_providers.chatgpt_desktop.auth]\ncommand={binary:?}\nargs=[\"token\",\"--state\",{:?}]\n", root.path()
+        )).unwrap();
+        std::fs::set_permissions(&profile, std::fs::Permissions::from_mode(0o600)).unwrap();
+        let (mut chat, mut events, mut operations) = make_chatwidget_manual(None).await;
+        chat.config.codex_home =
+            codex_utils_absolute_path::AbsolutePathBuf::try_from(root.path()).unwrap();
+        chat.config.model_provider_id = crate::termux_chat_models::PROVIDER.into();
+        chat.thread_id = Some(ThreadId::new());
+        if scenario == "cancel" {
+            handle_turn_started(&mut chat, "external-source");
+        }
+        let image = root.path().join("image.png");
+        image::RgbImage::new(2, 2).save(&image).unwrap();
+        chat.handle_paste(image.display().to_string());
+        chat.handle_paste("describe $file".into());
+        chat.bottom_pane.set_composer_text_with_mention_bindings(
+            chat.bottom_pane.composer_text(),
+            chat.bottom_pane.composer_text_elements(),
+            vec![image],
+            vec![MentionBinding {
+                sigil: '$',
+                mention: "file".into(),
+                path: "/skills/file/SKILL.md".into(),
+            }],
+        );
+        let original = chat.bottom_pane.composer_draft_snapshot();
+        chat.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        tokio::time::timeout(Duration::from_secs(5), async {
+            while !root.path().join("observed").exists() {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .expect("source observation started");
+        assert_no_submit_op(&mut operations);
+        assert!(chat.pending_input_submission.is_some());
+        if scenario == "cancel" {
+            chat.handle_key_event(KeyEvent::new(KeyCode::Char('c'), KeyModifiers::CONTROL));
+            assert!(
+                chat.turn_lifecycle.agent_turn_running,
+                "cancel the draft before interrupting the existing source turn"
+            );
+        } else {
+            std::fs::write(root.path().join(scenario), "").unwrap();
+            tokio::time::timeout(Duration::from_secs(5), async {
+                loop {
+                    if let AppEvent::InputPrepared(id) = events.recv().await.unwrap() {
+                        chat.on_input_prepared(id);
+                        break;
+                    }
+                }
+            })
+            .await
+            .expect("source settled or reported its original failure");
+        }
+        if scenario == "ready" {
+            assert_matches!(next_submit_op(&mut operations), Op::UserTurn {items, ..}
+                if items.iter().any(|item| matches!(item, UserInput::Text {text, ..} if text == &original.text))
+                    && items.iter().any(|item| matches!(item, UserInput::Image {..} | UserInput::LocalImage {..})));
+        } else {
+            assert_no_submit_op(&mut operations);
+            let restored = chat.bottom_pane.composer_draft_snapshot();
+            assert_eq!(
+                (
+                    restored.text,
+                    restored.text_elements,
+                    restored.local_images,
+                    restored.mention_bindings
+                ),
+                (
+                    original.text,
+                    original.text_elements,
+                    original.local_images,
+                    original.mention_bindings
+                )
+            );
+        }
+        assert!(chat.pending_input_submission.is_none());
+    }
+}
