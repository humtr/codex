+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread")]
+async fn active_chat_provider_steer_uses_native_input_without_synchronization() {
+    for (with_image, replaced_turn) in [(false, false), (true, false), (true, true)] {
+        let root = tempfile::tempdir().unwrap();
+        let (mut chat, mut events, mut operations) = make_chatwidget_manual(None).await;
+        chat.config.model_provider_id = crate::termux_chat_models::PROVIDER.into();
+        chat.thread_id = Some(ThreadId::new());
+        handle_turn_started(&mut chat, "live-turn");
+        if with_image {
+            chat.snapshot_local_images = true;
+            let image = root.path().join("image.png");
+            image::RgbImage::new(2, 2).save(&image).unwrap();
+            chat.handle_paste(image.display().to_string());
+        }
+        chat.handle_paste("steer instruction".into());
+        let original = chat.bottom_pane.composer_draft_snapshot();
+        chat.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        if with_image {
+            assert!(chat.pending_input_submission.is_some());
+            tokio::time::timeout(Duration::from_secs(5), async {
+                loop {
+                    if let AppEvent::InputPrepared(id) = events.recv().await.unwrap() {
+                        if replaced_turn {
+                            // The original steer must not become input for a later turn.
+                            chat.turn_lifecycle.last_turn_id = Some("replacement-turn".into());
+                        }
+                        chat.on_input_prepared(id);
+                        break;
+                    }
+                }
+            })
+            .await
+            .expect("image preparation completes without a Provider barrier");
+        } else {
+            assert!(
+                chat.pending_input_submission.is_none(),
+                "active text Steer must submit directly to Native"
+            );
+        }
+        if replaced_turn {
+            assert_no_submit_op(&mut operations);
+            let restored = chat.bottom_pane.composer_draft_snapshot();
+            assert_eq!(restored.text, original.text);
+            assert_eq!(restored.text_elements, original.text_elements);
+            assert_eq!(restored.local_images, original.local_images);
+        } else {
+            let expected_text = if with_image {
+                "[Image #1] steer instruction"
+            } else {
+                "steer instruction"
+            };
+            assert_matches!(next_submit_op(&mut operations), Op::UserTurn { items, .. }
+                if items.iter().any(|item| matches!(item, UserInput::Text { text, .. }
+                    if text == expected_text))
+                && items.iter().any(|item| matches!(item, UserInput::Image { .. })) == with_image);
+        }
+    }
