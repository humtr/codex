+            let request_id = self.next_request_id();
+            let page: codex_app_server_protocol::ThreadTurnsListResponse = self
+                .request_handle
+                .request_typed(ClientRequest::ThreadTurnsList {
+                    request_id,
+                    params: codex_app_server_protocol::ThreadTurnsListParams {
+                        thread_id: thread_id.to_string(),
+                        cursor,
+                        limit: Some(history::HISTORY_ITEM_PAGE_LIMIT),
+                        sort_direction: Some(codex_app_server_protocol::SortDirection::Asc),
+                        items_view: Some(codex_app_server_protocol::TurnItemsView::Full),
+                    },
+                })
