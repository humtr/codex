+#[tokio::test]
+async fn replayed_rate_limit_error_preserves_current_account_and_initial_prompt() {
+    for error in [
+        CodexErrorInfo::UsageLimitExceeded,
+        CodexErrorInfo::ResponseTooManyFailedAttempts {
+            http_status_code: Some(429),
+        },
+    ] {
+        for recovery_pending in [false, true] {
+            let (mut chat, mut events, mut ops) =
+                make_chatwidget_manual(Some("test-model-a")).await;
+            set_chatgpt_auth(&mut chat);
+            chat.thread_id = Some(ThreadId::new());
+            chat.input_queue.rate_limit_recovery_pending = recovery_pending;
+            chat.initial_user_message = Some("saved continuation checkpoint".into());
+            chat.set_initial_user_message_submit_suppressed(true);
+
+            chat.replay_thread_turns(
+                vec![app_server_turn(
+                    "previous-account-turn",
+                    AppServerTurnStatus::Failed,
+                    None,
+                    Some(AppServerTurnError {
+                        misalignment: None,
+                        message: "Previous account reached its usage limit".into(),
+                        codex_error_info: Some(error.clone()),
+                        additional_details: None,
+                    }),
+                )],
+                ReplayKind::ResumeInitialMessages,
+            );
+
+            assert_eq!(
+                chat.input_queue.rate_limit_recovery_pending, recovery_pending,
+                "historical error must neither create nor release current recovery"
+            );
+            assert!(chat.initial_user_message.is_some());
+            let replay_events = std::iter::from_fn(|| events.try_recv().ok()).collect::<Vec<_>>();
+            assert!(!replay_events.iter().any(|event| matches!(
+                event,
+                AppEvent::RefreshRateLimits {
+                    origin: crate::app_event::RateLimitRefreshOrigin::Recovery
+                }
+            )));
+            let history = replay_events
+                .iter()
+                .filter_map(|event| match event {
+                    AppEvent::InsertHistoryCell(cell) => Some(cell.display_lines(80)),
+                    _ => None,
+                })
+                .flatten()
+                .map(|line| line.to_string())
+                .collect::<Vec<_>>()
+                .join("\n");
+            assert!(history.contains("Previous account reached its usage limit"));
+            assert_no_submit_op(&mut ops);
+
+            chat.set_initial_user_message_submit_suppressed(false);
+            chat.submit_initial_user_message_if_pending();
+            if recovery_pending {
+                assert_no_submit_op(&mut ops);
+                assert!(chat.initial_user_message.is_some());
+                chat.finish_rate_limit_recovery();
+            }
+            let Op::UserTurn { model, items, .. } = next_submit_op(&mut ops) else {
+                panic!("expected the existing checkpoint on the retained model");
+            };
+            assert_eq!(model, "test-model-a");
+            assert!(matches!(items.as_slice(), [UserInput::Text { text, .. }]
+                if text == "saved continuation checkpoint"));
+            chat.submit_initial_user_message_if_pending();
+            assert_no_submit_op(&mut ops);
+        }
+    }
