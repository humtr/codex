+if [ "$1" = host ]; then cat "$4/live-models.json"; exit; fi
+: > "$6/observed"
+if [ -f "$6/failure" ]; then printf '{{"error":"bound_chat_native_route_changed"}}'; exit 2; fi
+if [ -f "$6/ready" ]; then
+  printf '{{"thread_id":"%s","status":"ready","inference_submitted":false}}' "$4"
+else
+  printf '{{"thread_id":"%s","status":"waiting","reason":"bound_chat_turn_active","retry_after_seconds":1,"inference_submitted":false}}' "$4"
+fi
+"##, shell.display())).unwrap();
