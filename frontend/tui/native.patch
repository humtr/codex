+#[tokio::test]
+async fn termux_backend_catalog_explicit_resume_selection_uses_native_settings_admission()
+-> Result<()> {
+    use codex_app_server_protocol::{
+        ClientRequest, ThreadResumeParams, ThreadResumeResponse, ThreadSettingsUpdateParams,
+    };
+    use codex_protocol::openai_models::ReasoningEffort;
+    let home = tempfile::tempdir()?;
+    let config = build_config(&home).await;
+    let thread = create_fake_rollout(
+        home.path(),
+        "2025-01-05T12-00-00",
+        "2025-01-05T12:00:00Z",
+        "Original Native history",
+        Some(config.model_provider_id.as_str()),
+        None,
+    )
+    .expect("create original Native history");
+    let mut server = crate::start_embedded_app_server_for_picker(&config).await?;
+    let request_id = server.next_request_id();
+    let _: ThreadResumeResponse = server
+        .request_handle
+        .request_typed(ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert!(
+        server
+            .thread_settings_update(ThreadSettingsUpdateParams {
+                thread_id: thread.clone(),
+                effort: Some(ReasoningEffort::Low),
+                approval_policy: Some(codex_app_server_protocol::AskForApproval::Never),
+                approvals_reviewer: Some(codex_app_server_protocol::ApprovalsReviewer::AutoReview),
+                ..Default::default()
+            })
+            .await?
+    );
+    let request_id = server.next_request_id();
+    let original: ThreadResumeResponse = server
+        .request_handle
+        .request_typed(ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let history = serde_json::to_value(&original.thread.turns)?;
+    let model = original.model.clone();
+    let mut requested = ThreadResumeParams {
+        thread_id: thread.clone(),
+        model: Some(model.clone()),
+        model_provider: Some(original.model_provider.clone()),
+        config: Some(std::collections::HashMap::from([(
+            "model_reasoning_effort".into(),
+            serde_json::json!("high"),
+        )])),
+        ..Default::default()
+    };
+    let admitted = server
+        .admit_resume_model_selection(&requested, original)
+        .await?;
+    assert_eq!(admitted.reasoning_effort, Some(ReasoningEffort::High));
+    assert_eq!(admitted.model, model);
+    assert_eq!(admitted.thread.id, thread);
+    assert_eq!(serde_json::to_value(&admitted.thread.turns)?, history);
+    assert_eq!(
+        admitted.approval_policy,
+        codex_app_server_protocol::AskForApproval::Never
+    );
+    assert_eq!(
+        admitted.approvals_reviewer,
+        codex_app_server_protocol::ApprovalsReviewer::AutoReview
+    );
+    server.thread_settings_update_supported = false;
+    requested
+        .config
+        .as_mut()
+        .unwrap()
+        .insert("model_reasoning_effort".into(), serde_json::json!("low"));
+    assert!(
+        server
+            .admit_resume_model_selection(&requested, admitted)
+            .await
+            .is_err()
+    );
+    let request_id = server.next_request_id();
+    let retained: ThreadResumeResponse = server
+        .request_handle
+        .request_typed(ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread,
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(retained.reasoning_effort, Some(ReasoningEffort::High));
+    assert_eq!(
+        retained.approval_policy,
+        codex_app_server_protocol::AskForApproval::Never
+    );
+    server.shutdown().await?;
+    Ok(())
+}
