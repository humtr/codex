+#[tokio::test]
+async fn enqueue_primary_thread_session_submits_checkpoint_after_replayed_quota_error() -> Result<()>
+{
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let thread = ThreadId::new();
+    let checkpoint = "Continue the saved conversation without repeating completed tools.";
+    set_test_initial_prompt(&mut app, checkpoint.into());
+    app.chat_widget.update_account_state(None, None, true, true);
+    while events.try_recv().is_ok() {}
+    let session = test_thread_session(thread, test_path_buf("/tmp/project"));
+    let expected_model = session.model.clone();
+    let mut previous = test_turn(
+        "previous-account-turn",
+        TurnStatus::Failed,
+        vec![ThreadItemPayload::UserMessage {
+            id: "previous-input".into(),
+            client_id: None,
+            content: vec![AppServerUserInput::Text {
+                text: "the original request".into(),
+                text_elements: Vec::new(),
+            }],
+        }],
+    );
+    previous.error = Some(serde_json::from_value(serde_json::json!({
+        "message": "Previous account reached its usage limit.",
+        "codexErrorInfo": "usageLimitExceeded",
+        "additionalDetails": null
+    }))?);
+    app.enqueue_primary_thread_session(session, vec![previous])
+        .await?;
+    app.chat_widget.submit_initial_user_message_if_pending();
+    let mut submissions = Vec::new();
+    let mut history = String::new();
+    while let Ok(event) = events.try_recv() {
+        match event {
+            AppEvent::SubmitThreadOp {
+                thread_id,
+                op: Op::UserTurn { items, .. },
+            } => {
+                assert_eq!(thread_id, thread);
+                submissions.push(items);
+            }
+            AppEvent::CodexOp(Op::UserTurn { items, .. }) => submissions.push(items),
+            AppEvent::RefreshRateLimits {
+                origin: RateLimitRefreshOrigin::Recovery,
+            } => {
+                panic!("historical account quota must not gate the resumed checkpoint");
+            }
+            AppEvent::InsertHistoryCell(cell) => {
+                history.push_str(&lines_to_single_string(&cell.transcript_lines(100)));
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(
+        submissions,
+        vec![vec![UserInput::Text {
+            text: checkpoint.into(),
+            text_elements: Vec::new(),
+        }]]
+    );
+    assert!(history.contains("the original request"));
+    assert!(history.contains("Previous account reached its usage limit."));
+    assert_eq!(app.chat_widget.thread_id(), Some(thread));
+    assert_eq!(app.chat_widget.current_model(), expected_model);
+    Ok(())
+}
