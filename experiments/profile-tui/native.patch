diff --git a/codex-rs/tui/src/termux_permissions.rs b/codex-rs/tui/src/termux_permissions.rs
new file mode 100644
index 0000000..bfec411
--- /dev/null
+++ b/codex-rs/tui/src/termux_permissions.rs
@@ -0,0 +1,57 @@
+//! Permission presentation for the explicit Termux frontend experiment.
+use codex_protocol::models::ActivePermissionProfile;
+use codex_protocol::models::BUILT_IN_PERMISSION_PROFILE_DANGER_FULL_ACCESS;
+use codex_protocol::models::BUILT_IN_PERMISSION_PROFILE_WORKSPACE;
+use codex_protocol::models::PermissionProfile;
+use codex_utils_approval_presets::ApprovalPreset;
+use std::ffi::OsStr;
+use std::path::Path;
+
+fn has_bridge(core: Option<&OsStr>) -> bool {
+    core.is_some_and(|core| Path::new(core).is_absolute())
+}
+
+pub(crate) fn enabled() -> bool {
+    has_bridge(std::env::var_os("CODEX_PROFILE_CORE").as_deref())
+}
+
+pub(crate) fn auto_profile_id(termux: bool) -> &'static str {
+    if termux {
+        BUILT_IN_PERMISSION_PROFILE_DANGER_FULL_ACCESS
+    } else {
+        BUILT_IN_PERMISSION_PROFILE_WORKSPACE
+    }
+}
+
+pub(crate) fn review_description(termux: bool) -> &'static str {
+    if termux {
+        "Auto-review approval requests without a sandbox."
+    } else {
+        "Only ask for actions detected as potentially unsafe"
+    }
+}
+
+fn adapt(mut presets: Vec<ApprovalPreset>, termux: bool) -> Vec<ApprovalPreset> {
+    if termux {
+        for preset in &mut presets {
+            if preset.id == "auto" {
+                preset.active_permission_profile =
+                    ActivePermissionProfile::new(auto_profile_id(true));
+                preset.permission_profile = PermissionProfile::Disabled;
+                preset.description = "Run without a sandbox; the selected reviewer handles approval requests required by command rules and policy.";
+            }
+        }
+    }
+    presets
+}
+
+pub(crate) fn builtin_approval_presets() -> Vec<ApprovalPreset> {
+    adapt(
+        codex_utils_approval_presets::builtin_approval_presets(),
+        enabled(),
+    )
+}
+
+#[cfg(test)]
+#[path = "termux_permissions_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/termux_permissions_tests.rs b/codex-rs/tui/src/termux_permissions_tests.rs
new file mode 100644
index 0000000..f08b463
--- /dev/null
+++ b/codex-rs/tui/src/termux_permissions_tests.rs
@@ -0,0 +1,68 @@
+use super::*;
+
+#[test]
+fn termux_permissions_require_an_explicit_absolute_bridge() {
+    assert!(!has_bridge(None));
+    assert!(!has_bridge(Some(OsStr::new(""))));
+    assert!(!has_bridge(Some(OsStr::new("relative"))));
+    assert!(has_bridge(Some(OsStr::new("/owned/core"))));
+}
+
+#[test]
+fn termux_permissions_auto_preserves_reviewer_policy_and_disables_sandbox() {
+    let presets = adapt(
+        codex_utils_approval_presets::builtin_approval_presets(),
+        true,
+    );
+    let auto = presets.iter().find(|preset| preset.id == "auto").unwrap();
+    assert_eq!(auto.active_permission_profile.id, auto_profile_id(true));
+    assert_eq!(auto.permission_profile, PermissionProfile::Disabled);
+    assert_eq!(
+        auto.approval,
+        codex_protocol::protocol::AskForApproval::OnRequest
+    );
+    assert!(auto.description.contains("without a sandbox"));
+    let full = presets
+        .iter()
+        .find(|preset| preset.id == "full-access")
+        .unwrap();
+    assert_eq!(full.permission_profile, PermissionProfile::Disabled);
+    assert_eq!(
+        full.approval,
+        codex_protocol::protocol::AskForApproval::Never
+    );
+    assert!(review_description(true).contains("without a sandbox"));
+}
+
+#[test]
+fn termux_permissions_unselected_upstream_and_custom_presets_are_preserved() {
+    let original = codex_utils_approval_presets::builtin_approval_presets();
+    let unchanged = adapt(original.clone(), false);
+    for (before, after) in original.iter().zip(&unchanged) {
+        assert_eq!(before.id, after.id);
+        assert_eq!(
+            before.active_permission_profile,
+            after.active_permission_profile
+        );
+        assert_eq!(before.permission_profile, after.permission_profile);
+        assert_eq!(before.approval, after.approval);
+        assert_eq!(before.description, after.description);
+    }
+    assert_eq!(
+        auto_profile_id(false),
+        BUILT_IN_PERMISSION_PROFILE_WORKSPACE
+    );
+    assert_eq!(
+        review_description(false),
+        "Only ask for actions detected as potentially unsafe"
+    );
+    let mut custom = original[1].clone();
+    custom.id = "custom";
+    let adapted = adapt(vec![custom.clone()], true);
+    assert_eq!(adapted[0].permission_profile, custom.permission_profile);
+    assert_eq!(
+        adapted[0].active_permission_profile,
+        custom.active_permission_profile
+    );
+    assert_eq!(adapted[0].description, custom.description);
+}
