#!/bin/sh
set -eu
LC_ALL=C
export LC_ALL

usage() {
  printf '%s\n' "usage: codex-account ACCOUNT [CODEX_ARG ...]" >&2
  exit 2
}

fail() {
  printf '%s\n' "codex-account: $*" >&2
  exit 1
}

validate_abs_path() {
  p=$1
  label=$2
  case "$p" in
    /*) ;;
    *) fail "$label must be an absolute path" ;;
  esac
  nl=$(printf '\n_')
  nl=${nl%_}
  case "$p" in
    *"$nl"*) fail "$label contains an invalid newline" ;;
    */.|*/..|*/./*|*/../*) fail "$label must not contain dot segments" ;;
  esac
}

strip_trailing_slashes() {
  p=$1
  while [ "$p" != "/" ]; do
    case "$p" in
      */) p=${p%/} ;;
      *) break ;;
    esac
  done
  printf '%s' "$p"
}

check_real_dir_chain() {
  target=$1
  set -f
  old_ifs=${IFS-}
  IFS=/
  cur=""
  for part in ${target#/}; do
    [ -n "$part" ] || continue
    cur="$cur/$part"
    if [ -L "$cur" ] || [ ! -d "$cur" ]; then
      IFS=$old_ifs
      set +f
      fail "unsafe or missing directory component: $cur"
    fi
  done
  IFS=$old_ifs
  set +f
}

check_owned_dir() {
  p=$1
  req_uid=$2
  req_mode=$3
  if [ -L "$p" ] || [ ! -d "$p" ]; then
    fail "expected real directory: $p"
  fi
  meta=$(stat -c '%u:%a' "$p" 2>/dev/null) || fail "cannot stat directory: $p"
  uid_got=${meta%%:*}
  mode_got=${meta#*:}
  [ "$uid_got" = "$req_uid" ] || fail "directory not owned by current user: $p"
  if [ -n "$req_mode" ] && [ "$mode_got" != "$req_mode" ]; then
    fail "directory must have mode 0$req_mode: $p"
  fi
}

check_profile_meta() {
  meta_path=$1
  req_uid=$2
  acct=$3
  if [ -L "$meta_path" ] || [ ! -f "$meta_path" ]; then
    fail "missing or invalid profile metadata: $meta_path"
  fi
  meta=$(stat -c '%u:%a' "$meta_path" 2>/dev/null) || fail "cannot stat profile metadata: $meta_path"
  uid_got=${meta%%:*}
  mode_got=${meta#*:}
  [ "$uid_got" = "$req_uid" ] || fail "profile metadata not owned by current user: $meta_path"
  [ "$mode_got" = "600" ] || fail "profile metadata must have mode 0600: $meta_path"

  if printf 'codex-manager-profile-v1\nid\t%s\n' "$acct" | cmp -s - "$meta_path"; then
    return 0
  fi
  if printf 'codex-manager-profile-v2\n' | cmp -s - "$meta_path"; then
    return 0
  fi
  fail "unrecognized or mismatched profile metadata: $meta_path"
}

validate_account_name() {
  acct=$1
  [ -n "$acct" ] || fail "account name must not be empty"
  [ "${#acct}" -le 64 ] || fail "account name exceeds 64 bytes: $acct"
  case "$acct" in
    [!A-Za-z0-9]* | *[!A-Za-z0-9._-]*)
      fail "invalid account name: $acct"
      ;;
    wrapper | termux)
      fail "reserved account name: $acct"
      ;;
  esac
}

[ "$#" -ge 1 ] || usage
account=$1
shift

home_raw=${HOME-}
[ -n "$home_raw" ] || fail "HOME is unset"
validate_abs_path "$home_raw" "HOME"
home_dir=$(strip_trailing_slashes "$home_raw")

prefix_raw=${PREFIX:-/data/data/com.termux/files/usr}
[ -n "$prefix_raw" ] || fail "PREFIX is empty"
validate_abs_path "$prefix_raw" "PREFIX"
prefix_dir=$(strip_trailing_slashes "$prefix_raw")
codex_bin="$prefix_dir/bin/codex"
if [ -d "$codex_bin" ] || [ ! -f "$codex_bin" ] || [ ! -x "$codex_bin" ]; then
  fail "codex executable not found or not executable: $codex_bin"
fi

my_uid=$(id -u) || fail "cannot determine current user id"
check_real_dir_chain "$home_dir"
check_owned_dir "$home_dir" "$my_uid" ""

case "$account" in
  default | home)
    unset CODEX_HOME CODEX_SHARED_HOME CODEX_SQLITE_HOME
    exec "$codex_bin" "$@"
    ;;
esac

validate_account_name "$account"

codex_local="$home_dir/.local/share/codex"
manager_dir="$codex_local/manager"
profiles_dir="$manager_dir/profiles"
profile_dir="$profiles_dir/$account"
profile_home="$profile_dir/home"
profile_meta="$profile_dir/profile.meta"

check_real_dir_chain "$profile_home"
check_owned_dir "$home_dir/.local" "$my_uid" ""
check_owned_dir "$home_dir/.local/share" "$my_uid" ""
check_owned_dir "$codex_local" "$my_uid" ""
check_owned_dir "$manager_dir" "$my_uid" "700"
check_owned_dir "$profiles_dir" "$my_uid" "700"
check_owned_dir "$profile_dir" "$my_uid" "700"
check_owned_dir "$profile_home" "$my_uid" "700"
check_profile_meta "$profile_meta" "$my_uid" "$account"

shared_home="$home_dir/.codex"
CODEX_HOME=$profile_home
CODEX_SHARED_HOME=$shared_home
CODEX_SQLITE_HOME=$shared_home
export CODEX_HOME CODEX_SHARED_HOME CODEX_SQLITE_HOME

exec "$codex_bin" "$@"
