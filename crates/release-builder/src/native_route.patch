+#[tokio::test]
+async fn model_provider_storage_failure_preserves_the_original_route_without_inference()
+-> Result<()> {
+    let first = responses::start_mock_server().await;
+    let second = responses::start_mock_server().await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&first.uri())
+        .with_provider_config("supports_websockets = false")
+        .with_extra_config(&format!("[model_providers.alternate]\nname = 'Alternate'\nbase_url = '{}/v1'\nwire_api = 'responses'\nrequires_openai_auth = false\nsupports_websockets = false\n", second.uri()))
+        .write(home.path())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = start_thread(&mut client).await?;
+    let thread = started.thread.id;
+    let path = started
+        .thread
+        .path
+        .context("empty thread must expose its planned rollout path")?;
+    assert!(
+        !path.exists(),
+        "the fixture must fault the first materialization"
+    );
+    std::fs::create_dir_all(&path)?;
+    let request = client
+        .send_thread_settings_update_request(ThreadSettingsUpdateParams {
+            thread_id: thread.clone(),
+            model_provider: Some("alternate".into()),
+            ..Default::default()
+        })
+        .await?;
+    let response = timeout(
+        DEFAULT_TIMEOUT,
+        client.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await;
+    // Remove only the owned empty collision before evaluating the result.
+    std::fs::remove_dir(&path)?;
+    let response = response??;
+    assert_eq!(response.error.code, -32603, "{response:?}");
+    let current: ThreadReadResponse = client
+        .request(|request_id| ClientRequest::ThreadRead {
+            request_id,
+            params: ThreadReadParams {
+                thread_id: thread.clone(),
+                include_turns: false,
+            },
+        })
+        .await?;
+    assert_eq!(current.thread.model_provider, "mock_provider");
+    assert!(received_response_bodies(&first).await?.is_empty());
+    assert!(received_response_bodies(&second).await?.is_empty());
+    // Reconcile a settings operation, rather than replaying any user turn.
+    send_thread_settings_update(
+        &mut client,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.clone(),
+            model_provider: Some("alternate".into()),
+            ..Default::default()
+        },
+    )
+    .await?;
+    drop(client);
+    let mut resumed = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let result: ThreadResumeResponse = resumed
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(result.thread.id, thread);
+    assert_eq!(result.model_provider, "alternate");
+    assert!(received_response_bodies(&second).await?.is_empty());
+    Ok(())
+}
