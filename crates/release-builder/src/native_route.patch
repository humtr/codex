+    #[cfg(unix)]
+    struct HookAdmissionProbe {
+        name: ToolName,
+        calls: Arc<std::sync::atomic::AtomicUsize>,
+        reload: Option<Arc<Hooks>>,
+        permission: bool,
+    }
+
+    #[cfg(unix)]
+    impl codex_tools::ToolExecutor<ToolInvocation> for HookAdmissionProbe {
+        fn tool_name(&self) -> ToolName {
+            self.name.clone()
+        }
+        fn spec(&self) -> codex_tools::ToolSpec {
+            codex_tools::ToolSpec::Function(codex_tools::ResponsesApiTool {
+                name: self.name.name.clone(),
+                description: "Hook admission probe".into(),
+                strict: false,
+                defer_loading: None,
+                parameters: Default::default(),
+                output_schema: None,
+            })
+        }
+        fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+        where
+            ToolInvocation: 'a,
+        {
+            Box::pin(async move {
+                self.calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                if self.permission {
+                    let review =
+                        crate::guardian::GuardianReviewContext::from(&invocation.step_context);
+                    crate::hook_runtime::run_permission_request_hooks(
+                        &invocation.session,
+                        &review,
+                        &invocation.call_id,
+                        crate::tools::sandboxing::PermissionRequestPayload {
+                            tool_name: crate::tools::hook_names::HookToolName::bash(),
+                            tool_cwd: None,
+                            tool_input: serde_json::json!({}),
+                        },
+                        "local",
+                    )
+                    .await;
+                }
+                Ok(
+                    Box::new(crate::tools::context::FunctionToolOutput::from_text(
+                        "backend completed".into(),
+                        Some(true),
+                    )) as Box<dyn codex_tools::ToolOutput>,
+                )
+            })
+        }
+    }
+    #[cfg(unix)]
+    impl crate::tools::registry::CoreToolRuntime for HookAdmissionProbe {
+        fn environments_for_input(
+            &self,
+            invocation: &ToolInvocation,
+        ) -> Result<crate::tools::context::ToolEnvironments, FunctionCallError> {
+            // The registry has admitted the call, but has not dispatched its
+            // Pre hook yet. A reload here exercises all three hook consumers.
+            if let Some(reload) = &self.reload {
+                invocation.session.services.hooks.store(Arc::clone(reload));
+            }
+            Ok(crate::tools::context::ToolEnvironments::All)
+        }
+    }
+
+    #[cfg(unix)]
+    fn hook_probe_invocation(
+        session: &Arc<Session>,
+        step: Arc<StepContext>,
+        name: ToolName,
+        id: &str,
+    ) -> ToolInvocation {
+        let completion = Arc::new(crate::native_completion::CallCompletion::default());
+        completion.capture(session, &step, id, &name);
+        ToolInvocation {
+            native_completion: Some(completion),
+            session: Arc::clone(session),
+            turn: Arc::clone(&step.turn),
+            step_context: step,
+            cancellation_token: tokio_util::sync::CancellationToken::new(),
+            tracker: Arc::new(tokio::sync::Mutex::new(
+                crate::turn_diff_tracker::TurnDiffTracker::new(),
+            )),
+            call_id: id.into(),
+            tool_name: name,
+            source: crate::tools::context::ToolCallSource::Direct,
+            native_call: None,
+            environments: Default::default(),
+            payload: codex_tools::ToolPayload::Function {
+                arguments: "{}".into(),
+            },
+        }
+    }
+
+    #[cfg(unix)]
+    fn configured_hooks(
+        session: &Session,
+        root: &Path,
+        label: &str,
+        matcher: &str,
+    ) -> anyhow::Result<Arc<Hooks>> {
+        configured_hook_events(
+            session,
+            root,
+            label,
+            matcher,
+            &["pre", "post", "permission"],
+        )
+    }
+
+    #[cfg(unix)]
+    fn configured_hook_events(
+        session: &Session,
+        root: &Path,
+        label: &str,
+        matcher: &str,
+        events: &[&str],
+    ) -> anyhow::Result<Arc<Hooks>> {
+        configured_hook_events_with_mode(session, root, label, matcher, events, false)
+    }
+
+    #[cfg(unix)]
+    fn configured_hook_events_with_mode(
+        session: &Session,
+        root: &Path,
+        label: &str,
+        matcher: &str,
+        events: &[&str],
+        asynchronous: bool,
+    ) -> anyhow::Result<Arc<Hooks>> {
+        let log = root.join("hook-effects");
+        let log = log.to_str().ok_or_else(|| anyhow::anyhow!("test path"))?;
+        anyhow::ensure!(!log.contains('\''), "owned test path is not shell-safe");
+        let group = |event: &str| codex_config::MatcherGroup {
+            matcher: Some(matcher.to_owned()),
+            hooks: vec![codex_config::HookHandlerConfig::Command {
+                command: format!("printf '%s\\n' '{label}-{event}' >> '{log}'"),
+                command_windows: None,
+                timeout_sec: Some(5),
+                r#async: asynchronous,
+                status_message: None,
+                additional_context_limit: None,
+            }],
+        };
+        let plugin_root = codex_config::AbsolutePathBuf::try_from(root.to_path_buf())?;
+        let hooks = session.hooks().reconfigured(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            bypass_hook_trust: true,
+            shell_program: Some(
+                session
+                    .user_shell()
+                    .shell_path
+                    .to_string_lossy()
+                    .into_owned(),
+            ),
+            shell_args: vec!["-c".into()],
+            plugin_hook_sources: vec![codex_plugin::PluginHookSource {
+                plugin_id: codex_plugin::PluginId::parse("native-hook-proof@test")?,
+                plugin_root: plugin_root.clone(),
+                plugin_data_root: plugin_root.clone(),
+                source_path: plugin_root.join("hooks.json"),
+                source_relative_path: "hooks.json".into(),
+                hooks: codex_config::HookEventsToml {
+                    pre_tool_use: events
+                        .contains(&"pre")
+                        .then(|| vec![group("pre")])
+                        .unwrap_or_default(),
+                    post_tool_use: events
+                        .contains(&"post")
+                        .then(|| vec![group("post")])
+                        .unwrap_or_default(),
+                    permission_request: events
+                        .contains(&"permission")
+                        .then(|| vec![group("permission")])
+                        .unwrap_or_default(),
+                    ..Default::default()
+                },
+            }],
+            ..Default::default()
+        });
+        Ok(Arc::new(hooks))
+    }
