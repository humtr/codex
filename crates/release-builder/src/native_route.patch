+    #[tokio::test]
+    async fn native_completion_hook_reload_before_admission_refuses_all_qualified_calls()
+    -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let step = StepContext::for_test(Arc::new(turn));
+        step.native_hooks.capture(session.hooks());
+        let owned = tempfile::tempdir()?;
+        session
+            .services
+            .hooks
+            .store(configured_hooks(&session, owned.path(), "new", ".*")?);
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        for (index, name) in [
+            "exec_command",
+            "write_stdin",
+            "apply_patch",
+            "view_image",
+            "mcp__clock__curr_time",
+            "mcp__clock__sleep",
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let name = ToolName::plain(name);
+            let registry =
+                crate::tools::registry::ToolRegistry::from_tools([Arc::new(HookAdmissionProbe {
+                    name: name.clone(),
+                    calls: Arc::clone(&calls),
+                    reload: None,
+                    permission: true,
+                })
+                    as Arc<dyn crate::tools::registry::CoreToolRuntime>]);
+            let id = format!("stale-{index}");
+            let invocation = hook_probe_invocation(&session, Arc::clone(&step), name.clone(), &id);
+            let completion = invocation
+                .native_completion
+                .clone()
+                .ok_or_else(|| anyhow::anyhow!("completion"))?;
+            let result = registry.dispatch_any_with_state(invocation, None).await;
+            completion.finish(&session);
+            let error = crate::native_completion::decorate(result, &completion)
+                .err()
+                .ok_or_else(|| anyhow::anyhow!("stale invocation must be refused"))?
+                .to_string();
+            assert!(error.contains("no hook or backend was executed"));
+            if matches!(name.name.as_str(), "exec_command" | "write_stdin") {
+                let line = error
+                    .lines()
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("proof header"))?;
+                let value: Value = serde_json::from_str(
+                    line.strip_prefix("Native completion: ")
+                        .ok_or_else(|| anyhow::anyhow!("typed refusal"))?,
+                )?;
+                assert_eq!(value["call_id"], id);
+                assert_eq!(value["outcome"], "pre_backend_rejected");
+                assert!(value["session_id"].is_null());
+                assert!(value["exit_code"].is_null());
+            }
+        }
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 0);
+        assert!(!owned.path().join("hook-effects").exists());
+        Ok(())
+    }
