--- /dev/null
+++ b/codex-rs/core/src/native_execution.rs
@@ -0,0 +1,1501 @@
+//! Private execution facts for the local ChatGPT Provider's resource admission.
+//! Native remains the only executor. No tool arguments or environment values
+//! are rewritten, and no compiler or shell is run to obtain these facts.
+use crate::exec_env::create_env;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::tools::context::ToolInvocation;
+use codex_hooks::Hooks;
+use codex_tools::FunctionCallError;
+use codex_tools::ToolName;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::OnceLock;
+
+pub(crate) const METADATA_KEY: &str = "termux_native_execution";
+
+/// The request advertises one immutable Hook engine. Each tool compares it with
+/// the current engine at admission, then uses that same Arc for every actual
+/// PreToolUse, PostToolUse and PermissionRequest dispatch. A reload before
+/// admission refuses the call; a reload after it affects only later calls.
+#[derive(Clone, Default)]
+pub(crate) struct HookSnapshot {
+    advertised: Arc<OnceLock<AdvertisedHooks>>,
+    admitted: Option<Arc<Hooks>>,
+}
+
+struct AdvertisedHooks {
+    hooks: Arc<Hooks>,
+    hook_free_tools: Vec<&'static str>,
+}
+
+const HOOK_INPUTS: &[(&str, &[&str], &[&str])] = &[
+    (
+        "exec_command",
+        &["Bash", "exec_command", "functions.exec_command"],
+        &["Bash"],
+    ),
+    (
+        "write_stdin",
+        &["Bash", "write_stdin", "functions.write_stdin"],
+        &["write_stdin"],
+    ),
+    (
+        "apply_patch",
+        &["apply_patch", "functions.apply_patch", "Write", "Edit"],
+        &["apply_patch", "Write", "Edit"],
+    ),
+    // view_image reads through the selected filesystem and has no permission
+    // request handler. Keep a canonical conservative matcher rather than the
+    // empty list, which the shared proof helper correctly treats as unknown.
+    (
+        "view_image",
+        &["view_image", "functions.view_image"],
+        &["view_image"],
+    ),
+    (
+        "clock.curr_time",
+        &["clock.curr_time", "mcp__clock__curr_time"],
+        &["mcp__clock__curr_time"],
+    ),
+    (
+        "clock.sleep",
+        &["clock.sleep", "mcp__clock__sleep"],
+        &["mcp__clock__sleep"],
+    ),
+];
+
+fn qualified_hook_tool(tool: &ToolName) -> Option<&'static str> {
+    if tool.is_default_namespace() {
+        match tool.name.as_str() {
+            "exec_command" => return Some("exec_command"),
+            "write_stdin" => return Some("write_stdin"),
+            "apply_patch" => return Some("apply_patch"),
+            "view_image" => return Some("view_image"),
+            "mcp__clock__curr_time" | "clock.curr_time" => return Some("clock.curr_time"),
+            "mcp__clock__sleep" | "clock.sleep" => return Some("clock.sleep"),
+            _ => {}
+        }
+    }
+    // MCP preserves its server namespace separately from the raw tool name.
+    // Display formatting is not a callable identity or backend trust proof.
+    match (tool.namespace.as_deref(), tool.name.as_str()) {
+        (Some("clock" | "mcp__clock"), "curr_time") => Some("clock.curr_time"),
+        (Some("clock" | "mcp__clock"), "sleep") => Some("clock.sleep"),
+        _ => None,
+    }
+}
+
+/// Canonical per-tool facts shared by advertisement, actual admission and
+/// completion. Bounded file/process scope is a separate Provider decision.
+pub(crate) fn tool_has_no_hook_effects(hooks: &Hooks, tool: &str) -> bool {
+    HOOK_INPUTS.iter().any(|(name, names, permissions)| {
+        *name == tool && hooks.tool_has_no_hook_effects(names, permissions)
+    })
+}
+
+impl HookSnapshot {
+    fn capture(&self, hooks: Arc<Hooks>) -> &AdvertisedHooks {
+        self.advertised.get_or_init(|| AdvertisedHooks {
+            hook_free_tools: HOOK_INPUTS
+                .iter()
+                .filter(|(_, names, permissions)| {
+                    hooks.tool_has_no_hook_effects(names, permissions)
+                })
+                .map(|(tool, _, _)| *tool)
+                .collect(),
+            hooks,
+        })
+    }
+
+    pub(crate) fn advertised_hooks(&self) -> Option<&Arc<Hooks>> {
+        self.advertised.get().map(|value| &value.hooks)
+    }
+
+    pub(crate) fn admitted(&self) -> Option<&Arc<Hooks>> {
+        self.admitted.as_ref()
+    }
+
+    fn admit(&self, current: &Arc<Hooks>, tool: &ToolName) -> Result<Self, &'static str> {
+        let Some(advertised) = self.advertised.get() else {
+            return Ok(self.clone());
+        };
+        if !Arc::ptr_eq(&advertised.hooks, current) {
+            return Err("hook configuration changed before tool admission");
+        }
+        // Async hook state is shared across reconfigurations and is not an
+        // immutable config field. Recheck a previously bounded claim before
+        // effects, using the same engine that will actually dispatch its hooks.
+        let hook_free = match qualified_hook_tool(tool) {
+            Some(tool) => {
+                advertised.hook_free_tools.contains(&tool)
+                    && tool_has_no_hook_effects(current, tool)
+            }
+            // Do not invent matcher aliases for other tools or remove them from
+            // the product. With no admitted hook handlers, their normal result
+            // still settles only their own invocation. A matching synchronous
+            // hook is insufficient: it can leave a detached child alive.
+            None => current.has_no_configured_hook_effects(),
+        };
+        if !hook_free {
+            return Err("applicable hooks cannot provide confirmed completion for this dispatch");
+        }
+        Ok(Self {
+            advertised: Arc::clone(&self.advertised),
+            admitted: Some(Arc::clone(&advertised.hooks)),
+        })
+    }
+}
+
+/// This is called by the existing registry before the environment resolver or
+/// any tool/permission hook. The Arc load is the linearization point: all later
+/// hook consumers use the returned engine, never another session.hooks() load.
+pub(crate) fn admit_hook_dispatch(
+    invocation: &mut ToolInvocation,
+    code_mode_cell_tool: bool,
+) -> Result<(), FunctionCallError> {
+    if invocation
+        .step_context
+        .native_hooks
+        .advertised_hooks()
+        .is_none()
+    {
+        return Ok(());
+    }
+    // The router's dedicated discovery payload never runs Pre/Post/Permission
+    // hooks. A function call merely named tool_search is not this exception.
+    if invocation.tool_name.is_default_namespace()
+        && invocation.tool_name.name == "tool_search"
+        && matches!(
+            &invocation.payload,
+            codex_tools::ToolPayload::ToolSearch { .. }
+        )
+    {
+        return Ok(());
+    }
+    // A yielded cell can outlive its original tool response and its turn.
+    // This adapter has no cell-lifecycle receipt, so never treat that response
+    // as completion of all nested effects. The registry has already verified
+    // this exact built-in runtime and payload kind; ordinary tools with the
+    // same spelling must retain their normal dispatch path.
+    if code_mode_cell_tool
+        && invocation.tool_name.is_default_namespace()
+        && matches!(
+            (invocation.tool_name.name.as_str(), &invocation.payload),
+            (
+                codex_code_mode::PUBLIC_TOOL_NAME,
+                codex_tools::ToolPayload::Custom { .. }
+            ) | (
+                codex_code_mode::WAIT_TOOL_NAME,
+                codex_tools::ToolPayload::Function { .. }
+            )
+        )
+    {
+        if let Some(completion) = &invocation.native_completion {
+            completion.refuse_before_hooks(&invocation.call_id);
+        }
+        return Err(FunctionCallError::RespondToModel(
+            "Native CodeMode cell lifecycle is unsupported by this adapter; no hook or cell backend was executed.".into(),
+        ));
+    }
+    let admitted = invocation
+        .step_context
+        .native_hooks
+        .admit(&invocation.session.hooks(), &invocation.tool_name);
+    let admitted = match admitted {
+        Ok(admitted) => admitted,
+        Err(reason) => {
+            if let Some(completion) = &invocation.native_completion {
+                completion.refuse_before_hooks(&invocation.call_id);
+            }
+            return Err(FunctionCallError::RespondToModel(format!(
+                "Native {reason}; no hook or backend was executed."
+            )));
+        }
+    };
+    if invocation.tool_name.is_default_namespace()
+        && matches!(
+            invocation.tool_name.name.as_str(),
+            "exec_command" | "write_stdin"
+        )
+        && invocation
+            .native_completion
+            .as_ref()
+            .is_none_or(|state| !state.is_admitted())
+    {
+        if let Some(completion) = &invocation.native_completion {
+            completion.refuse_before_hooks(&invocation.call_id);
+        }
+        return Err(FunctionCallError::RespondToModel(
+            "Native process completion is unavailable in this execution context; no hook or backend was executed.".into(),
+        ));
+    }
+    if let Some(hooks) = admitted.admitted()
+        && let Some(completion) = &invocation.native_completion
+    {
+        completion.bind_dispatch_hooks(Arc::clone(hooks));
+    }
+    Arc::make_mut(&mut invocation.step_context).native_hooks = admitted;
+    Ok(())
+}
+
+fn project(
+    env: &HashMap<String, String>,
+    cwd: &Path,
+    shell: &Path,
+    thread: &str,
+    turn: &str,
+    hook_free_tools: &[&str],
+) -> Option<Value> {
+    let pid = std::process::id();
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    let start = stat.rsplit_once(')')?.1.split_whitespace().nth(19)?;
+    let prefix = env.get("PREFIX")?;
+    let home = env.get("HOME")?;
+    let path = env.get("PATH")?;
+    if !cwd.is_absolute()
+        || !shell.is_absolute()
+        || !Path::new(prefix).is_absolute()
+        || !Path::new(home).is_absolute()
+        || path.len() > 16 * 1024
+        || env.len() > 512
+    {
+        return None;
+    }
+    let mut variables = env.keys().collect::<Vec<_>>();
+    variables.sort();
+    Some(
+        json!({"schema":4,"hook_free_tools":hook_free_tools,"pid":pid,"start":start,"thread":thread,"turn":turn,
+        "cwd":cwd,"shell":shell,"prefix":prefix,"home":home,"path":path,
+        "variables":variables,"no_default_config":env.get("CLANG_NO_DEFAULT_CONFIG").is_some_and(|s|!s.is_empty())}),
+    )
+}
+
+pub(crate) fn capture(session: &Session, step: &StepContext) -> Option<Value> {
+    // This is private, model-invisible metadata for the qualified local route.
+    // The same registry and aliases used by dispatch prove each bounded tool.
+    // A patch hook must not invalidate an unrelated exec, nor may an image or
+    // clock tool bypass a matching hook merely because its main action reads.
+    if step.turn.config.model_provider_id != "chatgpt_desktop"
+        || step.environments.turn_environments().count() != 1
+        || !step.executor_hook_sources.is_empty()
+    {
+        return None;
+    }
+    let advertised = step.native_hooks.capture(session.hooks());
+    let environment = step.environments.primary()?;
+    if environment.environment.is_remote()
+        || !environment.config().environment_hooks.is_empty()
+        || step
+            .turn
+            .config
+            .permissions
+            .network
+            .as_ref()
+            .is_some_and(|network| network.enabled() && network.credential_broker_enabled())
+    {
+        return None;
+    }
+    let cwd = environment.cwd().to_abs_path().ok()?;
+    let session_shell = session.user_shell();
+    let shell = environment.shell.as_ref().unwrap_or(session_shell.as_ref());
+    // Reuse UnifiedExec's selected policy and package PATH projection. Its
+    // remaining overlays add runtime IDs, permission labels and terminal
+    // defaults. This qualification is for login:false only, so shell snapshots
+    // are not applied; credential-broker snapshots and remote executors are
+    // excluded above.
+    let mut env = create_env(environment.shell_environment_policy(), None);
+    #[cfg(unix)]
+    crate::tools::runtimes::apply_package_path_prepend(
+        &mut env,
+        &mut crate::tools::runtimes::RuntimePathPrepends::default(),
+    );
+    project(
+        &env,
+        cwd.as_path(),
+        &shell.shell_path,
+        &session.thread_id.to_string(),
+        &step.turn.sub_id,
+        &advertised.hook_free_tools,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn projection_uses_selected_policy_and_never_transports_secret_values() {
+        let env = HashMap::from([
+            ("PREFIX".into(), "/selected/prefix".into()),
+            ("HOME".into(), "/selected/home".into()),
