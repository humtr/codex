+/// Cloneable observation and Stop control for one local supervised execution.
+/// A root exit, control EOF, or successful Stop request alone is not tree proof.
+#[derive(Clone)]
+pub(crate) struct ProcessTreeGuard {
+    control: std::sync::Arc<TreeControl>,
+    observation: tokio::sync::watch::Receiver<TreeObservation>,
+}
+
+impl ProcessTreeGuard {
+    #[cfg(test)]
+    pub(crate) fn target_pid(&self) -> u32 {
+        self.control.target_pid
+    }
+
+    pub(crate) fn request_stop(&self) -> io::Result<()> {
+        use std::io::Write;
+
+        self.control
+            .writer
+            .lock()
+            .map_err(|_| io::Error::other("process supervision control is poisoned"))?
+            .write_all(&[TREE_STOP])
+    }
+
+    pub(crate) fn request_interrupt(&self) -> io::Result<()> {
+        use std::io::Write;
+
+        if let Some(master) = &self.control.pty_master {
+            // TIOCSIG takes a kernel reference to this dedicated PTY's actual
+            // foreground group. It does not perform a numeric PID lookup.
+            if unsafe { libc::ioctl(master.as_raw_fd(), TREE_TIOCSIG as _, libc::SIGINT) } == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            return Ok(());
+        }
+        self.control
+            .writer
+            .lock()
+            .map_err(|_| io::Error::other("process supervision control is poisoned"))?
+            .write_all(&[TREE_INTERRUPT])
+    }
+
+    /// Called only by the existing owner of the actual supervisor Child.wait().
+    /// A signal, wait failure, or nonzero helper exit invalidates tree proof.
+    pub(crate) fn observe_helper_wait(&self, result: io::Result<std::process::ExitStatus>) {
+        let succeeded = result.is_ok_and(|status| status.success());
+        self.control.observation.send_modify(|observation| {
+            if observation.helper_waited.is_some() {
+                observation.failed = true;
+            }
+            observation.helper_waited = Some(succeeded);
+            if !succeeded {
+                observation.failed = true;
+            }
+        });
+    }
+
+    pub(crate) fn confirmed_tree_status(&self) -> Option<std::process::ExitStatus> {
+        self.observation.borrow().completed_status()
+    }
+
+    pub(crate) async fn wait_root(&self) -> io::Result<std::process::ExitStatus> {
+        use std::os::unix::process::ExitStatusExt;
+
+        let mut observation = self.observation.clone();
+        loop {
+            {
+                let state = observation.borrow();
+                if let Some(status) = state.root_status {
+                    return Ok(std::process::ExitStatus::from_raw(status));
+                }
+                if state.failed {
+                    return Err(io::Error::other("original process wait is unavailable"));
+                }
+            }
+            observation
+                .changed()
+                .await
+                .map_err(|_| io::Error::other("process supervision observation ended"))?;
+        }
+    }
+
+    pub(crate) async fn wait_tree(&self) -> io::Result<std::process::ExitStatus> {
+        let mut observation = self.observation.clone();
+        loop {
+            {
+                let state = observation.borrow();
+                if let Some(status) = state.completed_status() {
+                    return Ok(status);
+                }
+                if state.failed {
+                    return Err(io::Error::other("process tree completion is unavailable"));
+                }
+            }
+            observation
+                .changed()
+                .await
+                .map_err(|_| io::Error::other("process supervision observation ended"))?;
+        }
+    }
+}
