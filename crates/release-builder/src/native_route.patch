+    command
+        .arg(TARGET)
+        .arg("foreground")
+        .arg(read.as_raw_fd().to_string())
+        .current_dir("/")
+        .stdin(crate::ChildStdin::File(slave.try_clone()?));
+    command.stdout_file = Some(slave.try_clone()?);
+    command.stderr_file = Some(slave);
+    command.inherit_fds(&[read.as_raw_fd()]);
+    let mut spawned = spawn_guarded(
+        &command,
+        GuardedSetup::Pty {
+            master: master.as_fd(),
+        },
+    )
+    .await?;
+    let ready_master = File::from(master.try_clone()?);
+    let ready = tokio::task::spawn_blocking(move || {
+        let mut line = String::new();
+        io::BufRead::read_line(&mut io::BufReader::new(ready_master), &mut line)?;
+        Ok::<_, io::Error>(line)
+    });
+    let ready = tokio::time::timeout(DEADLINE, ready).await???;
+    assert!(ready.starts_with("foreground "));
+    spawned.guard.request_interrupt()?;
+    assert_eq!(finish(&mut spawned).await?.code(), Some(0));
+    drop(cleanup);
+    Ok(())
+}
