+
+impl TreeSignals {
+    fn new() -> io::Result<Self> {
+        set_signal_disposition(libc::SIGCHLD, libc::SIG_DFL)?;
+        let mut actual: libc::sigaction = unsafe { std::mem::zeroed() };
+        if unsafe { libc::sigaction(libc::SIGCHLD, std::ptr::null(), &mut actual) } == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        if actual.sa_sigaction != libc::SIG_DFL || actual.sa_flags & libc::SA_NOCLDWAIT != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "child wait ownership is unavailable",
+            ));
+        }
+        set_signal_disposition(libc::SIGPIPE, libc::SIG_IGN)?;
+        set_signal_disposition(libc::SIGTTOU, libc::SIG_IGN)?;
+        let mut mask: libc::sigset_t = unsafe { std::mem::zeroed() };
+        let mut original_mask: libc::sigset_t = unsafe { std::mem::zeroed() };
+        if unsafe { libc::sigemptyset(&mut mask) } == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        for signal in [libc::SIGCHLD, libc::SIGTERM, libc::SIGHUP, libc::SIGINT] {
+            if unsafe { libc::sigaddset(&mut mask, signal) } == -1 {
+                return Err(io::Error::last_os_error());
+            }
+        }
+        if unsafe { libc::sigprocmask(libc::SIG_BLOCK, &mask, &mut original_mask) } == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        let fd = unsafe { libc::signalfd(-1, &mask, libc::SFD_CLOEXEC | libc::SFD_NONBLOCK) };
+        if fd == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self {
+            // SAFETY: signalfd returned a fresh owned descriptor.
+            fd: unsafe { std::os::fd::OwnedFd::from_raw_fd(fd) },
+            original_mask,
+        })
+    }
