+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_provider_definition_change_refuses_active_turn_and_rebinds_when_settled()
+-> Result<()> {
+    use core_test_support::streaming_sse::{StreamingSseChunk, start_streaming_sse_server};
+    let (release, gate) = tokio::sync::oneshot::channel();
+    let (first, _) = start_streaming_sse_server(vec![vec![
+        StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![responses::ev_response_created("active")]),
+        },
+        StreamingSseChunk {
+            gate: Some(gate),
+            body: responses::sse(vec![responses::ev_completed("active")]),
+        },
+    ]])
+    .await;
+    let second = responses::start_mock_server().await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), first.uri())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = start_thread(&mut client).await?.thread.id;
+    let input = || {
+        vec![V2UserInput::Text {
+            text: "continue".into(),
+            text_elements: Vec::new(),
+        }]
+    };
+    let request = client
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.clone(),
+            input: input(),
+            ..Default::default()
+        })
+        .await?;
+    let _: TurnStartResponse = client.read_response(request).await?;
+    timeout(DEFAULT_TIMEOUT, first.wait_for_request_count(1)).await?;
+    let config = std::collections::HashMap::from([(
+        "model_providers".into(),
+        json!({"mock_provider": {
+            "name": "Replacement definition", "base_url": format!("{}/v1",second.uri()), "wire_api": "responses", "requires_openai_auth": false, "supports_websockets": false,
+        }}),
+    )]);
+    let select = ThreadSettingsUpdateParams {
+        thread_id: thread.clone(),
+        model_provider: Some("mock_provider".into()),
+        config: Some(config),
+        ..Default::default()
+    };
+    let request = client
+        .send_thread_settings_update_request(select.clone())
+        .await?;
+    let error = timeout(
+        DEFAULT_TIMEOUT,
+        client.read_stream_until_error_message(RequestId::Integer(request)),
+    )
+    .await??;
+    assert!(error.error.message.contains("settled turn"), "{error:?}");
+    assert!(received_response_bodies(&second).await?.is_empty());
+    release.send(()).expect("original response still waiting");
+    timeout(
+        DEFAULT_TIMEOUT,
+        client.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    send_thread_settings_update(&mut client, select).await?;
+    responses::mount_sse_once(
+        &second,
+        create_final_assistant_message_sse_response("replacement route")?,
+    )
+    .await;
+    client
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread,
+            input: input(),
+            ..Default::default()
+        })
+        .await?;
+    assert_eq!(received_response_bodies(&second).await?.len(), 1);
+    Ok(())
+}
