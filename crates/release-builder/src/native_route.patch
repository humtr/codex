+fn set_signal_disposition(signal: i32, disposition: libc::sighandler_t) -> io::Result<()> {
+    // A zeroed sigaction clears SA_NOCLDWAIT as well as inherited handlers.
+    let mut action: libc::sigaction = unsafe { std::mem::zeroed() };
+    action.sa_sigaction = disposition;
+    if unsafe { libc::sigemptyset(&mut action.sa_mask) } == -1
+        || unsafe { libc::sigaction(signal, &action, std::ptr::null_mut()) } == -1
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
