+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_local_driver_refusal_uses_actual_request_and_preserves_upstream()
+    -> anyhow::Result<()> {
+        use crate::tools::handlers::unified_exec::preparation::ExecCommandLifetime;
+        use crate::tools::handlers::unified_exec::preparation::ParsedExecCommand;
+        use crate::unified_exec::UnifiedExecContext;
+        use crate::unified_exec::UnifiedExecProcessManager;
+        for enabled in [false, true] {
+            let (session, turn, _events) =
+                crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                    codex_login::CodexAuth::from_api_key("fixture-only"),
+                    Vec::new(),
+                    |config| {
+                        let result = if enabled {
+                            config
+                                .features
+                                .enable(codex_features::Feature::ShellSnapshotV2)
+                        } else {
+                            config
+                                .features
+                                .disable(codex_features::Feature::ShellSnapshotV2)
+                        };
+                        assert!(result.is_ok());
+                    },
+                )
+                .await;
+            for login in [false, true] {
+                let step = StepContext::for_test(Arc::clone(&turn));
+                step.native_hooks.capture(session.hooks());
+                let id = format!("driver-{enabled}-{login}");
+                let mut invocation =
+                    hook_probe_invocation(&session, step, ToolName::plain("exec_command"), &id);
+                admit_hook_dispatch(&mut invocation, false)?;
+                let state = invocation
+                    .native_completion
+                    .clone()
+                    .ok_or_else(|| anyhow::anyhow!("completion"))?;
+                let mut context = UnifiedExecContext::new(
+                    Arc::clone(&session),
+                    invocation.step_context,
+                    tokio_util::sync::CancellationToken::new(),
+                    id.clone(),
+                );
+                context.native_completion = Some(Arc::clone(&state));
+                let mut environment = context
+                    .step_context
+                    .environments
+                    .primary()
+                    .cloned()
+                    .ok_or_else(|| anyhow::anyhow!("environment"))?;
+                environment.shell_snapshot_v2_supported = true;
+                let input =
+                    serde_json::json!({"cmd":"printf original-command","login":login}).to_string();
+                let mut prepared = ParsedExecCommand::parse(
+                    &input,
+                    &session,
+                    &context.step_context,
+                    &environment,
+                )?
+                .prepare(ExecCommandLifetime::Interactive)?;
+                assert_eq!(prepared.resolved.shell.is_posix_login(), login);
+                let command = prepared.resolved.command.clone();
+                let result = UnifiedExecProcessManager::ensure_native_completion_backend(
+                    &prepared, &context,
+                );
+                assert_eq!(result.is_err(), enabled && login);
+                assert_eq!(
+                    prepared.resolved.command, command,
+                    "admission must not rewrite login or command"
+                );
+                state.finish(&session);
+                if enabled && login {
+                    let proof = refusal_header(
+                        result
+                            .err()
+                            .ok_or_else(|| anyhow::anyhow!("driver refusal"))?,
+                        &state,
+                    )?;
+                    assert_eq!(proof["call_id"], id);
+                    assert_eq!(proof["outcome"], "pre_backend_rejected");
+                    assert!(proof["session_id"].is_null());
+                    // Same login request at a non-snapshot cwd uses local spawning.
+                    prepared.turn_environment.selection.cwd =
+                        codex_utils_path_uri::PathUri::parse("file:///different-owned-cwd")?;
+                    assert!(
+                        UnifiedExecProcessManager::ensure_native_completion_backend(
+                            &prepared, &context
+                        )
+                        .is_ok()
+                    );
+                }
+                // A normal upstream path never gains the Native-only restriction.
+                let ordinary = UnifiedExecContext::new(
+                    Arc::clone(&session),
+                    StepContext::for_test(Arc::clone(&turn)),
+                    tokio_util::sync::CancellationToken::new(),
+                    "ordinary".into(),
+                );
+                prepared.turn_environment.selection.cwd = prepared.cwd.clone();
+                assert!(
+                    UnifiedExecProcessManager::ensure_native_completion_backend(
+                        &prepared, &ordinary
+                    )
+                    .is_ok()
+                );
+            }
+        }
+        Ok(())
+    }
