@@ -5,6 +5,36 @@ use pretty_assertions::assert_eq;
 use serde_json::Value;
 use test_case::test_case;
 
+#[test]
+fn account_observation_authentication_errors_are_distinct_from_policy_and_routing_errors() {
+    for failure in [
+        WorkspaceRoutingError::DiscoveryUnauthorized,
+        WorkspaceRoutingError::RefreshTokenRejected(RefreshTokenFailedError::new(
+            codex_protocol::auth::RefreshTokenFailedReason::Revoked,
+            "refresh token was revoked",
+        )),
+    ] {
+        let response = account_read_rpc_error(failure.into());
+        assert_eq!(response.code, -32603);
+        assert_eq!(
+            response.data,
+            Some(serde_json::json!({"reason":"accountAuthenticationUnavailable"})),
+        );
+    }
+    for failure in [
+        WorkspaceRoutingError::RequirementsLoad("cloud config: authentication failed".into()),
+        WorkspaceRoutingError::RequirementsReload("cloud config: authentication failed".into()),
+        WorkspaceRoutingError::BackendConflict,
+        WorkspaceRoutingError::AccountChanged,
+        WorkspaceRoutingError::DiscoveryFailed,
+        WorkspaceRoutingError::Shutdown,
+    ] {
+        let response = account_read_rpc_error(failure.into());
+        assert_eq!(response.code, -32603);
+        assert!(response.data.is_none());
+    }
+}
