+            let EventMsg::ItemCompleted(item) = persisted.as_ref() else {
+                anyhow::bail!("canonical event retained");
+            };
+            let TurnItem::CommandExecution(command) = &item.item else {
+                anyhow::bail!("canonical command retained");
+            };
+            let output = command
+                .aggregated_output
+                .as_deref()
+                .ok_or_else(|| anyhow::anyhow!("bounded original output"))?;
+            assert!(output.len() <= super::PERSISTED_COMMAND_OUTPUT_MAX_BYTES);
+            assert!(output.contains(super::PERSISTED_COMMAND_OUTPUT_TRUNCATION_MARKER));
+            assert_eq!(command.exit_code, Some(124));
+            assert_eq!(command.id, end.call_id);
+            assert_eq!(item.started_at_ms, Some(1));
+            assert_eq!(item.completed_at_ms, end.completed_at_ms);
+            let value = serde_json::to_value(persisted.as_ref())?;
+            if let Some(expected) = &expected {
