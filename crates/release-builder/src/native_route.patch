+#[tokio::test]
+async fn native_completion_shutdown_keeps_admitted_persistence_until_flush_finishes()
+-> anyhow::Result<()> {
+    let (session, _) = make_session_and_context().await;
+    let token = session
+        .track_native_completion()
+        .ok_or_else(|| anyhow::anyhow!("local completion admitted before shutdown"))?;
+    let mut shutdown = Box::pin(session.drain_code_mode_messages());
+    assert!(futures::poll!(shutdown.as_mut()).is_pending());
+    assert!(
+        session.track_native_completion().is_none(),
+        "admission is closed"
+    );
+
+    // The same watcher retains its token after actual wait and while the
+    // original receipt is being appended/flushed. Closing the tracker may not
+    // make the subsequent LiveThread shutdown race that pending write.
+    let (flush, pending_flush) = tokio::sync::oneshot::channel::<()>();
+    let waiter = tokio::spawn(async move {
+        let _token = token;
+        pending_flush.await
+    });
+    assert!(futures::poll!(shutdown.as_mut()).is_pending());
+    flush
+        .send(())
+        .map_err(|_| anyhow::anyhow!("flush waiter remains owned"))?;
+    waiter.await??;
+    shutdown.await;
+    assert!(session.track_native_completion().is_none());
+    Ok(())
+}
