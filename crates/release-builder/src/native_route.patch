+#[cfg(any(target_os = "linux", target_os = "android"))]
+#[tokio::test]
+async fn native_completion_pruning_stops_only_selected_scope() -> anyhow::Result<()> {
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    let (_, turn) = crate::session::tests::make_session_and_context().await;
+    let directory = tempfile::tempdir()?;
+    let (shell, sleep) = if cfg!(target_os = "android") {
+        ("/system/bin/sh", "/system/bin/sleep")
+    } else {
+        ("/bin/sh", "/bin/sleep")
+    };
+    let mut scopes = Vec::new();
+    for _ in 0..2 {
+        let spawned = codex_utils_pty::pipe::spawn_process_guarded(
+            shell,
+            &["-c".into(), format!("exec {sleep} 60")],
+            directory.path(),
+            &HashMap::new(),
+            &None,
+            &[],
+            true,
+        )
+        .await?;
+        scopes.push(Arc::new(
+            UnifiedExecProcess::from_spawned_with_native_attempt(
+                spawned,
+                codex_sandboxing::SandboxType::None,
+                None,
+            )
+            .await?,
+        ));
+    }
+    let selected = &scopes[0];
+    let sibling = &scopes[1];
+    let now = Instant::now();
+    let cwd = PathUri::from(AbsolutePathBuf::from_absolute_path(directory.path())?);
+    let environment = turn
+        .initial_environments
+        .primary()
+        .ok_or_else(|| anyhow::anyhow!("original local environment"))?;
+    let mut store = ProcessStore::default();
+    let cap = i32::try_from(MAX_UNIFIED_EXEC_PROCESSES)?;
+    for process_id in 1..=cap {
+        store.processes.insert(
+            process_id,
+            ProcessEntry {
+                process: Arc::clone(if process_id == 1 { selected } else { sibling }),
+                plugin_metrics_sidecar: None,
+                call_id: format!("prune-{process_id}"),
+                process_id,
+                cwd: cwd.clone(),
+                initial_exec_command_active: Arc::new(AtomicBool::new(false)),
+                hook_command: "owned pruning scope".into(),
+                tty: false,
+                environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_owned(),
+                permissions: super::super::TerminalPermissions::for_launch(
+                    environment,
+                    &turn,
+                    super::super::TerminalSandboxSource::Native,
+                    crate::sandboxing::SandboxPermissions::UseDefault,
+                    None,
+                    None,
+                ),
+                network_approval: None,
+                session: std::sync::Weak::new(),
+                last_used: now - Duration::from_millis(u64::try_from(cap + 1 - process_id)?),
+            },
+        );
+    }
+
+    let pruned = UnifiedExecProcessManager::prune_processes_if_needed(&mut store);
+    let selected_stopped = selected.cancellation_token().is_cancelled();
+    let sibling_untouched = !sibling.cancellation_token().is_cancelled();
+    let retained = store.processes.len();
+    // Cleanup remains independent of the assertion outcome.
+    sibling.terminate();
+    for scope in scopes {
+        assert!(tokio::time::timeout(Duration::from_secs(5), scope.wait_for_process_tree()).await?);
+    }
+    assert!(pruned.is_none(), "the original scope remains addressable");
+    assert_eq!(retained, MAX_UNIFIED_EXEC_PROCESSES);
+    assert!(
+        selected_stopped,
+        "the one policy-selected scope receives Stop"
+    );
+    assert!(
+        sibling_untouched,
+        "one prune cannot cancel another live scope"
+    );
+    Ok(())
+}
