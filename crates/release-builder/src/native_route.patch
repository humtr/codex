+
+    fn refusal_header(
+        error: FunctionCallError,
+        state: &crate::native_completion::CallCompletion,
+    ) -> anyhow::Result<Value> {
+        let error = crate::native_completion::decorate(Err(error), state)
+            .err()
+            .ok_or_else(|| anyhow::anyhow!("original refusal"))?
+            .to_string();
+        serde_json::from_str(
+            error
+                .lines()
+                .next()
+                .and_then(|line| line.strip_prefix("Native completion: "))
+                .ok_or_else(|| anyhow::anyhow!("trusted completion header"))?,
+        )
+        .map_err(Into::into)
+    }
+
+    #[cfg(unix)]
+    struct HookAdmissionProbe {
+        name: ToolName,
+        calls: Arc<std::sync::atomic::AtomicUsize>,
+        reload: Option<Arc<Hooks>>,
+        permission: bool,
+    }
+
+    #[cfg(unix)]
+    impl codex_tools::ToolExecutor<ToolInvocation> for HookAdmissionProbe {
+        fn tool_name(&self) -> ToolName {
+            self.name.clone()
+        }
+        fn spec(&self) -> codex_tools::ToolSpec {
+            codex_tools::ToolSpec::Function(codex_tools::ResponsesApiTool {
+                name: self.name.name.clone(),
+                description: "Hook admission probe".into(),
+                strict: false,
+                defer_loading: None,
+                parameters: Default::default(),
+                output_schema: None,
+            })
+        }
+        fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+        where
+            ToolInvocation: 'a,
+        {
+            Box::pin(async move {
+                self.calls.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                if self.permission {
+                    let review =
+                        crate::guardian::GuardianReviewContext::from(&invocation.step_context);
+                    crate::hook_runtime::run_permission_request_hooks(
+                        &invocation.session,
+                        &review,
+                        &invocation.call_id,
+                        crate::tools::sandboxing::PermissionRequestPayload {
+                            tool_name: crate::tools::hook_names::HookToolName::bash(),
+                            tool_cwd: None,
+                            tool_input: serde_json::json!({}),
+                        },
+                        "local",
+                    )
+                    .await;
+                }
+                Ok(
+                    Box::new(crate::tools::context::FunctionToolOutput::from_text(
+                        "backend completed".into(),
+                        Some(true),
+                    )) as Box<dyn codex_tools::ToolOutput>,
+                )
+            })
+        }
+    }
+    #[cfg(unix)]
+    impl crate::tools::registry::CoreToolRuntime for HookAdmissionProbe {
+        fn environments_for_input(
+            &self,
+            invocation: &ToolInvocation,
+        ) -> Result<crate::tools::context::ToolEnvironments, FunctionCallError> {
+            // The registry has admitted the call, but has not dispatched its
+            // Pre hook yet. A reload here exercises all three hook consumers.
+            if let Some(reload) = &self.reload {
+                invocation.session.services.hooks.store(Arc::clone(reload));
+            }
+            Ok(crate::tools::context::ToolEnvironments::All)
+        }
+    }
