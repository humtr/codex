+#[test_case(false; "former_catalog")]
+#[test_case(true; "required_catalog")]
+#[tokio::test]
+async fn model_provider_update_does_not_reopen_former_catalog_but_preserves_requirements(
+    required: bool,
+) -> Result<()> {
+    let home = tempdir()?;
+    let original = ConfigManager::without_managed_config_for_tests(home.path().to_path_buf());
+    let current = original.load_latest_config(None).await?;
+    let missing = home.path().join("former-catalog.json");
+    let catalog = format!("model_catalog_json = {:?}", missing.to_string_lossy());
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            "{catalog}\n[model_providers.alternate]\nname = 'Alternate'\nwire_api = 'responses'\nrequires_openai_auth = false\n"
+        ),
+    )?;
+    let manager = ConfigManager::new_for_tests(
+        home.path().to_path_buf(),
+        Vec::new(),
+        LoaderOverrides::without_managed_config_for_tests(),
+        CloudConfigBundleFixture::loader_with_enterprise_requirement(if required {
+            &catalog
+        } else {
+            ""
+        }),
     );
+    let result = manager
+        .load_model_provider_update(&current, "alternate", None, None)
+        .await;
+    if required {
+        assert_eq!(result.unwrap_err().kind(), std::io::ErrorKind::NotFound);
+        let model = codex_models_manager::model_info::model_info_from_slug("managed-catalog-model");
+        std::fs::write(
+            &missing,
+            serde_json::to_vec(&serde_json::json!({"models": [model]}))?,
+        )?;
+        let destination = manager
+            .load_model_provider_update(&current, "alternate", None, None)
+            .await?;
+        assert_eq!(
+            destination.model_catalog.expect("required catalog").models[0].slug,
+            "managed-catalog-model"
+        );
+    } else {
+        let destination = result?;
+        assert_eq!(destination.model_provider_id, "alternate");
+        assert!(destination.model_catalog.is_none());
+    }
+    assert_eq!(current.model_provider_id, "openai");
     Ok(())
 }
