+fn native_proof_engine(matcher: Option<&str>, event: HookEventName) -> ClaudeHooksEngine {
+    let mut engine = ClaudeHooksEngine::new(
+        true,
+        false,
+        None,
+        Vec::new(),
+        Vec::new(),
+        command_runtime(CommandShell {
+            program: String::new(),
+            args: Vec::new(),
+        }),
+        mcp_executor(),
+    );
+    engine.handlers = Arc::new(vec![ConfiguredHandler {
+        builtin: false,
+        plugin_trust: None,
+        event_name: event,
+        matcher: matcher.map(|pattern| super::HookMatcher::new(pattern).unwrap()),
+        timeout_sec: 5,
+        status_message: None,
+        additional_context_limit: Default::default(),
+        source_path: cwd().join("hooks.json").into(),
+        source: HookSource::User,
+        display_order: 0,
+        kind: ConfiguredHandlerKind::Command {
+            command: "a-real-hook-keeps-its-original-effects".to_string(),
+            r#async: false,
+            env: HashMap::new(),
+        },
+    }]);
+    engine
+}
+
+const NATIVE_EXEC_HOOK_NAMES: &[&str] = &[
+    "exec_command",
+    "functions.exec_command",
+    "write_stdin",
+    "functions.write_stdin",
+];
+const NATIVE_EXEC_PERMISSION_NAMES: &[&str] = &["Bash", "write_stdin"];
+
+#[test]
+fn native_resource_proof_retains_unrelated_input_hook_and_its_dispatch() {
+    let engine = native_proof_engine(
+        Some(r"^(functions\.)?request_user_input(_async)?$"),
+        HookEventName::PreToolUse,
+    );
+    assert!(engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+    for name in ["request_user_input", "functions.request_user_input_async"] {
+        assert_eq!(
+            super::dispatcher::select_handlers_for_matcher_inputs(
+                &engine.handlers,
+                HookEventName::PreToolUse,
+                &[name],
+            )
+            .len(),
+            1,
+            "resource proof must not remove the unrelated notification",
+        );
+    }
+}
+
+#[test]
+fn native_resource_proof_rejects_each_matching_tool_event_and_permission_alias() {
+    for event in [HookEventName::PreToolUse, HookEventName::PostToolUse] {
+        for matcher in [
+            None,
+            Some("*"),
+            Some("exec_command"),
+            Some(r"^functions\.exec_command$"),
+            Some("write_stdin"),
+        ] {
+            let engine = native_proof_engine(matcher, event);
+            assert!(
+                !engine
+                    .tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES)
+            );
+        }
+    }
+    for matcher in [None, Some("Bash"), Some("write_stdin")] {
+        let engine = native_proof_engine(matcher, HookEventName::PermissionRequest);
+        assert!(
+            !engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES)
+        );
+    }
+    for (names, permissions) in [
+        (
+            &["apply_patch", "functions.apply_patch", "Write", "Edit"][..],
+            &["apply_patch", "Write", "Edit"][..],
+        ),
+        (&["view_image", "functions.view_image"][..], &[][..]),
+        (&["clock.curr_time", "mcp__clock__curr_time"][..], &[][..]),
+        (&["clock.sleep", "mcp__clock__sleep"][..], &[][..]),
+    ] {
+        for event in [HookEventName::PreToolUse, HookEventName::PostToolUse] {
+            for name in names {
+                let matcher = format!("^{}$", regex::escape(name));
+                let engine = native_proof_engine(Some(&matcher), event);
+                assert!(!engine.tool_has_no_hook_effects(names, permissions));
+                assert!(
+                    engine.tool_has_no_hook_effects(
+                        NATIVE_EXEC_HOOK_NAMES,
+                        NATIVE_EXEC_PERMISSION_NAMES
+                    ),
+                    "a matching patch/image/MCP hook must not block unrelated exec"
+                );
+            }
+        }
+        for name in permissions {
+            let engine = native_proof_engine(Some(name), HookEventName::PermissionRequest);
+            assert!(!engine.tool_has_no_hook_effects(names, permissions));
+        }
+    }
+}
+
+#[test]
+fn native_resource_proof_rejects_unknown_async_and_non_tool_hook_effects() {
+    let mut engine = native_proof_engine(Some("request_user_input"), HookEventName::PreToolUse);
+    assert!(engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+    engine.warnings = vec!["invalid or unavailable hook source".to_string()].into();
+    assert!(!engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+    engine.warnings = Arc::default();
+    engine.required_load_errors = vec!["required hook source unknown".to_string()].into();
+    assert!(!engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+    engine.required_load_errors = Arc::default();
+    if let ConfiguredHandlerKind::Command { r#async, .. } =
+        &mut Arc::make_mut(&mut engine.handlers)[0].kind
+    {
+        *r#async = true;
+    }
+    assert!(!engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+    for event in [
+        HookEventName::PreModelRequest,
+        HookEventName::PostModelRequest,
+        HookEventName::Stop,
+        HookEventName::SessionStart,
+    ] {
+        let engine = native_proof_engine(None, event);
+        assert!(
+            !engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES)
+        );
+    }
+}
+
+#[tokio::test]
+async fn native_resource_proof_rejects_async_work_retained_after_reconfiguration() {
+    let mut engine = native_proof_engine(Some("request_user_input"), HookEventName::PreToolUse);
+    engine.handlers = Arc::default();
+    engine
+        .command_runtime
+        .schedule_async_task(std::future::pending());
+    assert!(!engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+    engine.command_runtime.shutdown().await;
+    assert!(engine.tool_has_no_hook_effects(NATIVE_EXEC_HOOK_NAMES, NATIVE_EXEC_PERMISSION_NAMES));
+}
+
+#[test]
+fn native_completion_hooks_are_scoped_to_original_exec_or_continuation() {
+    let exec_names = &["Bash", "exec_command", "functions.exec_command"];
+    let poll_names = &["Bash", "write_stdin", "functions.write_stdin"];
+    for event in [HookEventName::PreToolUse, HookEventName::PostToolUse] {
+        let bash = native_proof_engine(Some("Bash"), event);
+        assert!(!bash.tool_has_no_hook_effects(exec_names, &["Bash"]));
+        assert!(!bash.tool_has_no_hook_effects(poll_names, &["write_stdin"]));
+    }
+    for (event, exec_matcher, poll_matcher) in [
+        (HookEventName::PreToolUse, "exec_command", "write_stdin"),
+        (HookEventName::PostToolUse, "exec_command", "write_stdin"),
+        (HookEventName::PermissionRequest, "Bash", "write_stdin"),
+    ] {
+        let exec_hook = native_proof_engine(Some(exec_matcher), event);
+        assert!(!exec_hook.tool_has_no_hook_effects(exec_names, &["Bash"]));
+        assert!(exec_hook.tool_has_no_hook_effects(poll_names, &["write_stdin"]));
+        let poll_hook = native_proof_engine(Some(poll_matcher), event);
+        assert!(poll_hook.tool_has_no_hook_effects(exec_names, &["Bash"]));
+        assert!(!poll_hook.tool_has_no_hook_effects(poll_names, &["write_stdin"]));
+    }
+}
