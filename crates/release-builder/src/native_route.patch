+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_advertised_scope_includes_actual_bash_hooks() -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let owned = tempfile::tempdir()?;
+        let clear = HookSnapshot::default();
+        let available = &clear.capture(session.hooks()).hook_free_tools;
+        for tool in [
+            "exec_command",
+            "write_stdin",
+            "view_image",
+            "clock.curr_time",
+            "clock.sleep",
+        ] {
+            assert!(
+                available.contains(&tool),
+                "hook-free {tool} must remain available"
+            );
+        }
+        // The MCP producer retains server and leaf separately, with an
+        // optional mcp__ namespace prefix. These aliases qualify hook dispatch
+        // only; a server named clock is not proof of read-only resource scope.
+        let unrelated = configured_hook_events(
+            &session,
+            owned.path(),
+            "unrelated",
+            "request_user_input",
+            &["pre", "post", "permission"],
+        )?;
+        let snapshot = HookSnapshot::default();
+        snapshot.capture(Arc::clone(&unrelated));
+        for (leaf, fact) in [("curr_time", "clock.curr_time"), ("sleep", "clock.sleep")] {
+            for namespace in ["clock", "mcp__clock"] {
+                let actual = ToolName::namespaced(namespace, leaf);
+                assert_eq!(qualified_hook_tool(&actual), Some(fact));
+                assert!(snapshot.admit(&unrelated, &actual).is_ok());
+            }
+            for namespace in ["foreign", "clock.", "mcp__clock__"] {
+                let foreign = ToolName::namespaced(namespace, leaf);
+                assert_eq!(qualified_hook_tool(&foreign), None);
+                assert!(snapshot.admit(&unrelated, &foreign).is_err());
+            }
+            for legacy in [fact.to_string(), format!("mcp__clock__{leaf}")] {
+                assert_eq!(qualified_hook_tool(&ToolName::plain(legacy)), Some(fact));
+            }
+        }
+        // MCP uses the same canonical mcp__ name for all three actual hook
+        // events. Test each event separately so a matching Pre hook cannot hide
+        // a missing Permission matcher. view_image has no Permission producer;
+        // its canonical name intentionally remains a conservative exclusion.
+        for (tool, matcher) in [
+            ("view_image", "view_image"),
+            ("clock.curr_time", "mcp__clock__curr_time"),
+            ("clock.sleep", "mcp__clock__sleep"),
+        ] {
+            for event in ["pre", "post", "permission"] {
+                let hooks =
+                    configured_hook_events(&session, owned.path(), "read", matcher, &[event])?;
+                let snapshot = HookSnapshot::default();
+                let scope = &snapshot.capture(Arc::clone(&hooks)).hook_free_tools;
+                assert!(
+                    !scope.contains(&tool),
+                    "matching {event} must exclude {tool}"
+                );
+                assert!(
+                    scope.contains(&"exec_command"),
+                    "unrelated read hooks must not block exec"
+                );
+                if let Some(leaf) = tool.strip_prefix("clock.") {
+                    for namespace in ["clock", "mcp__clock"] {
+                        let actual = ToolName::namespaced(namespace, leaf);
+                        assert!(snapshot.admit(&hooks, &actual).is_err());
+                    }
+                }
+                for other in ["view_image", "clock.curr_time", "clock.sleep"] {
+                    if other != tool {
+                        assert!(scope.contains(&other), "{tool} hook must not block {other}");
+                    }
+                }
+            }
+        }
+        let stdin_hooks = configured_hook_events(
+            &session,
+            owned.path(),
+            "stdin",
+            "write_stdin",
+            &["permission"],
+        )?;
+        let snapshot = HookSnapshot::default();
+        let available = &snapshot.capture(Arc::clone(&stdin_hooks)).hook_free_tools;
+        assert!(available.contains(&"exec_command"));
+        assert!(!available.contains(&"write_stdin"));
+        assert!(
+            snapshot
+                .admit(&stdin_hooks, &ToolName::plain("exec_command"))
+                .is_ok()
+        );
+        assert!(
+            snapshot
+                .admit(&stdin_hooks, &ToolName::plain("write_stdin"))
+                .is_err()
+        );
+        let hooks = configured_hooks(&session, owned.path(), "bash", "Bash")?;
+        session.services.hooks.store(hooks);
+        let step = StepContext::for_test(Arc::new(turn));
+        assert!(
+            !step
+                .native_hooks
+                .capture(session.hooks())
+                .hook_free_tools
+                .contains(&"exec_command")
+        );
+        for tool in ["exec_command", "write_stdin"] {
+            let state = crate::native_completion::CallCompletion::default();
+            state.capture(&session, &step, tool, &ToolName::plain(tool));
+            assert!(
+                !state.is_admitted(),
+                "actual Bash hooks make {tool} effectful"
+            );
+        }
+        assert!(
+            !owned.path().join("hook-effects").exists(),
+            "proof inspection never runs hooks"
+        );
+        Ok(())
+    }
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_process_capability_is_per_tool_and_refuses_before_effects()
+    -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let owned = tempfile::tempdir()?;
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        for mode in ["clear", "stdin", "bash", "async"] {
+            let pending = Arc::new(tokio::sync::Notify::new());
+            match mode {
+                "stdin" => session.services.hooks.store(configured_hook_events(
+                    &session,
+                    owned.path(),
+                    "stdin",
+                    "write_stdin",
+                    &["permission"],
+                )?),
+                "bash" => session.services.hooks.store(configured_hooks(
+                    &session,
+                    owned.path(),
+                    "bash",
+                    "Bash",
+                )?),
+                "async" => {
+                    session
+                        .services
+                        .hooks
+                        .store(Arc::new(session.hooks().reconfigured(Default::default())));
+                    let wait = Arc::clone(&pending);
+                    session
+                        .hooks()
+                        .schedule_async_task(async move { wait.notified().await });
+                }
+                _ => {}
+            }
+            for tool in ["exec_command", "write_stdin"] {
+                let step = StepContext::for_test(Arc::clone(&turn));
+                step.native_hooks.capture(session.hooks());
+                let name = ToolName::plain(tool);
+                let registry =
+                    crate::tools::registry::ToolRegistry::from_tools([
+                        Arc::new(HookAdmissionProbe {
+                            name: name.clone(),
+                            calls: Arc::clone(&calls),
+                            reload: None,
+                            permission: false,
+                        })
+                            as Arc<dyn crate::tools::registry::CoreToolRuntime>,
+                    ]);
+                let id = format!("capability-{mode}-{tool}");
+                let invocation = hook_probe_invocation(&session, step, name, &id);
+                let state = invocation
+                    .native_completion
+                    .clone()
+                    .ok_or_else(|| anyhow::anyhow!("completion"))?;
+                let result = registry.dispatch_any_with_state(invocation, None).await;
+                state.finish(&session);
+                let allowed = mode == "clear" || mode == "stdin" && tool == "exec_command";
+                if allowed {
+                    result?;
+                } else {
+                    assert!(
+                        result.is_err(),
+                        "unsupported completion must fail before dispatch"
+                    );
+                    let proof = refusal_header(
+                        result.err().ok_or_else(|| anyhow::anyhow!("refusal"))?,
+                        &state,
+                    )?;
+                    assert_eq!(proof["call_id"], id);
+                    assert_eq!(proof["outcome"], "pre_backend_rejected");
+                    assert!(proof["session_id"].is_null());
+                    assert!(proof["exit_code"].is_null());
+                }
+            }
+            if mode == "async" {
+                pending.notify_one();
+                session.hooks().shutdown().await;
+            }
+        }
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 3);
+        assert!(!owned.path().join("hook-effects").exists());
+        Ok(())
+    }
