+    #[tokio::test]
+    async fn native_completion_advertised_scope_includes_actual_bash_hooks() -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let owned = tempfile::tempdir()?;
+        let clear = HookSnapshot::default();
+        let available = &clear.capture(session.hooks()).hook_free_tools;
+        for tool in [
+            "exec_command",
+            "write_stdin",
+            "view_image",
+            "clock.curr_time",
+            "clock.sleep",
+        ] {
+            assert!(
+                available.contains(&tool),
+                "hook-free {tool} must remain available"
+            );
+        }
+        // The MCP producer retains server and leaf separately, with an
+        // optional mcp__ namespace prefix. These aliases qualify hook dispatch
+        // only; a server named clock is not proof of read-only resource scope.
+        let unrelated = configured_hook_events(
+            &session,
+            owned.path(),
+            "unrelated",
+            "request_user_input",
+            &["pre", "post", "permission"],
+        )?;
+        let snapshot = HookSnapshot::default();
+        snapshot.capture(Arc::clone(&unrelated));
+        for (leaf, fact) in [("curr_time", "clock.curr_time"), ("sleep", "clock.sleep")] {
+            for namespace in ["clock", "mcp__clock"] {
+                let actual = ToolName::namespaced(namespace, leaf);
+                assert_eq!(qualified_hook_tool(&actual, Some("clock")), Some(fact));
+                assert!(
+                    snapshot
+                        .admit(&unrelated, &actual, Some("clock"))
+                        .is_ok()
+                );
+                assert_eq!(qualified_hook_tool(&actual, None), None);
+                assert!(snapshot.admit(&unrelated, &actual, None).is_err());
+            }
+            for namespace in ["foreign", "clock.", "mcp__clock__"] {
+                let foreign = ToolName::namespaced(namespace, leaf);
+                assert_eq!(qualified_hook_tool(&foreign, Some("clock")), None);
+                assert!(
+                    snapshot
+                        .admit(&unrelated, &foreign, Some("clock"))
+                        .is_err()
+                );
+            }
+            for legacy in [fact.to_string(), format!("mcp__clock__{leaf}")] {
+                assert_eq!(
+                    qualified_hook_tool(&ToolName::plain(legacy), None),
+                    Some(fact)
+                );
+            }
+        }
+        // Raw MCP server identity comes from the registered runtime, not the
+        // callable tuple. A valid server named mcp__clock must not borrow clock's
+        // hook-free fact when the namespace prefix option is disabled.
+        for leaf in ["curr_time", "sleep"] {
+            let actual = ToolName::namespaced("mcp__clock", leaf);
+            assert_eq!(qualified_hook_tool(&actual, Some("mcp__clock")), None);
+            for event in ["pre", "post", "permission"] {
+                let matcher = format!("mcp__mcp__clock__{leaf}");
+                let hooks = configured_hook_events(
+                    &session,
+                    owned.path(),
+                    "colliding-clock",
+                    &matcher,
+                    &[event],
+                )?;
+                let snapshot = HookSnapshot::default();
+                snapshot.capture(Arc::clone(&hooks));
+                assert!(
+                    snapshot
+                        .admit(&hooks, &actual, Some("mcp__clock"))
+                        .is_err()
+                );
+            }
+        }
+        // MCP uses the same canonical mcp__ name for all three actual hook
+        // events. Test each event separately so a matching Pre hook cannot hide
+        // a missing Permission matcher. view_image has no Permission producer;
+        // its canonical name intentionally remains a conservative exclusion.
+        for (tool, matcher) in [
+            ("view_image", "view_image"),
+            ("clock.curr_time", "mcp__clock__curr_time"),
+            ("clock.sleep", "mcp__clock__sleep"),
+        ] {
+            for event in ["pre", "post", "permission"] {
+                let hooks =
+                    configured_hook_events(&session, owned.path(), "read", matcher, &[event])?;
+                let snapshot = HookSnapshot::default();
+                let scope = &snapshot.capture(Arc::clone(&hooks)).hook_free_tools;
+                assert!(
+                    !scope.contains(&tool),
+                    "matching {event} must exclude {tool}"
+                );
+                assert!(
+                    scope.contains(&"exec_command"),
+                    "unrelated read hooks must not block exec"
+                );
+                if let Some(leaf) = tool.strip_prefix("clock.") {
+                    for namespace in ["clock", "mcp__clock"] {
+                        let actual = ToolName::namespaced(namespace, leaf);
+                        assert!(
+                            snapshot
+                                .admit(&hooks, &actual, Some("clock"))
+                                .is_err()
+                        );
+                    }
+                }
+                for other in ["view_image", "clock.curr_time", "clock.sleep"] {
+                    if other != tool {
+                        assert!(scope.contains(&other), "{tool} hook must not block {other}");
+                    }
+                }
+            }
+        }
+        let stdin_hooks = configured_hook_events(
+            &session,
+            owned.path(),
+            "stdin",
+            "write_stdin",
+            &["permission"],
+        )?;
+        let snapshot = HookSnapshot::default();
+        let available = &snapshot.capture(Arc::clone(&stdin_hooks)).hook_free_tools;
+        assert!(available.contains(&"exec_command"));
+        assert!(!available.contains(&"write_stdin"));
+        assert!(
+            snapshot
+                .admit(&stdin_hooks, &ToolName::plain("exec_command"), None)
+                .is_ok()
+        );
+        assert!(
+            snapshot
+                .admit(&stdin_hooks, &ToolName::plain("write_stdin"), None)
+                .is_err()
+        );
+        let hooks = configured_hooks(&session, owned.path(), "bash", "Bash")?;
+        session.services.hooks.store(hooks);
+        let step = StepContext::for_test(Arc::new(turn));
+        assert!(
+            !step
+                .native_hooks
+                .capture(session.hooks())
+                .hook_free_tools
+                .contains(&"exec_command")
+        );
+        for tool in ["exec_command", "write_stdin"] {
+            let state = crate::native_completion::CallCompletion::default();
+            state.capture(&session, &step, tool, &ToolName::plain(tool));
+            assert!(
+                !state.is_admitted(),
+                "actual Bash hooks make {tool} effectful"
+            );
+        }
+        assert!(
+            !owned.path().join("hook-effects").exists(),
+            "proof inspection never runs hooks"
+        );
+        Ok(())
+    }
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_process_capability_is_per_tool_and_refuses_before_effects()
+    -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let owned = tempfile::tempdir()?;
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        for mode in ["clear", "stdin", "bash", "async"] {
+            let pending = Arc::new(tokio::sync::Notify::new());
+            match mode {
+                "stdin" => session.services.hooks.store(configured_hook_events(
+                    &session,
+                    owned.path(),
+                    "stdin",
+                    "write_stdin",
+                    &["permission"],
+                )?),
+                "bash" => session.services.hooks.store(configured_hooks(
+                    &session,
+                    owned.path(),
+                    "bash",
+                    "Bash",
+                )?),
+                "async" => {
+                    session
+                        .services
+                        .hooks
+                        .store(Arc::new(session.hooks().reconfigured(Default::default())));
+                    let wait = Arc::clone(&pending);
+                    session
+                        .hooks()
+                        .schedule_async_task(async move { wait.notified().await });
+                }
+                _ => {}
+            }
+            for tool in ["exec_command", "write_stdin"] {
+                let step = StepContext::for_test(Arc::clone(&turn));
+                step.native_hooks.capture(session.hooks());
+                let name = ToolName::plain(tool);
+                let registry =
+                    crate::tools::registry::ToolRegistry::from_tools([
+                        Arc::new(HookAdmissionProbe {
+                            name: name.clone(),
+                            calls: Arc::clone(&calls),
+                            reload: None,
+                            permission: false,
+                        })
+                            as Arc<dyn crate::tools::registry::CoreToolRuntime>,
+                    ]);
+                let id = format!("capability-{mode}-{tool}");
+                let invocation = hook_probe_invocation(&session, step, name, &id);
+                let state = invocation
+                    .native_completion
+                    .clone()
+                    .ok_or_else(|| anyhow::anyhow!("completion"))?;
+                let result = registry.dispatch_any_with_state(invocation, None).await;
+                state.finish(&session);
+                let allowed = mode == "clear" || mode == "stdin" && tool == "exec_command";
+                if allowed {
+                    result?;
+                } else {
+                    assert!(
+                        result.is_err(),
+                        "unsupported completion must fail before dispatch"
+                    );
+                    let proof = refusal_header(
+                        result.err().ok_or_else(|| anyhow::anyhow!("refusal"))?,
+                        &state,
+                    )?;
+                    assert_eq!(proof["call_id"], id);
+                    assert_eq!(proof["outcome"], "pre_backend_rejected");
+                    assert!(proof["session_id"].is_null());
+                    assert!(proof["exit_code"].is_null());
+                }
+            }
+            if mode == "async" {
+                pending.notify_one();
+                session.hooks().shutdown().await;
+            }
+        }
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 3);
+        assert!(!owned.path().join("hook-effects").exists());
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_local_driver_refusal_uses_actual_request_and_preserves_upstream()
+    -> anyhow::Result<()> {
+        use crate::tools::handlers::unified_exec::preparation::ExecCommandLifetime;
+        use crate::tools::handlers::unified_exec::preparation::ParsedExecCommand;
+        use crate::unified_exec::UnifiedExecContext;
+        use crate::unified_exec::UnifiedExecProcessManager;
+        for enabled in [false, true] {
+            let (session, turn, _events) =
+                crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                    codex_login::CodexAuth::from_api_key("fixture-only"),
+                    Vec::new(),
+                    |config| {
+                        let result = if enabled {
+                            config
+                                .features
+                                .enable(codex_features::Feature::ShellSnapshotV2)
+                        } else {
+                            config
+                                .features
+                                .disable(codex_features::Feature::ShellSnapshotV2)
+                        };
+                        assert!(result.is_ok());
+                    },
+                )
+                .await;
+            for login in [false, true] {
+                let step = StepContext::for_test(Arc::clone(&turn));
+                step.native_hooks.capture(session.hooks());
+                let id = format!("driver-{enabled}-{login}");
+                let mut invocation =
+                    hook_probe_invocation(&session, step, ToolName::plain("exec_command"), &id);
+                admit_hook_dispatch(&mut invocation, false, None)?;
+                let state = invocation
+                    .native_completion
+                    .clone()
+                    .ok_or_else(|| anyhow::anyhow!("completion"))?;
+                let mut context = UnifiedExecContext::new(
+                    Arc::clone(&session),
+                    invocation.step_context,
+                    tokio_util::sync::CancellationToken::new(),
+                    id.clone(),
+                );
+                context.native_completion = Some(Arc::clone(&state));
+                let mut environment = context
+                    .step_context
+                    .environments
+                    .primary()
+                    .cloned()
+                    .ok_or_else(|| anyhow::anyhow!("environment"))?;
+                environment.shell_snapshot_v2_supported = true;
+                let input =
+                    serde_json::json!({"cmd":"printf original-command","login":login}).to_string();
+                let mut prepared = ParsedExecCommand::parse(
+                    &input,
+                    &session,
+                    &context.step_context,
+                    &environment,
+                )?
+                .prepare(ExecCommandLifetime::Interactive)?;
+                assert_eq!(prepared.resolved.shell.is_posix_login(), login);
+                let command = prepared.resolved.command.clone();
+                let result = UnifiedExecProcessManager::ensure_native_completion_backend(
+                    &prepared, &context,
+                );
+                assert_eq!(result.is_err(), enabled && login);
+                assert_eq!(
+                    prepared.resolved.command, command,
+                    "admission must not rewrite login or command"
+                );
+                state.finish(&session);
+                if enabled && login {
+                    let proof = refusal_header(
+                        result
+                            .err()
+                            .ok_or_else(|| anyhow::anyhow!("driver refusal"))?,
+                        &state,
+                    )?;
+                    assert_eq!(proof["call_id"], id);
+                    assert_eq!(proof["outcome"], "pre_backend_rejected");
+                    assert!(proof["session_id"].is_null());
+                    // Same login request at a non-snapshot cwd uses local spawning.
+                    prepared.turn_environment.selection.cwd =
+                        codex_utils_path_uri::PathUri::parse("file:///different-owned-cwd")?;
+                    assert!(
+                        UnifiedExecProcessManager::ensure_native_completion_backend(
+                            &prepared, &context
+                        )
+                        .is_ok()
+                    );
+                }
+                // A normal upstream path never gains the Native-only restriction.
+                let ordinary = UnifiedExecContext::new(
+                    Arc::clone(&session),
+                    StepContext::for_test(Arc::clone(&turn)),
+                    tokio_util::sync::CancellationToken::new(),
+                    "ordinary".into(),
+                );
+                prepared.turn_environment.selection.cwd = prepared.cwd.clone();
+                assert!(
+                    UnifiedExecProcessManager::ensure_native_completion_backend(
+                        &prepared, &ordinary
+                    )
+                    .is_ok()
+                );
+            }
+        }
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_intercepted_patch_refuses_before_file_effects() -> anyhow::Result<()>
+    {
+        use crate::tools::handlers::unified_exec::preparation::ExecCommandLifetime;
+        use crate::tools::handlers::unified_exec::preparation::ParsedExecCommand;
+        use crate::unified_exec::UnifiedExecContext;
+        use crate::unified_exec::UnifiedExecProcessManager;
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let owned = tempfile::tempdir()?;
+        let target = owned.path().join("must-not-exist");
+        let step = StepContext::for_test(Arc::clone(&turn));
+        step.native_hooks.capture(session.hooks());
+        let mut invocation = hook_probe_invocation(
+            &session,
+            step,
+            ToolName::plain("exec_command"),
+            "patch-intercept",
+        );
+        admit_hook_dispatch(&mut invocation, false, None)?;
+        let state = invocation
+            .native_completion
+            .clone()
+            .ok_or_else(|| anyhow::anyhow!("completion"))?;
+        let mut context = UnifiedExecContext::new(
+            Arc::clone(&session),
+            invocation.step_context,
+            tokio_util::sync::CancellationToken::new(),
+            "patch-intercept".into(),
+        );
+        context.native_completion = Some(Arc::clone(&state));
+        let environment = context
+            .step_context
+            .environments
+            .primary()
+            .ok_or_else(|| anyhow::anyhow!("environment"))?;
+        let cmd = format!(
+            "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: {}\n+must not be written\n*** End Patch\nPATCH",
+            target.display()
+        );
+        let input = serde_json::json!({"cmd":cmd,"login":false}).to_string();
+        let prepared =
+            ParsedExecCommand::parse(&input, &session, &context.step_context, environment)?
+                .prepare(ExecCommandLifetime::Interactive)?;
+        assert!(matches!(
+            codex_apply_patch::maybe_parse_apply_patch(&prepared.resolved.command, &prepared.cwd),
+            codex_apply_patch::MaybeApplyPatch::Body(_)
+        ));
+        let error =
+            UnifiedExecProcessManager::ensure_native_completion_backend(&prepared, &context)
+                .err()
+                .ok_or_else(|| anyhow::anyhow!("Native interception must be refused"))?;
+        state.finish(&session);
+        let proof = refusal_header(error, &state)?;
+        assert_eq!(proof["call_id"], "patch-intercept");
+        assert_eq!(proof["outcome"], "pre_backend_rejected");
+        assert!(proof["session_id"].is_null());
+        assert!(!target.exists());
+        let ordinary = UnifiedExecContext::new(
+            Arc::clone(&session),
+            StepContext::for_test(turn),
+            tokio_util::sync::CancellationToken::new(),
+            "ordinary".into(),
+        );
+        assert!(
+            UnifiedExecProcessManager::ensure_native_completion_backend(&prepared, &ordinary)
+                .is_ok()
+        );
+        assert!(
+            !target.exists(),
+            "admission checks themselves perform no file edit"
+        );
+        Ok(())
+    }
+}
