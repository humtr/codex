@@ -0,0 +1,887 @@
+//! Completion facts produced by Native, never inferred from command text.
+//! The state belongs to the existing ToolCallState and survives its joined abort.
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use crate::tools::registry::AnyToolResult;
+use codex_hooks::Hooks;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseInputItem;
+use codex_protocol::protocol::NativeCompletionHooks;
+use codex_protocol::protocol::NativeCompletionOutcome;
+use codex_protocol::protocol::NativeCompletionSchema;
+use codex_protocol::protocol::NativeEffectCompletion;
+use codex_tools::FunctionCallError;
+use codex_tools::ToolName;
+use codex_tools::ToolOutput;
+use codex_tools::ToolPayload;
+use serde_json::Value;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use tokio::sync::watch;
+
+fn hooks_free(hooks: &Hooks, tool: &str) -> bool {
+    crate::native_execution::tool_has_no_hook_effects(hooks, tool)
+}
+
+const HEADER: &str = "Native completion: ";
+
+struct Origin {
+    tool: &'static str,
+    call_id: String,
+    hooks: Arc<Hooks>,
+}
+
+pub(crate) struct CallCompletion {
+    origin: OnceLock<Origin>,
+    dispatch_hooks: OnceLock<Arc<Hooks>>,
+    refused_before_hooks: AtomicBool,
+    call_id: OnceLock<String>,
+    exec_session: OnceLock<i32>,
+    running_session: OnceLock<i32>,
+    attempts: Mutex<Vec<Option<Result<Option<i32>, ()>>>>,
+    rejected: AtomicBool,
+    waited: Mutex<Option<(i32, Option<i32>)>>,
+    finished: watch::Sender<Option<bool>>,
+}
+
+impl Default for CallCompletion {
+    fn default() -> Self {
+        Self {
+            origin: OnceLock::new(),
+            dispatch_hooks: OnceLock::new(),
+            refused_before_hooks: AtomicBool::new(false),
+            call_id: OnceLock::new(),
+            exec_session: OnceLock::new(),
+            running_session: OnceLock::new(),
+            attempts: Mutex::new(Vec::new()),
+            rejected: AtomicBool::new(false),
+            waited: Mutex::new(None),
+            finished: watch::channel(None).0,
+        }
+    }
+}
+
+impl CallCompletion {
+    pub(crate) fn capture(
+        &self,
+        session: &Session,
+        step: &StepContext,
+        call_id: &str,
+        tool: &ToolName,
+    ) {
+        if !tool.is_default_namespace()
+            || !matches!(tool.name.as_str(), "exec_command" | "write_stdin")
+        {
+            return;
+        }
+        // Null distinguishes a new unconfirmed result from a legacy Runtime
+        // that predates typed evidence; consumers must not downgrade to text.
+        let _ = self.call_id.set(call_id.to_owned());
+        if call_id.is_empty()
+            || call_id.len() > 256
+            || step.environments.turn_environments().count() != 1
+            || !step.executor_hook_sources.is_empty()
+        {
+            return;
+        }
+        let Some(environment) = step.environments.primary() else {
+            return;
+        };
+        if environment.environment.is_remote() || !environment.config().environment_hooks.is_empty()
+        {
+            return;
+        }
+        let hooks = step
+            .native_hooks
+            .advertised_hooks()
+            .cloned()
+            .unwrap_or_else(|| session.hooks());
+        let actual_tool = match tool.name.as_str() {
+            "exec_command" => "exec_command",
+            "write_stdin" => "write_stdin",
+            _ => return,
+        };
+        if hooks_free(&hooks, actual_tool) {
+            let _ = self.origin.set(Origin {
+                tool: actual_tool,
+                call_id: call_id.to_owned(),
+                hooks,
+            });
+        }
+    }
+
+    pub(crate) fn bind_dispatch_hooks(&self, hooks: Arc<Hooks>) {
+        let _ = self.dispatch_hooks.set(hooks);
+    }
+
+    /// The registry is still before every hook/backend effect. A stale snapshot
+    /// refusal is positive no-dispatch evidence even if the new policy has hooks.
+    pub(crate) fn refuse_before_hooks(&self) {
+        if self
+            .call_id
+            .get()
+            .is_some_and(|id| !id.is_empty() && id.len() <= 256)
+            && self
+                .attempts
+                .lock()
+                .is_ok_and(|attempts| attempts.is_empty())
+            && self.waited.lock().is_ok_and(|waited| waited.is_none())
+            && self.running_session.get().is_none()
+        {
+            self.refused_before_hooks.store(true, Ordering::Release);
+        }
+    }
+
+    pub(crate) fn is_admitted(&self) -> bool {
+        self.origin.get().is_some()
+    }
+
+    pub(crate) fn bind_exec_session(&self, session_id: i32) {
+        if session_id >= 0 {
+            let _ = self.exec_session.set(session_id);
+        }
+    }
+
+    pub(crate) fn observed_running(&self, session_id: i32) {
+        if session_id >= 0
+            && self
+                .origin
+                .get()
+                .is_some_and(|origin| origin.tool == "write_stdin")
+        {
+            let _ = self.running_session.set(session_id);
+        }
+    }
+
+    pub(crate) fn begin_attempt(self: &Arc<Self>) -> Option<NativeAttempt> {
+        let mut attempts = self.attempts.lock().ok()?;
+        let index = attempts.len();
+        attempts.push(None);
+        Some(NativeAttempt {
+            state: Arc::clone(self),
+            index,
+        })
+    }
+
+    pub(crate) fn initial_rejection(&self) {
+        if self
+            .attempts
+            .lock()
+            .is_ok_and(|attempts| attempts.is_empty())
+        {
+            self.rejected.store(true, Ordering::Release);
+        }
+    }
+
+    pub(crate) fn attempts_confirmed(&self) -> bool {
+        self.attempts.lock().is_ok_and(|attempts| {
+            !attempts.is_empty()
+                && attempts
+                    .iter()
+                    .all(|attempt| matches!(attempt, Some(Ok(_))))
+        })
+    }
+
+    pub(crate) async fn wait_for_attempts(&self) -> bool {
+        let mut changed = self.finished.subscribe();
+        loop {
+            changed.borrow_and_update();
+            let state = self.attempts.lock().ok().map(|attempts| {
+                if attempts
+                    .iter()
+                    .any(|attempt| matches!(attempt, Some(Err(()))))
+                    || attempts.is_empty()
+                {
+                    Some(false)
+                } else if attempts
+                    .iter()
+                    .all(|attempt| matches!(attempt, Some(Ok(_))))
+                {
+                    Some(true)
+                } else {
+                    None
+                }
+            });
+            match state {
+                Some(Some(done)) => return done,
+                None => return false,
+                Some(None) => {}
+            }
+            if changed.changed().await.is_err() {
+                return false;
+            }
+        }
+    }
+
+    pub(crate) fn observed_wait(&self, session_id: i32, actual_exit_code: Option<i32>) {
+        if session_id >= 0
+            && let Ok(mut waited) = self.waited.lock()
+        {
+            *waited = Some((session_id, actual_exit_code));
+        }
+    }
+
+    pub(crate) fn finish(&self, session: &Session) {
+        // Native's admitted Arc is the actual dispatcher, even if configuration
+        // reloads during this call. Other routes retain their previous identity
+        // check. Dynamic environment/executor overlays were excluded at capture.
+        let valid = self.refused_before_hooks.load(Ordering::Acquire)
+            || self.origin.get().is_some_and(|origin| {
+                if let Some(admitted) = self.dispatch_hooks.get() {
+                    // Admission already checked this tool's immutable engine and
+                    // then pinned every actual dispatcher to it. Unrelated async
+                    // work started later shares the runtime tracker, but did not
+                    // become a hook of this invocation and cannot erase its wait.
+                    Arc::ptr_eq(&origin.hooks, admitted)
+                } else {
+                    Arc::ptr_eq(&origin.hooks, &session.hooks())
+                        && hooks_free(&origin.hooks, origin.tool)
+                }
+            });
+        self.finished.send_replace(Some(valid));
+    }
+
+    pub(crate) fn hook_free_finished(&self) -> bool {
+        *self.finished.borrow() == Some(true)
+    }
+
+    pub(crate) async fn wait_for_finish(&self) -> bool {
+        let mut finished = self.finished.subscribe();
+        loop {
+            if let Some(valid) = *finished.borrow_and_update() {
+                return valid;
+            }
+            if finished.changed().await.is_err() {
+                return false;
+            }
+        }
+    }
+
+    fn make(
+        &self,
+        outcome: NativeCompletionOutcome,
+        session_id: Option<i32>,
+        exit_code: Option<i32>,
+    ) -> Option<NativeEffectCompletion> {
+        if !self.hook_free_finished() {
+            return None;
+        }
+        Some(NativeEffectCompletion {
+            schema: NativeCompletionSchema::V1,
+            call_id: self.origin.get()?.call_id.clone(),
+            session_id,
+            outcome,
+            exit_code,
+            hooks: NativeCompletionHooks::Absent,
+        })
+    }
+
+    pub(crate) fn wait_proof(
+        &self,
+        session_id: i32,
+        actual_exit_code: Option<i32>,
+    ) -> Option<NativeEffectCompletion> {
+        self.make(
+            NativeCompletionOutcome::WaitCompleted,
+            Some(session_id),
+            actual_exit_code,
+        )
+    }
+
+    fn proof(&self) -> Option<NativeEffectCompletion> {
+        if self.refused_before_hooks.load(Ordering::Acquire) && self.hook_free_finished() {
+            return Some(NativeEffectCompletion {
+                schema: NativeCompletionSchema::V1,
+                call_id: self.call_id.get()?.clone(),
+                session_id: None,
+                outcome: NativeCompletionOutcome::PreBackendRejected,
+                exit_code: None,
+                hooks: NativeCompletionHooks::Absent,
+            });
+        }
+        let waited = *self.waited.lock().ok()?;
+        let attempts = self.attempts.lock().ok()?;
+        if !attempts.is_empty() {
+            if !attempts
+                .iter()
+                .all(|attempt| matches!(attempt, Some(Ok(_))))
+            {
+                return None;
+            }
+            let code = attempts.last()?.as_ref()?.as_ref().ok().copied()?;
+            let session_id = *self.exec_session.get()?;
+            if waited.is_some_and(|observed| observed != (session_id, code)) {
+                return None;
+            }
+            // A completed sandbox attempt can return an error before a managed
+            // process is bound (including a subsequently declined retry). Its
+            // actual last wait still settles the original execution, never as
+            // a fabricated pre-backend rejection.
+            return self.wait_proof(session_id, code);
+        }
+        if let Some((session_id, code)) = waited {
+            return self.wait_proof(session_id, code);
+        }
+        if self.rejected.load(Ordering::Acquire) {
+            return self.make(NativeCompletionOutcome::PreBackendRejected, None, None);
+        }
+        if let Some(session_id) = self.running_session.get() {
+            return self.make(
+                NativeCompletionOutcome::SessionRunning,
+                Some(*session_id),
+                None,
+            );
+        }
+        None
+    }
+}
+
+/// A token is tied to one backend attempt, including retries that reuse the
+/// public process session number. A late first wait cannot complete another.
+#[derive(Clone)]
+pub(crate) struct NativeAttempt {
+    state: Arc<CallCompletion>,
+    index: usize,
+}
+impl NativeAttempt {
+    pub(crate) fn observe(&self, code: Option<Option<i32>>) {
+        if let Ok(mut attempts) = self.state.attempts.lock()
+            && let Some(attempt) = attempts.get_mut(self.index)
+        {
+            let observed = code.ok_or(());
+            match attempt {
+                None => *attempt = Some(observed),
+                Some(previous) if *previous == observed => {}
+                Some(_) => *attempt = Some(Err(())),
+            }
+        }
+        self.state.finished.send_modify(|_| {});
+    }
+}
+
+/// A cancelled producer must not leave the original exit watcher waiting for a
+/// finalization that can no longer arrive. Dropping is never positive evidence.
+pub(crate) struct FinishGuard(pub(crate) Arc<CallCompletion>);
+impl Drop for FinishGuard {
+    fn drop(&mut self) {
+        self.0.finished.send_if_modified(|finished| {
+            if finished.is_none() {
+                *finished = Some(false);
+                true
+            } else {
+                false
+            }
+        });
+    }
+}
+
+fn header(proof: &Option<NativeEffectCompletion>) -> String {
+    format!(
+        "{HEADER}{}\n",
+        serde_json::to_string(proof).expect("typed Native completion serializes")
+    )
+}
+
+/// Decorate only after the original handler, error hooks and joined cancellation.
+/// Errors remain errors; child output and the original public exit code are intact.
+pub(crate) fn decorate(
+    result: Result<AnyToolResult, FunctionCallError>,
+    state: &CallCompletion,
+) -> Result<AnyToolResult, FunctionCallError> {
+    let Some(call_id) = state.call_id.get() else {
+        return result;
+    };
+    let proof = state.proof();
+    match result {
+        Ok(mut result) => {
+            result.result = Box::new(CompletionOutput {
+                original: result.result,
+                call_id: call_id.clone(),
+                proof,
+            });
+            Ok(result)
+        }
+        Err(FunctionCallError::RespondToModel(message)) => Err(FunctionCallError::RespondToModel(
+            format!("{}Output:\n{message}", header(&proof)),
+        )),
+        other => other,
+    }
+}
+
+struct CompletionOutput {
+    original: Box<dyn ToolOutput>,
+    call_id: String,
+    proof: Option<NativeEffectCompletion>,
+}
+
+impl ToolOutput for CompletionOutput {
+    fn log_output(&self) -> String {
+        self.original.log_output()
+    }
+    fn success_for_logging(&self) -> bool {
+        self.original.success_for_logging()
+    }
+    fn set_handler_duration_ms(&mut self, duration: u64) {
+        self.original.set_handler_duration_ms(duration);
+    }
+    fn post_tool_use_id(&self, call_id: &str) -> String {
+        self.original.post_tool_use_id(call_id)
+    }
+    fn post_tool_use_cwd(&self) -> Option<codex_utils_path_uri::PathUri> {
+        self.original.post_tool_use_cwd()
+    }
+    fn post_tool_use_input(&self, payload: &ToolPayload) -> Option<Value> {
+        self.original.post_tool_use_input(payload)
+    }
+    fn post_tool_use_response(&self, call_id: &str, payload: &ToolPayload) -> Option<Value> {
+        self.original.post_tool_use_response(call_id, payload)
+    }
+    fn contains_external_context(&self) -> bool {
+        self.original.contains_external_context()
+    }
+    fn fallback_token_limit_override(&self) -> Option<usize> {
+        self.original.fallback_token_limit_override()
+    }
+    fn tool_result_metadata(&self) -> Option<&Value> {
+        self.original.tool_result_metadata()
+    }
+    fn to_response_item(&self, call_id: &str, payload: &ToolPayload) -> ResponseInputItem {
+        let mut result = self.original.to_response_item(call_id, payload);
+        if call_id != self.call_id {
+            return result;
+        }
+        let output = match &mut result {
+            ResponseInputItem::FunctionCallOutput { output, .. }
+            | ResponseInputItem::CustomToolCallOutput { output, .. } => output,
+            _ => return result,
+        };
+        match &mut output.body {
+            FunctionCallOutputBody::Text(text) => {
+                text.insert_str(0, &header(&self.proof));
+            }
+            FunctionCallOutputBody::ContentItems(items) => {
+                if let Some(FunctionCallOutputContentItem::InputText { text }) = items.first_mut() {
+                    text.insert_str(0, &header(&self.proof));
+                } else {
+                    items.insert(
+                        0,
+                        FunctionCallOutputContentItem::InputText {
+                            text: header(&self.proof),
+                        },
+                    );
+                }
+            }
+        }
+        result
+    }
+    fn code_mode_result(&self, payload: &ToolPayload) -> Value {
+        let mut result = self.original.code_mode_result(payload);
+        match &mut result {
+            Value::Object(object) => {
+                object.insert(
+                    "native_completion".to_owned(),
+                    serde_json::to_value(&self.proof).expect("typed Native completion serializes"),
+                );
+            }
+            Value::String(text) => text.insert_str(0, &header(&self.proof)),
+            _ => {}
+        }
+        result
+    }
+}
