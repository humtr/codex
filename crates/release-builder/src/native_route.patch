+    #[test]
+    fn native_completion_late_receipt_does_not_duplicate_or_rewrite_public_history()
+    -> anyhow::Result<()> {
+        use codex_protocol::items::ModelInvocationContext;
+        use codex_protocol::protocol::HasLegacyEvent;
+        use codex_protocol::protocol::NativeCompletionHooks;
+        use codex_protocol::protocol::NativeCompletionOutcome;
+        use codex_protocol::protocol::NativeCompletionSchema;
+        use codex_protocol::protocol::NativeEffectCompletion;
+        let canonical = EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id: ThreadId::new(),
+            turn_id: "turn-original".into(),
+            item: CoreTurnItem::CommandExecution(CoreCommandExecutionItem {
+                model_context: Some(ModelInvocationContext {
+                    model_slug: "saved-model".into(),
+                    reasoning_effort: Some("high".into()),
+                }),
+                sandbox_type: Some(codex_protocol::sandbox::SandboxType::None),
+                id: "exec-original".into(),
+                plugin_id: None,
+                script_path: None,
+                process_id: Some("71".into()),
+                command: vec!["owned-command".into()],
+                cwd: test_path_buf("/tmp").abs().into(),
+                parsed_cmd: Vec::new(),
+                source: ExecCommandSource::UnifiedExecStartup,
+                interaction_input: None,
+                status: CoreCommandExecutionStatus::Failed,
+                aggregated_output: Some("original timeout output".into()),
+                exit_code: Some(124),
+                duration: Some(Duration::from_millis(9)),
+            }),
+            started_at_ms: Some(1),
+            completed_at_ms: 123,
+        });
+        let mut original = canonical
+            .as_legacy_events(false)
+            .into_iter()
+            .find_map(|event| match event {
+                EventMsg::ExecCommandEnd(end) => Some(end),
+                _ => None,
+            })
+            .ok_or_else(|| anyhow::anyhow!("original compatibility event"))?;
+        original.native_completion = Some(None);
+        let mut late = original.clone();
+        late.native_completion = Some(Some(NativeEffectCompletion {
+            schema: NativeCompletionSchema::V1,
+            call_id: late.call_id.clone(),
+            session_id: Some(71),
+            outcome: NativeCompletionOutcome::WaitCompleted,
+            exit_code: Some(137),
+            hooks: NativeCompletionHooks::Absent,
+        }));
+        let baseline = vec![
+            RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+                turn_attribution: None,
+                turn_id: "turn-original".into(),
+                root_turn_id: None,
+                trace_id: None,
+                started_at: None,
+                model_context_window: None,
+                collaboration_mode_kind: Default::default(),
+            })),
+            RolloutItem::EventMsg(canonical),
+        ];
+        let mut augmented = baseline.clone();
+        augmented.push(RolloutItem::EventMsg(EventMsg::ExecCommandEnd(original)));
+        augmented.push(RolloutItem::EventMsg(EventMsg::ExecCommandEnd(late)));
+        for mode in [ThreadHistoryMode::Legacy, ThreadHistoryMode::Paginated] {
+            let replay = |rows: &[RolloutItem]| {
+                let mut builder = ThreadHistoryBuilder::new();
+                for row in rows {
+                    if let RolloutItem::EventMsg(event) = row {
+                        builder.handle_event_for_history_mode(event, mode);
+                    }
+                }
+                builder.finish()
+            };
+            let live = replay(&baseline);
+            assert_eq!(live.len(), 1);
+            assert_eq!(live[0].item_payloads().count(), 1);
+            let Some(ThreadItemPayload::CommandExecution {
+                model_context,
+                sandbox_type,
+                exit_code,
+                aggregated_output,
+                ..
+            }) = live[0].item_payloads().next()
+            else {
+                anyhow::bail!("one original public command");
+            };
+            assert!(model_context.is_some());
+            assert!(sandbox_type.is_some());
+            assert_eq!(*exit_code, Some(124));
+            assert_eq!(
+                aggregated_output.as_deref(),
+                Some("original timeout output")
+            );
+            assert_eq!(
+                replay(&augmented),
+                live,
+                "live canonical metadata and times"
+            );
+
+            // These analytics fields are deliberately live-only in upstream.
+            // Compare cold reconstruction to the canonical-only wire baseline,
+            // not to a fabricated serialization of model/sandbox metadata.
+            let cold = |rows: &[RolloutItem]| -> anyhow::Result<Vec<RolloutItem>> {
+                let persisted = codex_rollout::persisted_rollout_items(rows, mode);
+                Ok(serde_json::from_slice(&serde_json::to_vec(&persisted)?)?)
+            };
+            let cold_baseline = cold(&baseline)?;
+            let cold_augmented = cold(&augmented)?;
+            let expected = replay(&cold_baseline);
+            assert_eq!(expected.len(), 1);
+            assert_eq!(expected[0].item_payloads().count(), 1);
+            assert_eq!(replay(&cold_augmented), expected);
+        }
+        Ok(())
+    }
