+    let mut weak_info =
+        create_oss_provider_with_base_url(&format!("{}/v1", weak.uri()), WireApi::Responses);
+    weak_info.name = "chatgpt_desktop".into();
+    let weak_client = test_model_client(SessionSource::Cli)
+        .with_provider("chatgpt_desktop", weak_info)
+        .with_native_provider_route("chatgpt_desktop");
+    let failure = sample(&weak_client).await.unwrap_err();
+    assert!(
+        failure
+            .to_string()
+            .contains("provider_protocol_incompatible")
+    );
+    let captured = weak.received_requests().await.unwrap();
+    assert_eq!(captured.len(), 1);
+    assert_eq!(captured[0].url.path(), "/v1/native/capabilities");
