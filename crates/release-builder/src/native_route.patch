+{
+    async fn sample(client: &ModelClient) -> anyhow::Result<()> {
+        let prompt = Prompt {
+            base_instructions: BaseInstructions {
+                text: String::new(),
+                ..Default::default()
+            },
+            ..Default::default()
+        };
