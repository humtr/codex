+/// Required, per-execution Linux subtree supervision. The pre-thread helper
+/// validates its kernel/procfs capabilities before Ready; the target cannot run
+/// until this caller sends Go. No failure invokes the ordinary direct fallback.
+pub(crate) async fn spawn_guarded(
+    target: &crate::Command,
+    setup: GuardedSetup<'_>,
+) -> Result<GuardedSpawn, GuardedSpawnError> {
+    target.validate().map_err(GuardedSpawnError::before_exec)?;
+    if !is_available() {
+        return Err(GuardedSpawnError::before_exec(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "required process supervision is not registered",
+        )));
+    }
+    let pty_master = match setup {
+        GuardedSetup::Pipe => None,
+        GuardedSetup::Pty { master } => {
+            // An invalid signal probes support without signaling any process.
+            // A non-master or unsupported ioctl must refuse before target exec.
+            let probed = unsafe { libc::ioctl(master.as_raw_fd(), TREE_TIOCSIG as _, 0) };
+            if probed != -1 || io::Error::last_os_error().raw_os_error() != Some(libc::EINVAL) {
+                return Err(GuardedSpawnError::before_exec(io::Error::new(
+                    io::ErrorKind::Unsupported,
+                    "PTY foreground signaling is unavailable",
+                )));
+            }
+            Some(
+                master
+                    .try_clone_to_owned()
+                    .map_err(GuardedSpawnError::before_exec)?,
+            )
+        }
+    };
+    let settings = target.inner.as_std();
+    let prepared = (|| -> io::Result<_> {
+        let mut environment = Vec::new();
+        for (key, value) in settings
+            .get_envs()
+            .filter_map(|(key, value)| value.map(|value| (key, value)))
+        {
+            let mut entry = key.as_bytes().to_vec();
+            entry.push(b'=');
+            entry.extend_from_slice(value.as_bytes());
+            environment.extend_from_slice(CString::new(entry)?.as_bytes_with_nul());
+        }
+        if environment.len() > MAX_ENV_BYTES {
+            return Err(io::Error::from_raw_os_error(libc::E2BIG));
+        }
+        let (control, helper_control) = UnixStream::pair()?;
+        let helper_control = crate::child::posix::child_fd(helper_control.into())?;
+        control.set_nonblocking(true)?;
+        let writer = control.try_clone()?;
+        let control = tokio::net::UnixStream::from_std(control)?;
+        let fd = helper_control.as_raw_fd();
+        let mut helper = crate::Command::new(HELPER_EXE);
+        helper
+            .arg(TREE_HELPER_ARG)
+            .arg(fd.to_string())
+            .arg(std::process::id().to_string())
+            .arg(if pty_master.is_some() { "pty" } else { "pipe" })
+            .arg(
+                target
+                    .inherited_fds
+                    .iter()
+                    .map(ToString::to_string)
+                    .collect::<Vec<_>>()
+                    .join(","),
+            )
+            .arg(settings.get_current_dir().unwrap_or_else(|| Path::new(".")))
+            .arg(settings.get_program())
+            .arg(target.arg0.as_deref().unwrap_or(settings.get_program()))
+            .args(settings.get_args())
+            .drop_policy(ChildDropPolicy::ReapOnly)
+            .stdin(match &target.stdin {
+                crate::ChildStdin::Piped => crate::ChildStdin::Piped,
+                crate::ChildStdin::Null => crate::ChildStdin::Null,
+                crate::ChildStdin::File(fd) => crate::ChildStdin::File(fd.try_clone()?),
+            });
+        helper.stdout_file = target
+            .stdout_file
+            .as_ref()
+            .map(std::os::fd::OwnedFd::try_clone)
+            .transpose()?;
+        helper.stderr_file = target
+            .stderr_file
+            .as_ref()
+            .map(std::os::fd::OwnedFd::try_clone)
+            .transpose()?;
+        helper.inherited_fds = target.inherited_fds.clone();
+        helper.inherited_fds.push(fd);
+        let child = crate::child::posix::NativeChild::spawn(&helper)?.ok_or_else(|| {
+            io::Error::new(io::ErrorKind::Unsupported, "required helper unavailable")
+        })?;
+        drop(helper);
+        drop(helper_control);
+        Ok((control, writer, child, environment))
+    })()
+    .map_err(GuardedSpawnError::before_exec)?;
+    let (mut control, writer, child, environment) = prepared;
+    // Child uses ReapOnly: dropping this future closes the control channel,
+    // causing the helper to stop/reap its target rather than losing the owner.
+    control
+        .write_all(&(environment.len() as u32).to_le_bytes())
+        .await
+        .map_err(GuardedSpawnError::before_exec)?;
+    control
+        .write_all(&environment)
+        .await
+        .map_err(GuardedSpawnError::before_exec)?;
+    let ready = read_tree_frame(&mut control)
+        .await
+        .map_err(GuardedSpawnError::before_exec)?;
+    if let Some(error) = frame_error(ready) {
+        return Err(GuardedSpawnError::before_exec(error));
+    }
+    if ready != (TREE_READY, child.id().unwrap_or(0) as i32) || ready.1 <= 0 {
+        return Err(GuardedSpawnError::before_exec(io::Error::other(
+            "invalid process supervision readiness",
+        )));
+    }
+    // Even a failed write may have delivered Go. Every subsequent unclassified
+    // failure is uncertain; only an explicit pre-exec error narrows that fact.
+    control
+        .write_all(&[TREE_GO])
+        .await
+        .map_err(GuardedSpawnError::uncertain)?;
+    let started = read_tree_frame(&mut control)
+        .await
+        .map_err(GuardedSpawnError::uncertain)?;
+    if let Some(error) = frame_error(started) {
+        return Err(GuardedSpawnError::before_exec(error));
+    }
+    if started.0 != TREE_STARTED || started.1 <= 0 {
+        return Err(GuardedSpawnError::uncertain(io::Error::other(
+            "invalid process supervision start",
+        )));
+    }
+    let (sender, receiver) = tokio::sync::watch::channel(TreeObservation::default());
+    let guard = ProcessTreeGuard {
+        control: std::sync::Arc::new(TreeControl {
+            writer: std::sync::Mutex::new(writer),
+            observation: sender.clone(),
+            #[cfg(test)]
+            target_pid: started.1 as u32,
+            pty_master,
+        }),
+        observation: receiver,
+    };
+    tokio::spawn(read_tree_completion(
+        control,
+        TreeReader {
+            observation: sender,
+            finished: false,
+        },
+    ));
+    Ok(GuardedSpawn { child, guard })
+}
