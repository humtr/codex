+    #[tokio::test]
+    async fn native_completion_admitted_hook_arc_drives_pre_post_and_permission_after_reload()
+    -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let owned = tempfile::tempdir()?;
+        let original = configured_hooks(&session, owned.path(), "old", "unrelated_tool")?;
+        session.services.hooks.store(Arc::clone(&original));
+        let next = configured_hooks(&session, owned.path(), "new", ".*")?;
+        let step = StepContext::for_test(Arc::clone(&turn));
+        step.native_hooks.capture(session.hooks());
+        let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let name = ToolName::plain("apply_patch");
+        let registry =
+            crate::tools::registry::ToolRegistry::from_tools([Arc::new(HookAdmissionProbe {
+                name: name.clone(),
+                calls: Arc::clone(&calls),
+                reload: Some(Arc::clone(&next)),
+                permission: true,
+            })
+                as Arc<dyn crate::tools::registry::CoreToolRuntime>]);
+        registry
+            .dispatch_any_with_state(
+                hook_probe_invocation(&session, Arc::clone(&step), name.clone(), "admitted"),
+                None,
+            )
+            .await?;
+        assert!(
+            !owned.path().join("hook-effects").exists(),
+            "admitted hook-free invocation must not run newly loaded hooks"
+        );
+        assert!(Arc::ptr_eq(&session.hooks(), &next));
+        assert!(
+            step.native_hooks.admitted().is_none(),
+            "call admission must not mutate the shared request"
+        );
+        // A new Native response refuses the now-applicable hooks before any
+        // effects. Ordinary upstream dispatch keeps its live-hook behavior.
+        let fresh = StepContext::for_test(Arc::clone(&turn));
+        fresh.native_hooks.capture(session.hooks());
+        let error = registry
+            .dispatch_any_with_state(
+                hook_probe_invocation(&session, fresh, name.clone(), "fresh"),
+                None,
+            )
+            .await
+            .err()
+            .ok_or_else(|| anyhow::anyhow!("matching hooks must be refused"))?;
+        assert!(
+            error
+                .to_string()
+                .contains("no hook or backend was executed")
+        );
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 1);
+        assert!(!owned.path().join("hook-effects").exists());
+        let ordinary = StepContext::for_test(turn);
+        registry
+            .dispatch_any_with_state(
+                hook_probe_invocation(&session, ordinary, name, "ordinary"),
+                None,
+            )
+            .await?;
+        assert_eq!(calls.load(std::sync::atomic::Ordering::SeqCst), 2);
+        assert_eq!(
+            std::fs::read_to_string(owned.path().join("hook-effects"))?,
+            "new-pre\nnew-permission\nnew-post\n"
+        );
+        Ok(())
+    }
