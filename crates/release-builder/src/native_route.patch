+                    .all(|request| request.method.as_str() == "GET")
+            );
+        }
+        if !explicit_base {
+            assert!(requests.is_empty());
+            continue;
+        }
+        for request in &requests {
+            assert_eq!(request.url.path(), expected);
+        }
+        let (requests, upgrades): (Vec<_>, Vec<_>) = requests
+            .into_iter()
+            .partition(|request| request.method.as_str() == "POST");
+        assert_eq!(requests.len(), 1);
+        assert_eq!(upgrades.len(), super::INITIAL_WEBSOCKET_CONNECTIONS);
+        for upgrade in upgrades {
+            assert_eq!(upgrade.method.as_str(), "GET");
+            assert_eq!(upgrade.headers.get("upgrade").unwrap(), "websocket");
+            assert!(
+                upgrade.headers["connection"]
+                    .to_str()?
+                    .eq_ignore_ascii_case("upgrade")
+            );
+            assert_eq!(upgrade.headers.get("sec-websocket-version").unwrap(), "13");
+            assert!(upgrade.body.is_empty());
+        }
+        assert_eq!(requests[0].url.path(), expected);
+        if expected == "/v1/native/responses" {
+            assert_eq!(requests[0].headers["x-codex-native-protocol"], "4");
+            assert_eq!(
+                requests[0].headers["x-codex-native-required-capabilities"],
+                codex_model_provider::NATIVE_REQUIRED_CAPABILITIES_HEADER
+            );
+        }
+        let body: serde_json::Value = serde_json::from_slice(&requests[0].body)?;
+        assert_eq!(body["tool_choice"], "none");
+        assert!(body.get("tools").is_none_or(serde_json::Value::is_null));
+        let metadata = &body["client_metadata"];
+        assert_eq!(metadata["session_id"], source_session_id);
+        assert_eq!(metadata["parent_turn_id"], "native-ingress-turn");
+        assert_eq!(metadata["x-openai-subagent"], "guardian");
+        assert!(metadata.get("termux_native_execution").is_none());
+        let turn_metadata: serde_json::Value = serde_json::from_str(
+            metadata["x-codex-turn-metadata"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("missing Guardian turn metadata"))?,
+        )?;
+        assert_eq!(turn_metadata["session_id"], metadata["session_id"]);
+        assert_eq!(turn_metadata["thread_id"], metadata["thread_id"]);
+        assert_eq!(turn_metadata["turn_id"], metadata["turn_id"]);
+        assert_eq!(turn_metadata["parent_turn_id"], "native-ingress-turn");
+        assert_eq!(
+            turn_metadata["guardian_classifier_source_thread_id"],
+            source_thread_id
+        );
+        assert_eq!(turn_metadata["thread_source"], "guardian_classifier");
+        assert_eq!(turn_metadata["turn_trigger"], "guardian_classifier");
+    }
+    Ok(())
+}
