+            request_id,
+            params: ThreadReadParams {
+                thread_id: thread.clone(),
+                include_turns: false,
+            },
+        })
+        .await?;
+    assert_eq!(current.thread.model_provider, "mock_provider");
+    assert!(received_response_bodies(&first).await?.is_empty());
+    assert!(received_response_bodies(&second).await?.is_empty());
+    // Reconcile a settings operation, rather than replaying any user turn.
+    send_thread_settings_update(
+        &mut client,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.clone(),
+            model_provider: Some("alternate".into()),
+            ..Default::default()
+        },
+    )
+    .await?;
+    drop(client);
+    let mut resumed = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let result: ThreadResumeResponse = resumed
+        .request(|request_id| ClientRequest::ThreadResume {
+            request_id,
+            params: ThreadResumeParams {
+                thread_id: thread.clone(),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(result.thread.id, thread);
+    assert_eq!(result.model_provider, "alternate");
+    assert!(received_response_bodies(&second).await?.is_empty());
+    Ok(())
+}
