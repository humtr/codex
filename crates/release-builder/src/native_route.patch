+//! Real, owned helper fixtures. No user process, terminal, or installation is used.
+
+use std::ffi::OsString;
+use std::fs::File;
+use std::io;
+use std::io::Read;
+use std::io::Write;
+use std::os::fd::AsFd;
+use std::os::fd::AsRawFd;
+use std::os::fd::FromRawFd;
+use std::os::fd::OwnedFd;
+use std::os::unix::ffi::OsStringExt;
+use std::os::unix::process::ExitStatusExt;
+use std::time::Duration;
+
+use pretty_assertions::assert_eq;
+use tokio::io::AsyncBufReadExt;
+
+use super::GuardedSetup;
+use super::GuardedSpawn;
+use super::spawn_guarded;
+
+const TARGET: &str = "--codex-process-tree-test-target";
+const DEADLINE: Duration = Duration::from_secs(5);
+
+fn process_args() -> io::Result<Vec<OsString>> {
+    let bytes = std::fs::read("/proc/self/cmdline")?;
+    Ok(bytes
+        .strip_suffix(&[0])
+        .unwrap_or(&bytes)
+        .split(|byte| *byte == 0)
+        .map(|arg| OsString::from_vec(arg.to_vec()))
+        .collect())
+}
+
+#[ctor::ctor]
+fn initialize_tree_fixture() {
+    let Ok(arguments) = process_args() else {
+        return;
+    };
+    if arguments
+        .get(1)
+        .is_some_and(|arg| arg == super::TREE_HELPER_ARG)
+        && arguments
+            .iter()
+            .any(|arg| arg == "--codex-test-fail-helper-bootstrap")
+    {
+        std::process::exit(127);
+    }
+    crate::init_spawn_helper(arguments.clone());
+    if arguments.get(1).is_some_and(|arg| arg == TARGET) {
+        let status = run_target(&arguments).unwrap_or(125);
+        std::process::exit(status);
+    }
+}
+
+fn wait_child(pid: libc::pid_t) -> io::Result<i32> {
+    loop {
+        let mut status = 0;
+        let waited = unsafe { libc::waitpid(pid, &mut status, 0) };
+        if waited == pid {
+            return Ok(status);
+        }
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::Interrupted {
+            return Err(error);
+        }
+    }
+}
+
+fn wait_cleanup(fd: i32) -> io::Result<()> {
+    // The test owns the only write end. EOF always provides bounded cleanup
+    // even when an assertion fails or the helper is intentionally killed.
+    let mut cleanup = unsafe { File::from_raw_fd(fd) };
+    io::copy(&mut cleanup, &mut io::sink())?;
+    Ok(())
+}
+
+fn report(role: &str) -> io::Result<()> {
+    writeln!(io::stdout(), "{role} {}", std::process::id())?;
+    io::stdout().flush()
+}
+
+/// Runs before the test harness starts any threads, in a separate target image.
+fn run_target(arguments: &[OsString]) -> io::Result<i32> {
+    let mode = arguments
+        .get(2)
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| io::Error::other("missing fixture mode"))?;
+    let cleanup = arguments
+        .get(3)
+        .and_then(|value| value.to_str())
+        .and_then(|value| value.parse::<i32>().ok())
+        .ok_or_else(|| io::Error::other("missing cleanup descriptor"))?;
+    match mode {
+        "touch" => {
+            std::fs::write(
+                arguments
+                    .get(4)
+                    .ok_or_else(|| io::Error::other("missing marker path"))?,
+                b"executed",
+            )?;
+            Ok(0)
+        }
+        "single" => {
+            report("root")?;
+            wait_cleanup(cleanup)?;
+            Ok(0)
+        }
+        "detached" | "detached-fd" | "live" => {
+            if mode == "detached-fd" {
+                let output = arguments
+                    .iter()
+                    .filter_map(|argument| argument.to_str())
+                    .find_map(|argument| argument.strip_prefix("--owned-output-fd="))
+                    .and_then(|fd| fd.parse::<i32>().ok())
+                    .ok_or_else(|| io::Error::other("missing owned output descriptor"))?;
+                if unsafe { libc::fcntl(output, libc::F_GETFD) } == -1 {
+                    return Err(io::Error::other("target descriptor was not inherited"));
+                }
+                unsafe { libc::close(output) };
+            }
+            let child = unsafe { libc::fork() };
+            if child == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            if child == 0 {
+                if unsafe { libc::setsid() } == -1 {
+                    std::process::exit(126);
+                }
+                let grandchild = unsafe { libc::fork() };
+                if grandchild == -1 {
+                    std::process::exit(126);
+                }
+                if grandchild > 0 {
+                    std::process::exit(0);
+                }
+                report("descendant")?;
+                wait_cleanup(cleanup)?;
+                std::process::exit(0);
+            }
+            let status = wait_child(child)?;
+            if !libc::WIFEXITED(status) || libc::WEXITSTATUS(status) != 0 {
+                return Err(io::Error::other("intermediate child failed"));
+            }
+            if mode == "live" {
+                wait_cleanup(cleanup)?;
+            }
+            Ok(7)
+        }
+        "foreground" => {
+            for fd in [0, 1, 2] {
+                if unsafe { libc::isatty(fd) } != 1 {
+                    return Err(io::Error::other("target is not attached to the PTY"));
+                }
+            }
+            let root = unsafe { libc::getpid() };
+            if unsafe { libc::getpgrp() } != root
+                || unsafe { libc::tcgetpgrp(0) } != root
+                || unsafe { libc::getsid(0) } == root
+            {
+                return Err(io::Error::other("target foreground/session setup changed"));
+            }
+            let child = unsafe { libc::fork() };
+            if child == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            if child == 0 {
+                if unsafe { libc::setpgid(0, 0) } == -1 {
+                    std::process::exit(126);
+                }
+                unsafe { libc::signal(libc::SIGTTOU, libc::SIG_IGN) };
+                if unsafe { libc::tcsetpgrp(0, libc::getpid()) } == -1 {
+                    std::process::exit(126);
+                }
+                unsafe { libc::signal(libc::SIGTTOU, libc::SIG_DFL) };
+                report("foreground")?;
+                wait_cleanup(cleanup)?;
+                std::process::exit(126);
+            }
+            let status = wait_child(child)?;
+            if !libc::WIFSIGNALED(status) || libc::WTERMSIG(status) != libc::SIGINT {
+                return Err(io::Error::other("foreground child did not receive SIGINT"));
+            }
+            Ok(0)
+        }
+        _ => Err(io::Error::other("unknown fixture mode")),
+    }
+}
+
+fn target(mode: &str) -> io::Result<(crate::Command, std::io::PipeWriter, OwnedFd)> {
+    let (read, cleanup) = io::pipe()?;
+    let read: OwnedFd = read.into();
+    let mut command = crate::Command::new("/proc/self/exe");
+    command
+        .arg(TARGET)
+        .arg(mode)
+        .arg(read.as_raw_fd().to_string())
+        .arg("--codex-test-tree-parent-scan")
+        .current_dir("/")
+        .stdin(crate::ChildStdin::Null);
+    command.inherit_fds(&[read.as_raw_fd()]);
+    Ok((command, cleanup, read))
+}
+
+async fn read_pid(child: &mut crate::Child, role: &str) -> anyhow::Result<u32> {
+    let stdout = child
+        .stdout
+        .as_mut()
+        .ok_or_else(|| io::Error::other("fixture stdout is missing"))?;
+    let mut line = String::new();
+    tokio::time::timeout(
+        DEADLINE,
+        tokio::io::BufReader::new(stdout).read_line(&mut line),
+    )
+    .await??;
+    let (actual_role, pid) = line
+        .trim()
+        .split_once(' ')
+        .ok_or_else(|| io::Error::other("invalid fixture identity"))?;
+    assert_eq!(actual_role, role);
+    Ok(pid.parse()?)
+}
+
+async fn finish(spawned: &mut GuardedSpawn) -> anyhow::Result<std::process::ExitStatus> {
+    let waited = tokio::time::timeout(DEADLINE, spawned.child.wait()).await?;
+    let actual = waited?;
+    assert!(actual.success(), "supervisor must close successfully");
+    // Private tree frames without this actual wait must remain insufficient.
+    assert!(spawned.guard.confirmed_tree_status().is_none());
+    spawned.guard.observe_helper_wait(Ok(actual));
+    Ok(tokio::time::timeout(DEADLINE, spawned.guard.wait_tree()).await??)
+}
+
+#[tokio::test]
+async fn native_completion_tree_guard_preserves_root_and_reaps_double_fork() -> anyhow::Result<()> {
