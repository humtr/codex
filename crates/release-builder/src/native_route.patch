+#[tokio::test]
+async fn native_completion_tree_guard_closes_target_only_descriptors() -> anyhow::Result<()> {
+    let (mut command, cleanup, attachment) = target("detached-fd")?;
+    let (output_read, output_write) = io::pipe()?;
+    let output_write: OwnedFd = output_write.into();
+    command.arg(format!("--owned-output-fd={}", output_write.as_raw_fd()));
+    command.inherit_fds(&[attachment.as_raw_fd(), output_write.as_raw_fd()]);
+    let mut spawned = spawn_guarded(&command, GuardedSetup::Pipe).await?;
+    drop(output_write);
+    let descendant = read_pid(&mut spawned.child, "descendant").await?;
+    assert_eq!(
+        tokio::time::timeout(DEADLINE, spawned.guard.wait_root())
+            .await??
+            .code(),
+        Some(7)
+    );
+    let mut reader = tokio::task::spawn_blocking(move || {
+        let mut output_read = output_read;
+        let mut bytes = Vec::new();
+        output_read.read_to_end(&mut bytes)?;
+        Ok::<_, io::Error>(bytes)
+    });
+    let observed = tokio::time::timeout(DEADLINE, &mut reader).await;
+    if observed.is_err() {
+        // Preserve the failure while settling only this owned fixture.
+        drop(cleanup);
+        spawned.guard.request_stop()?;
+        let _ = finish(&mut spawned).await?;
+        let _ = reader.await?;
+        panic!("supervisor retained a target-only inherited descriptor");
+    }
+    assert!(observed???.is_empty());
+    assert_eq!(unsafe { libc::kill(descendant as i32, 0) }, 0);
+    assert!(spawned.guard.confirmed_tree_status().is_none());
+    drop(cleanup);
+    assert_eq!(finish(&mut spawned).await?.code(), Some(7));
+    Ok(())
+}
