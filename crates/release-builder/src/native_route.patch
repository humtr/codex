+    #[cfg(unix)]
+    fn configured_hook_events(
+        session: &Session,
+        root: &Path,
+        label: &str,
+        matcher: &str,
+        events: &[&str],
+    ) -> anyhow::Result<Arc<Hooks>> {
+        configured_hook_events_with_mode(session, root, label, matcher, events, false)
+    }
+
+    #[cfg(unix)]
+    fn configured_hook_events_with_mode(
+        session: &Session,
+        root: &Path,
+        label: &str,
+        matcher: &str,
+        events: &[&str],
+        asynchronous: bool,
+    ) -> anyhow::Result<Arc<Hooks>> {
+        let log = root.join("hook-effects");
+        let log = log.to_str().ok_or_else(|| anyhow::anyhow!("test path"))?;
+        anyhow::ensure!(!log.contains('\''), "owned test path is not shell-safe");
+        let group = |event: &str| codex_config::MatcherGroup {
+            matcher: Some(matcher.to_owned()),
+            hooks: vec![codex_config::HookHandlerConfig::Command {
+                command: format!("printf '%s\\n' '{label}-{event}' >> '{log}'"),
+                command_windows: None,
+                timeout_sec: Some(5),
+                r#async: asynchronous,
+                status_message: None,
+                additional_context_limit: None,
+            }],
+        };
+        let plugin_root = codex_config::AbsolutePathBuf::try_from(root.to_path_buf())?;
+        let hooks = session.hooks().reconfigured(codex_hooks::HooksConfig {
+            feature_enabled: true,
+            bypass_hook_trust: true,
+            shell_program: Some(
+                session
+                    .user_shell()
+                    .shell_path
+                    .to_string_lossy()
+                    .into_owned(),
+            ),
+            shell_args: vec!["-c".into()],
+            plugin_hook_sources: vec![codex_plugin::PluginHookSource {
+                plugin_id: codex_plugin::PluginId::parse("native-hook-proof@test")?,
+                plugin_root: plugin_root.clone(),
+                plugin_data_root: plugin_root.clone(),
+                source_path: plugin_root.join("hooks.json"),
+                source_relative_path: "hooks.json".into(),
+                hooks: codex_config::HookEventsToml {
+                    pre_tool_use: events
+                        .contains(&"pre")
+                        .then(|| vec![group("pre")])
+                        .unwrap_or_default(),
+                    post_tool_use: events
+                        .contains(&"post")
+                        .then(|| vec![group("post")])
+                        .unwrap_or_default(),
+                    permission_request: events
+                        .contains(&"permission")
+                        .then(|| vec![group("permission")])
+                        .unwrap_or_default(),
+                    ..Default::default()
+                },
+            }],
+            ..Default::default()
+        });
+        Ok(Arc::new(hooks))
+    }
