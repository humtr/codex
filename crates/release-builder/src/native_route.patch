+        changed.finish(&session);
+        assert!(
+            changed.proof().is_none(),
+            "changed hook state stays unknown"
+        );
+        let (session, unresolved) = admitted("unresolved-poll", "write_stdin").await;
+        unresolved.observed_running(-1);
+        unresolved.finish(&session);
+        assert!(unresolved.proof().is_none(), "no resolved local session");
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn native_completion_dropped_dispatch_does_not_publish_late_wait() {
+        let (session, state) = admitted("dropped", "exec_command").await;
+        let guard = FinishGuard(Arc::clone(&state));
+        drop(guard);
+        assert!(!state.wait_for_finish().await);
+        state.observed_wait(71, Some(0));
+        assert!(state.proof().is_none());
+        drop(session);
+    }
+
+    #[tokio::test]
+    async fn native_completion_new_unknown_result_has_explicit_null_capability()
+    -> anyhow::Result<()> {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let step = StepContext::for_test(Arc::new(turn));
+        for call_id in [String::new(), "x".repeat(257)] {
+            let state = CallCompletion::default();
+            state.capture(&session, &step, &call_id, &ToolName::plain("exec_command"));
+            assert_eq!(state.call_id.get(), Some(&call_id));
+            assert!(state.origin.get().is_none());
+            assert!(state.proof().is_none());
+        }
+        let wrapped = CompletionOutput {
+            original: Box::new(codex_tools::JsonToolOutput::new(
+                serde_json::json!({"exit_code":0,"output":"child"}),
+            )),
+            call_id: "unknown".into(),
+            proof: None,
+        };
+        let payload = ToolPayload::Function {
+            arguments: "{}".into(),
+        };
+        let value = wrapped.code_mode_result(&payload);
+        assert!(value.get("native_completion").is_some_and(Value::is_null));
+        assert_eq!(value["exit_code"], 0);
+        let string_output = CompletionOutput {
+            original: Box::new(codex_tools::JsonToolOutput::new(serde_json::json!(
+                "Process exited with code 0\nOutput:\nchild"
+            ))),
+            call_id: "unknown".into(),
+            proof: None,
+        };
+        assert!(
+            string_output
+                .code_mode_result(&payload)
+                .as_str()
+                .is_some_and(|text| text.starts_with("Native completion: null\n"))
+        );
+        let ResponseInputItem::FunctionCallOutput { output, .. } =
+            wrapped.to_response_item("unknown", &payload)
+        else {
+            anyhow::bail!("function output");
+        };
+        assert!(
+            output
+                .body
+                .to_text()
+                .ok_or_else(|| anyhow::anyhow!("text output"))?
+                .starts_with("Native completion: null\n")
+        );
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn native_completion_admitted_snapshot_preserves_wait_after_later_hook_reload()
+    -> anyhow::Result<()> {
+        let (session, state) = admitted("admitted-wait", "exec_command").await;
+        state.bind_dispatch_hooks(session.hooks());
+        state.bind_exec_session(71);
+        let attempt = state
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("attempt"))?;
+        session
+            .services
+            .hooks
+            .store(Arc::new((*session.hooks()).clone()));
+        let unrelated = Arc::new(tokio::sync::Notify::new());
+        let pending = Arc::clone(&unrelated);
+        session
+            .hooks()
+            .schedule_async_task(async move { pending.notified().await });
+        let original = state
+            .origin
+            .get()
+            .ok_or_else(|| anyhow::anyhow!("origin"))?;
+        assert!(
+            !hooks_free(&original.hooks, original.tool),
+            "shared async state must actually be pending"
+        );
+        attempt.observe(Some(Some(7)));
+        state.observed_wait(71, Some(7));
+        state.finish(&session);
+        let proof = state
+            .proof()
+            .ok_or_else(|| anyhow::anyhow!("actual admitted engine remains valid"))?;
+        assert_eq!(proof.call_id, "admitted-wait");
+        assert_eq!(proof.outcome, NativeCompletionOutcome::WaitCompleted);
+        assert_eq!(proof.exit_code, Some(7));
+        unrelated.notify_one();
+        session.hooks().shutdown().await;
+        Ok(())
+    }
+    #[tokio::test]
+    async fn native_completion_successful_wait_without_numeric_exit_is_terminal()
+    -> anyhow::Result<()> {
+        let (session, state) = admitted("signal-wait", "exec_command").await;
+        state.bind_exec_session(71);
+        let attempt = state
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("attempt"))?;
+        attempt.observe(Some(None));
+        state.observed_wait(71, None);
+        state.finish(&session);
+        let proof = state
+            .proof()
+            .ok_or_else(|| anyhow::anyhow!("actual wait was observed"))?;
+        assert_eq!(proof.outcome, NativeCompletionOutcome::WaitCompleted);
+        assert_eq!(proof.session_id, Some(71));
+        assert_eq!(proof.exit_code, None);
+        let value = serde_json::to_value(proof)?;
+        assert!(value["exit_code"].is_null());
+        assert_eq!(value["outcome"], "wait_completed");
+        let (session, unknown) = admitted("no-wait", "exec_command").await;
+        unknown.bind_exec_session(72);
+        unknown
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("attempt"))?
+            .observe(None);
+        unknown.finish(&session);
+        assert!(
+            unknown.proof().is_none(),
+            "wait error is not a numeric-unknown successful wait"
+        );
+        Ok(())
+    }
+}
