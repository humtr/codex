+/// Cancellation of the reader must not leave a successful-looking observation.
+struct TreeReader {
+    observation: tokio::sync::watch::Sender<TreeObservation>,
+    finished: bool,
+}
+
+impl Drop for TreeReader {
+    fn drop(&mut self) {
+        if !self.finished {
+            self.observation
+                .send_modify(|observation| observation.failed = true);
+        }
+    }
+}
+
+async fn read_tree_completion(mut control: tokio::net::UnixStream, mut reader: TreeReader) {
+    let result = async {
+        let (kind, root_status) = read_tree_frame(&mut control).await?;
+        if kind != TREE_ROOT_EXIT
+            || !(0..=0xffff).contains(&root_status)
+            || !(libc::WIFEXITED(root_status) || libc::WIFSIGNALED(root_status))
+        {
+            return Err(io::Error::other("invalid original process wait frame"));
+        }
+        reader.observation.send_modify(|observation| {
+            observation.root_status = Some(root_status);
+        });
+        if read_tree_frame(&mut control).await? != (TREE_COMPLETE, root_status) {
+            return Err(io::Error::other("invalid process tree completion frame"));
+        }
+        let mut trailing = [0; 1];
+        if control.read(&mut trailing).await? != 0 {
+            return Err(io::Error::other("trailing process supervision frame"));
+        }
+        Ok::<_, io::Error>(())
+    }
+    .await;
+    reader.observation.send_modify(|observation| {
+        if result.is_ok() {
+            observation.complete_frame = true;
+        } else {
+            observation.failed = true;
+        }
+    });
+    reader.finished = true;
+}
