+//! Native execution compatibility is negotiated against the authenticated,
+//! *running* local Provider, not inferred from selected package versions,
+//! account names, model labels or an HTTP 404 after inference began.
+//!
+//! Major versions change only when execution or completion semantics change;
+//! additive features use capabilities without a new `/native-vN` URL.
+use codex_api::Provider;
+use codex_api::SharedAuthProvider;
+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClientFactory;
+use codex_login::default_client::ClientRedirectPolicy;
+use codex_login::default_client::create_client_for_route;
+use serde_json::Value;
+use std::time::Duration;
+
+pub const NATIVE_PROTOCOL_MAJOR: u64 = 4;
+pub const NATIVE_REQUIRED_CAPABILITIES: &[&str] = &[
+    "tool_call_ids_v1",
+    "tool_result_binding_v1",
+    "native_turn_admission_v4",
+];
+pub const NATIVE_REQUIRED_CAPABILITIES_HEADER: &str =
+    "tool_call_ids_v1,tool_result_binding_v1,native_turn_admission_v4";
+
+fn incompatible(reason: &str) -> String {
+    format!("provider_protocol_incompatible: {reason}")
+}
+
+fn verify_contract(data: &[u8], websocket_required: bool) -> Result<(), String> {
+    let value: Value =
+        serde_json::from_slice(data).map_err(|_| incompatible("invalid capability descriptor"))?;
+    if value["schema"] != "codex-native-compatibility-v1"
+        || value["protocol_major"] != NATIVE_PROTOCOL_MAJOR
+        || !value["protocol_minor"].is_u64()
+        || value["stable_ingress"] != "/v1/native/responses"
+        || !value["transports"]
+            .as_array()
+            .is_some_and(|transports| transports.iter().any(|v| v == "http_sse"))
+        || value["capabilities"].as_array().is_none_or(|capabilities| {
+            !NATIVE_REQUIRED_CAPABILITIES.iter().all(|required| {
+                capabilities
+                    .iter()
+                    .any(|item| item.as_str() == Some(*required))
+            })
+        })
+    {
+        return Err(incompatible(
+            "mandatory major/version/capabilities unavailable",
+        ));
+    }
+    if websocket_required
+        && !value["transports"]
+            .as_array()
+            .is_some_and(|transports| transports.iter().any(|v| v == "websocket_responses"))
+    {
+        return Err(incompatible("WebSocket transport not advertised"));
+    }
+    Ok(())
+}
+
+/// No inference, tool effect, automatic downgrade or retry can occur before
+/// this bounded GET succeeds. Authentication is the same scoped provider auth
+/// as the subsequent Responses request, and redirects are disallowed.
+pub async fn verify_running_native_provider(
+    provider: &Provider,
+    auth: &SharedAuthProvider,
+    factory: &HttpClientFactory,
+    websocket_required: bool,
+) -> Result<(), String> {
+    let url = url::Url::parse(&provider.base_url)
+        .map_err(|_| incompatible("invalid running service base URL"))?;
+    if url.scheme() != "http"
+        || url.host_str() != Some("127.0.0.1")
+        || url.path().trim_end_matches('/') != "/v1"
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || provider
+            .query_params
+            .as_ref()
+            .is_some_and(|params| !params.is_empty())
+    {
+        return Err(incompatible(
+            "service must be an exact loopback Provider endpoint",
+        ));
+    }
+    let target = provider.url_for_path("/native/capabilities");
+    let headers = auth
+        .apply_auth_headers(provider.headers.clone())
+        .await
+        .map_err(|_| "provider_auth_unavailable: capability credentials unavailable".to_string())?;
+    let client = create_client_for_route(
+        factory,
+        &target,
+        ClientRouteClass::Api,
+        ClientRedirectPolicy::Reject,
+    )
+    .map_err(|_| incompatible("capability transport unavailable"))?;
+    let data = tokio::time::timeout(Duration::from_secs(8), async move {
+        let mut response = client
+            .get(target)
+            .headers(headers)
+            .timeout(Duration::from_secs(5))
+            .send()
+            .await
+            .map_err(|_| incompatible("capability read failed before inference"))?;
+        match response.status().as_u16() {
+            200 => (),
+            401 | 403 => {
+                return Err(
+                    "provider_auth_unavailable: active service rejected credentials".to_string(),
+                );
+            }
+            404 => return Err(incompatible("active service has no capability endpoint")),
+            _ => return Err(incompatible("active service failed capability negotiation")),
+        }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response
+            .chunk()
+            .await
+            .map_err(|_| incompatible("capability response truncated"))?
+        {
+            if chunk.len() > 4096 - bytes.len() {
+                return Err(incompatible("capability descriptor exceeded bound"));
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        Ok(bytes)
+    })
+    .await
+    .map_err(|_| incompatible("capability read timed out before inference"))??;
+    verify_contract(&data, websocket_required)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn report() -> Value {
+        serde_json::json!({
+            "schema":"codex-native-compatibility-v1",
+            "protocol_major":4,"protocol_minor":6,
+            "stable_ingress":"/v1/native/responses",
+            "legacy_ingress":"/v1/native-v4/responses",
+            "transports":["http_sse"],
+            "capabilities":["tool_call_ids_v1","tool_result_binding_v1", "native_turn_admission_v4", "responses_sse_v1", "future_optional_v9"]
+        })
+    }
+    #[test]
+    fn stable_major_and_additive_minor_are_accepted_but_required_capabilities_are_exact() {
+        let ok = report();
+        assert!(verify_contract(ok.to_string().as_bytes(), false).is_ok());
+        assert!(verify_contract(ok.to_string().as_bytes(), true).is_err());
+        for (key, altered) in [
+            ("protocol_major", serde_json::json!(5)),
+            ("stable_ingress", serde_json::json!("/v1/responses")),
+            ("capabilities", serde_json::json!(["tool_call_ids_v1"])),
+            ("schema", serde_json::json!("not-native")),
+        ] {
+            let mut missing = report();
+            missing[key] = altered;
+            assert!(
+                verify_contract(missing.to_string().as_bytes(), false)
+                    .unwrap_err()
+                    .contains("provider_protocol_incompatible")
+            );
+        }
+        let mut ws = report();
+        ws["transports"] = serde_json::json!(["http_sse", "websocket_responses"]);
+        assert!(verify_contract(ws.to_string().as_bytes(), true).is_ok());
+    }
+}
