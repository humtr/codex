+    #[cfg(unix)]
+    #[tokio::test]
+    async fn native_completion_intercepted_patch_refuses_before_file_effects() -> anyhow::Result<()>
+    {
+        use crate::tools::handlers::unified_exec::preparation::ExecCommandLifetime;
+        use crate::tools::handlers::unified_exec::preparation::ParsedExecCommand;
+        use crate::unified_exec::UnifiedExecContext;
+        use crate::unified_exec::UnifiedExecProcessManager;
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let owned = tempfile::tempdir()?;
+        let target = owned.path().join("must-not-exist");
+        let step = StepContext::for_test(Arc::clone(&turn));
+        step.native_hooks.capture(session.hooks());
+        let mut invocation = hook_probe_invocation(
+            &session,
+            step,
+            ToolName::plain("exec_command"),
+            "patch-intercept",
+        );
+        admit_hook_dispatch(&mut invocation, false)?;
+        let state = invocation
+            .native_completion
+            .clone()
+            .ok_or_else(|| anyhow::anyhow!("completion"))?;
+        let mut context = UnifiedExecContext::new(
+            Arc::clone(&session),
+            invocation.step_context,
+            tokio_util::sync::CancellationToken::new(),
+            "patch-intercept".into(),
+        );
+        context.native_completion = Some(Arc::clone(&state));
+        let environment = context
+            .step_context
+            .environments
+            .primary()
+            .ok_or_else(|| anyhow::anyhow!("environment"))?;
+        let cmd = format!(
+            "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: {}\n+must not be written\n*** End Patch\nPATCH",
+            target.display()
+        );
+        let input = serde_json::json!({"cmd":cmd,"login":false}).to_string();
+        let prepared =
+            ParsedExecCommand::parse(&input, &session, &context.step_context, environment)?
+                .prepare(ExecCommandLifetime::Interactive)?;
+        assert!(matches!(
+            codex_apply_patch::maybe_parse_apply_patch(&prepared.resolved.command, &prepared.cwd),
+            codex_apply_patch::MaybeApplyPatch::Body(_)
+        ));
+        let error =
+            UnifiedExecProcessManager::ensure_native_completion_backend(&prepared, &context)
+                .err()
+                .ok_or_else(|| anyhow::anyhow!("Native interception must be refused"))?;
+        state.finish(&session);
+        let proof = refusal_header(error, &state)?;
+        assert_eq!(proof["call_id"], "patch-intercept");
+        assert_eq!(proof["outcome"], "pre_backend_rejected");
+        assert!(proof["session_id"].is_null());
+        assert!(!target.exists());
+        let ordinary = UnifiedExecContext::new(
+            Arc::clone(&session),
+            StepContext::for_test(turn),
+            tokio_util::sync::CancellationToken::new(),
+            "ordinary".into(),
+        );
+        assert!(
+            UnifiedExecProcessManager::ensure_native_completion_backend(&prepared, &ordinary)
+                .is_ok()
+        );
+        assert!(
+            !target.exists(),
+            "admission checks themselves perform no file edit"
+        );
+        Ok(())
+    }
+}
