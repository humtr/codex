+/// Read only the kernel parent identity. comm may contain spaces, closing
+/// parentheses, or non-UTF8 bytes; none of it is emitted or used as authority.
+fn stat_parent(pid: libc::pid_t) -> io::Result<libc::pid_t> {
+    let file = File::open(format!("/proc/{pid}/stat"))?;
+    let mut bytes = Vec::new();
+    file.take(16 * 1024 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > 16 * 1024 {
+        return Err(io::Error::other("oversized process identity"));
+    }
+    let end = bytes
+        .iter()
+        .rposition(|byte| *byte == b')')
+        .ok_or_else(|| io::Error::other("invalid process identity"))?;
+    let prefix = bytes
+        .iter()
+        .position(|byte| *byte == b' ')
+        .ok_or_else(|| io::Error::other("invalid process identity"))?;
+    let recorded = std::str::from_utf8(&bytes[..prefix])
+        .ok()
+        .and_then(|value| value.parse::<libc::pid_t>().ok());
+    if recorded != Some(pid) || bytes.get(prefix + 1) != Some(&b'(') || end <= prefix {
+        return Err(io::Error::other("changed process identity"));
+    }
+    let mut fields = bytes[end + 1..]
+        .split(u8::is_ascii_whitespace)
+        .filter(|field| !field.is_empty());
+    if fields.next().is_none_or(|state| state.len() != 1) {
+        return Err(io::Error::other("invalid process state"));
+    }
+    fields
+        .next()
+        .and_then(|field| std::str::from_utf8(field).ok())
+        .and_then(|field| field.parse::<libc::pid_t>().ok())
+        .filter(|parent| *parent >= 0)
+        .ok_or_else(|| io::Error::other("invalid process parent"))
+}
+
+fn each_owned_child_scan(visit: &mut impl FnMut(libc::pid_t) -> io::Result<()>) -> io::Result<()> {
+    let owner = std::process::id() as libc::pid_t;
+    for entry in std::fs::read_dir("/proc")? {
+        let entry = entry?;
+        let name = entry.file_name();
+        let Some(pid) = name
+            .to_str()
+            .and_then(|name| name.parse::<libc::pid_t>().ok())
+            .filter(|pid| *pid > 0)
+        else {
+            continue;
+        };
+        if stat_parent(pid).ok() == Some(owner) {
+            // This helper is the only reaper. A verified direct child cannot
+            // have its PID reused between this read and the visitor's signal.
+            visit(pid)?;
+        }
+    }
+    Ok(())
+}
+
+/// Enumerate only this dedicated, single-threaded supervisor's direct children.
+/// Android kernels may omit the CONFIG_CHECKPOINT_RESTORE children file.
+/// A fallback reads numeric proc stat parent identities, never a shared UID
+/// inventory. Scan emptiness is never evidence of tree completion.
+fn each_owned_child(
+    force_parent_scan: bool,
+    mut visit: impl FnMut(libc::pid_t) -> io::Result<()>,
+) -> io::Result<()> {
+    if force_parent_scan {
+        return each_owned_child_scan(&mut visit);
+    }
+    let path = format!("/proc/self/task/{}/children", std::process::id());
+    let file = match File::open(path) {
+        Ok(file) => file,
+        Err(error)
+            if matches!(
+                error.kind(),
+                io::ErrorKind::NotFound | io::ErrorKind::PermissionDenied
+            ) =>
+        {
+            return each_owned_child_scan(&mut visit);
+        }
+        Err(error) => return Err(error),
+    };
+    let mut current: Option<i32> = None;
+    for byte in io::BufReader::new(file).bytes() {
+        let byte = byte?;
+        if byte.is_ascii_whitespace() {
+            if let Some(pid) = current.take() {
+                if pid <= 0 {
+                    return Err(io::Error::other("invalid owned child identity"));
+                }
+                visit(pid)?;
+            }
+        } else if byte.is_ascii_digit() {
+            current = Some(
+                current
+                    .unwrap_or(0)
+                    .checked_mul(10)
+                    .and_then(|value| value.checked_add(i32::from(byte - b'0')))
+                    .ok_or_else(|| io::Error::other("invalid owned child identity"))?,
+            );
+        } else {
+            return Err(io::Error::other("invalid owned child inventory"));
+        }
+    }
+    if let Some(pid) = current {
+        if pid <= 0 {
+            return Err(io::Error::other("invalid owned child identity"));
+        }
+        visit(pid)?;
+    }
+    Ok(())
+}
+
+fn require_tree_capabilities(force_parent_scan: bool) -> io::Result<()> {
+    // Forking is confined to this fresh image, before the application starts.
+    if unsafe { libc::syscall(libc::SYS_gettid) } != std::process::id() as libc::c_long
+        || std::fs::read_dir("/proc/self/task")?
+            .collect::<io::Result<Vec<_>>>()?
+            .len()
+            != 1
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "process supervisor is not single threaded",
+        ));
+    }
+    if unsafe { libc::prctl(libc::PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) } == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut subreaper: libc::c_int = 0;
+    if unsafe { libc::prctl(libc::PR_GET_CHILD_SUBREAPER, &mut subreaper, 0, 0, 0) } == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    if subreaper != 1 {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "process subtree adoption is unavailable",
+        ));
+    }
+    each_owned_child(force_parent_scan, |_| {
+        Err(io::Error::other("unexpected helper child"))
+    })?;
+    let mut status = 0;
+    let waited = unsafe { libc::waitpid(-1, &mut status, libc::__WALL | libc::WNOHANG) };
+    if waited != -1 || io::Error::last_os_error().raw_os_error() != Some(libc::ECHILD) {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "process subtree wait is unavailable",
+        ));
+    }
+    // Before target permission, prove that this exact inventory can see an
+    // owned child. The probe runs only _exit; no target program or environment.
+    let probe = unsafe { libc::fork() };
+    if probe == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    if probe == 0 {
+        unsafe { libc::_exit(0) };
+    }
+    let mut found = false;
+    let inventory = each_owned_child(force_parent_scan, |pid| {
+        if pid != probe {
+            return Err(io::Error::other("unexpected capability probe child"));
+        }
+        found = true;
+        Ok(())
+    });
+    let mut probe_status = 0;
+    loop {
+        let waited = unsafe { libc::waitpid(probe, &mut probe_status, libc::__WALL) };
+        if waited == probe {
+            break;
+        }
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::Interrupted {
+            return Err(error);
+        }
+    }
+    inventory?;
+    if !found || !libc::WIFEXITED(probe_status) || libc::WEXITSTATUS(probe_status) != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "owned child discovery is unavailable",
+        ));
+    }
+    Ok(())
+}
+
+fn guarded_target(
+    mut args: impl Iterator<Item = std::ffi::OsString>,
+    control: &mut File,
+    control_fd: i32,
+) -> io::Result<(libc::pid_t, TreeSignals, bool)> {
+    use std::os::fd::AsRawFd;
+
+    let parent_pid = args
+        .next()
+        .and_then(|arg| arg.to_str()?.parse::<libc::pid_t>().ok())
+        .filter(|pid| *pid > 0)
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+    let pty = match args.next().as_deref().and_then(std::ffi::OsStr::to_str) {
+        Some("pipe") => false,
+        Some("pty") => true,
+        _ => return Err(io::Error::from_raw_os_error(libc::EINVAL)),
+    };
+    let preserved = args
+        .next()
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+    let inherited_fds = preserved
+        .to_str()
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?
+        .split(',')
+        .filter(|fd| !fd.is_empty())
+        .map(str::parse::<i32>)
+        .collect::<Result<Vec<_>, _>>()
+        .map_err(|_| io::Error::from_raw_os_error(libc::EINVAL))?;
+    let cwd = args
+        .next()
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+    let program = args
+        .next()
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+    let arg0 = args
+        .next()
+        .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+    let target_args = args.collect::<Vec<_>>();
+    #[cfg(test)]
+    let inherit_auto_reap = target_args
+        .iter()
+        .any(|arg| arg == std::ffi::OsStr::new("--codex-test-tree-inherit-no-cldwait"));
+    #[cfg(test)]
+    let force_parent_scan = target_args
+        .iter()
+        .any(|arg| arg == std::ffi::OsStr::new("--codex-test-tree-parent-scan"));
+    #[cfg(not(test))]
+    let force_parent_scan = false;
+    #[cfg(test)]
+    let fail_setup = target_args
+        .iter()
+        .any(|arg| arg == std::ffi::OsStr::new("--codex-test-fail-tree-setup"));
+    let mut command = Command::new(program);
+    command
+        .current_dir(cwd)
+        .arg0(arg0)
+        .args(target_args)
+        .env_clear();
+    if unsafe { libc::fcntl(control_fd, libc::F_SETFD, libc::FD_CLOEXEC) } == -1 {
+        return Err(io::Error::last_os_error());
+    }
+    // Unlike the compatibility helper, the supervisor survives parent death
+    // and PTY hangup long enough to stop and reap its own remaining descendants.
+    if pty {
+        crate::pty::configure_child_terminal()?;
+    } else {
+        crate::process_group::detach_from_tty()?;
+    }
+    crate::pty::close_inherited_fds_except(&inherited_fds);
+    let mut size = [0; 4];
+    control.read_exact(&mut size)?;
+    let size = u32::from_le_bytes(size) as usize;
+    if size > MAX_ENV_BYTES {
+        return Err(io::Error::from_raw_os_error(libc::E2BIG));
+    }
+    let mut environment = vec![0; size];
+    control.read_exact(&mut environment)?;
+    for entry in environment
+        .split(|byte| *byte == 0)
+        .filter(|entry| !entry.is_empty())
+    {
+        let separator = entry
+            .iter()
+            .position(|byte| *byte == b'=')
+            .ok_or_else(|| io::Error::from_raw_os_error(libc::EINVAL))?;
+        command.env(
+            std::ffi::OsStr::from_bytes(&entry[..separator]),
+            std::ffi::OsStr::from_bytes(&entry[separator + 1..]),
+        );
+    }
+    #[cfg(test)]
+    if inherit_auto_reap {
+        let mut action: libc::sigaction = unsafe { std::mem::zeroed() };
+        action.sa_sigaction = libc::SIG_IGN;
+        action.sa_flags = libc::SA_NOCLDWAIT;
+        if unsafe { libc::sigemptyset(&mut action.sa_mask) } == -1
+            || unsafe { libc::sigaction(libc::SIGCHLD, &action, std::ptr::null_mut()) } == -1
+        {
+            return Err(io::Error::last_os_error());
+        }
+    }
+    let signals = TreeSignals::new()?;
+    require_tree_capabilities(force_parent_scan)?;
+    #[cfg(test)]
+    if fail_setup {
+        return Err(io::Error::from_raw_os_error(libc::ENOTSUP));
+    }
+    if unsafe { libc::getppid() } != parent_pid {
+        return Err(io::Error::from_raw_os_error(libc::ECANCELED));
+    }
+    tree_frame(
+        control,
+        crate::spawn_helper::TREE_READY,
+        std::process::id() as i32,
+    )?;
+    let mut permission = [0; 1];
+    control.read_exact(&mut permission)?;
+    if permission != [crate::spawn_helper::TREE_GO] || unsafe { libc::getppid() } != parent_pid {
+        return Err(io::Error::from_raw_os_error(libc::ECANCELED));
+    }
+    let signal_fd = signals.fd.as_raw_fd();
+    let mut target_mask = signals.original_mask;
+    for signal in [
+        libc::SIGCHLD,
+        libc::SIGTERM,
+        libc::SIGHUP,
+        libc::SIGINT,
+        libc::SIGPIPE,
+        libc::SIGTTOU,
+    ] {
+        if unsafe { libc::sigdelset(&mut target_mask, signal) } == -1 {
+            return Err(io::Error::last_os_error());
+        }
+    }
+    // SAFETY: Only this freshly reexecuted single-threaded helper forks. This
+    // closure only calls syscalls and closes helper-private descriptors.
+    unsafe {
+        command.pre_exec(move || {
+            libc::close(control_fd);
+            libc::close(signal_fd);
+            if libc::setpgid(0, 0) == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            if pty && libc::tcsetpgrp(libc::STDIN_FILENO, libc::getpid()) == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            for signal in [
+                libc::SIGCHLD,
+                libc::SIGTERM,
+                libc::SIGHUP,
+                libc::SIGINT,
+                libc::SIGPIPE,
+                libc::SIGTTOU,
+            ] {
+                set_signal_disposition(signal, libc::SIG_DFL)?;
+            }
+            if libc::sigprocmask(libc::SIG_SETMASK, &target_mask, std::ptr::null_mut()) == -1 {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    let target = command.spawn()?;
+    let pid = target.id() as libc::pid_t;
+    // These attachments belong to the target. Keeping a supervisor copy can
+    // prevent a pipe EOF or extend an inherited file/lock lifetime after the
+    // target closes it. The target already owns its inherited copies.
+    for fd in inherited_fds {
+        if fd > libc::STDERR_FILENO && fd != control_fd && fd != signal_fd {
+            unsafe { libc::close(fd) };
+        }
+    }
+    // std Child does not reap on Drop. This supervisor now owns the original
+    // PID and every adopted descendant through its exclusive waitpid loop.
+    drop(target);
+    Ok((pid, signals, force_parent_scan))
+}
+
+fn stop_owned_children(force_parent_scan: bool) -> io::Result<()> {
+    each_owned_child(force_parent_scan, |pid| {
+        // No reaping occurs inside this enumeration. These exact direct-child
+        // PIDs cannot be reused by an unrelated process before we signal them.
+        if unsafe { libc::kill(pid, libc::SIGKILL) } == -1
+            && io::Error::last_os_error().raw_os_error() != Some(libc::ESRCH)
+        {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    })
+}
+
+fn supervise_tree(
+    control: &mut File,
+    control_fd: i32,
+    root_pid: libc::pid_t,
+    signals: TreeSignals,
+    force_parent_scan: bool,
+) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+
+    let mut connected = tree_frame(control, crate::spawn_helper::TREE_STARTED, root_pid).is_ok();
+    let mut stop = !connected;
+    let mut root_status = None;
+    // The supervisor does not keep the target's pipes or PTY slave open.
+    // Its private control channel and signal descriptor are both above stdio.
+    for fd in [libc::STDIN_FILENO, libc::STDOUT_FILENO, libc::STDERR_FILENO] {
+        unsafe { libc::close(fd) };
+    }
+    loop {
+        if stop {
+            // A permission/procfs failure cannot become completion evidence.
+            // Continue owning/waiting; natural exit may still close the tree.
+            let _ = stop_owned_children(force_parent_scan);
+        }
+        let all_reaped = loop {
+            let mut status = 0;
+            let pid = unsafe { libc::waitpid(-1, &mut status, libc::__WALL | libc::WNOHANG) };
+            if pid > 0 {
+                if pid == root_pid && (libc::WIFEXITED(status) || libc::WIFSIGNALED(status)) {
+                    if root_status.replace(status).is_some() {
+                        return Err(io::Error::other("duplicate original process wait"));
+                    }
+                    if connected
+                        && tree_frame(control, crate::spawn_helper::TREE_ROOT_EXIT, status).is_err()
+                    {
+                        connected = false;
+                        stop = true;
+                    }
+                }
+                continue;
+            }
+            if pid == 0 {
+                break false;
+            }
+            let error = io::Error::last_os_error();
+            match error.raw_os_error() {
+                Some(libc::EINTR) => continue,
+                Some(libc::ECHILD) => break true,
+                _ => return Err(error),
+            }
+        };
+        if all_reaped {
+            let status =
+                root_status.ok_or_else(|| io::Error::other("original process wait was lost"))?;
+            if connected {
+                tree_frame(control, crate::spawn_helper::TREE_COMPLETE, status)?;
+            }
+            return Ok(());
+        }
+        let mut events = [
+            libc::pollfd {
+                fd: if connected { control_fd } else { -1 },
+                events: libc::POLLIN,
+                revents: 0,
+            },
+            libc::pollfd {
+                fd: signals.fd.as_raw_fd(),
+                events: libc::POLLIN,
+                revents: 0,
+            },
+        ];
+        let polled = unsafe { libc::poll(events.as_mut_ptr(), events.len() as _, -1) };
+        if polled == -1 {
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return Err(error);
+        }
+        if events[0].revents != 0 {
+            let mut requests = [0; 16];
+            match control.read(&mut requests) {
+                Ok(0) => {
+                    connected = false;
+                    stop = true;
+                }
+                Ok(count) => {
+                    for request in &requests[..count] {
+                        match *request {
+                            crate::spawn_helper::TREE_STOP => stop = true,
+                            crate::spawn_helper::TREE_INTERRUPT if root_status.is_none() => {
+                                // The original root PID remains unreaped, so
+                                // its original group number cannot be reused.
+                                // PTY callers signal through their master FD.
+                                unsafe { libc::kill(-root_pid, libc::SIGINT) };
+                            }
+                            crate::spawn_helper::TREE_INTERRUPT => {}
+                            _ => {
+                                connected = false;
+                                stop = true;
+                            }
+                        }
+                    }
+                }
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(_) => {
+                    connected = false;
+                    stop = true;
+                }
+            }
+        }
+        if events[1].revents != 0 {
+            loop {
+                let mut info: libc::signalfd_siginfo = unsafe { std::mem::zeroed() };
+                let read = unsafe {
+                    libc::read(
+                        signals.fd.as_raw_fd(),
+                        (&mut info as *mut libc::signalfd_siginfo).cast(),
+                        std::mem::size_of_val(&info),
+                    )
+                };
+                if read == std::mem::size_of_val(&info) as isize {
+                    if info.ssi_signo != libc::SIGCHLD as u32 {
+                        stop = true;
+                    }
+                    continue;
+                }
+                if read == -1 {
+                    let error = io::Error::last_os_error();
+                    if error.kind() == io::ErrorKind::WouldBlock {
+                        break;
+                    }
+                    if error.kind() == io::ErrorKind::Interrupted {
+                        continue;
+                    }
+                    return Err(error);
+                }
+                return Err(io::Error::other("invalid supervisor signal observation"));
+            }
+        }
+    }
+}
+
+/// Opt-in supervision in the existing pre-thread helper. Ordinary dispatch is
+/// unchanged; required callers receive no direct-execution compatibility path.
+pub(super) fn dispatch_guarded(mut args: impl Iterator<Item = std::ffi::OsString>) -> ! {
+    let Some(control_fd) = args
+        .next()
+        .and_then(|arg| arg.to_str()?.parse::<i32>().ok())
+        .filter(|fd| *fd > 2 && unsafe { libc::fcntl(*fd, libc::F_GETFD) } != -1)
+    else {
+        std::process::exit(127);
+    };
+    // SAFETY: Only the spawning parent supplies this owned private socket.
+    let mut control = unsafe { File::from_raw_fd(control_fd) };
+    match guarded_target(args, &mut control, control_fd) {
+        Ok((root_pid, signals, force_parent_scan)) => {
+            let succeeded = supervise_tree(
+                &mut control,
+                control_fd,
+                root_pid,
+                signals,
+                force_parent_scan,
+            )
+            .is_ok();
+            std::process::exit(if succeeded { 0 } else { 1 });
+        }
+        Err(error) => {
+            let errno = error.raw_os_error().unwrap_or(libc::EIO);
+            let _ = tree_frame(
+                &mut control,
+                crate::spawn_helper::TREE_PRE_EXEC_ERROR,
+                errno,
+            );
+            std::process::exit(127);
+        }
+    }
+}
