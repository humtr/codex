+fn account_read_rpc_error(error: AccountReadError) -> JSONRPCErrorError {
+    match error {
+        AccountReadError::InvalidAccount(error) => invalid_request(error.to_string()),
+        AccountReadError::Routing(error) => {
+            let authentication_unavailable = matches!(
+                error,
+                WorkspaceRoutingError::RefreshTokenRejected(_)
+                    | WorkspaceRoutingError::DiscoveryUnauthorized
+            );
+            let mut response = internal_error(error.to_string());
+            if authentication_unavailable {
+                // Account presentation can remain unavailable while an independent
+                // provider is selected. Policy/routing failures carry no such grant.
+                response.data = Some(serde_json::json!({
+                    "reason": "accountAuthenticationUnavailable"
+                }));
+            }
+            response
+        }
+    }
+}
