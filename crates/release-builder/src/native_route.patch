+    /// A resource proof is valid only when these actual hook matcher inputs
+    /// cannot execute additional effects. Reuse dispatch selection so regexes,
+    /// canonical names and compatibility aliases have exactly the same meaning.
+    pub(crate) fn tool_has_no_hook_effects(
+        &self,
+        tool_names: &[&str],
+        permission_names: &[&str],
+    ) -> bool {
+        if tool_names.is_empty()
+            || permission_names.is_empty()
+            || !self.warnings.is_empty()
+            || !self.required_load_errors.is_empty()
+            || self.command_runtime.has_pending_async_hooks()
+            || self.handlers.iter().any(|handler| {
+                handler.execution_mode() == HookExecutionMode::Async
+                    || !matches!(
+                        handler.event_name,
+                        HookEventName::PreToolUse
+                            | HookEventName::PostToolUse
+                            | HookEventName::PermissionRequest
+                    )
+            })
+        {
+            return false;
+        }
+        [
+            (HookEventName::PreToolUse, tool_names),
+            (HookEventName::PostToolUse, tool_names),
+            (HookEventName::PermissionRequest, permission_names),
+        ]
+        .into_iter()
+        .all(|(event, names)| {
+            dispatcher::select_handlers_for_matcher_inputs(&self.handlers, event, names).is_empty()
+        })
+    }
+
+    /// Conservative proof for a tool whose matcher aliases are not modeled by
+    /// the caller. Never guess those aliases or infer child exit from hook exit.
+    pub(crate) fn has_no_configured_hook_effects(&self) -> bool {
+        self.handlers.is_empty()
+            && self.warnings.is_empty()
+            && self.required_load_errors.is_empty()
+            && !self.command_runtime.has_pending_async_hooks()
+    }
+
     pub(crate) fn warnings(&self) -> &[String] {
         &self.warnings
