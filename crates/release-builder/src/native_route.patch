+
+    fn proof(outcome: NativeCompletionOutcome) -> NativeEffectCompletion {
+        NativeEffectCompletion {
+            schema: NativeCompletionSchema::V1,
+            call_id: "original-call".into(),
+            session_id: if outcome == NativeCompletionOutcome::WaitCompleted {
+                Some(71)
+            } else {
+                None
+            },
+            outcome,
+            exit_code: if outcome == NativeCompletionOutcome::WaitCompleted {
