+        let owned = tempfile::tempdir()?;
+        let release = owned.path().join("release-descendant");
+        let (shell, sleep) = if cfg!(target_os = "android") {
+            ("/system/bin/sh", "/system/bin/sleep")
+        } else {
+            ("/bin/sh", "/bin/sleep")
+        };
+        let command = vec![
+            "-c".to_owned(),
+            "(exec >/dev/null 2>&1; while [ ! -f \"$1\" ]; do \"$2\" 0.01; done) & printf original-root; exit 7".to_owned(),
+            "owned-tree-history".to_owned(),
+            release.to_string_lossy().into_owned(),
+            sleep.to_owned(),
+        ];
+        let spawned = codex_utils_pty::pipe::spawn_process_guarded(
+            shell,
+            &command,
+            owned.path(),
+            &HashMap::new(),
+            &None,
+            &[],
+            true,
+        )
+        .await?;
+        let process = Arc::new(
+            UnifiedExecProcess::from_spawned_with_native_attempt(
+                spawned,
+                SandboxType::None,
