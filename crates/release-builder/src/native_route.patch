+async fn read_tree_frame(control: &mut tokio::net::UnixStream) -> io::Result<(u8, i32)> {
+    let mut frame = [0; TREE_FRAME_BYTES];
+    control.read_exact(&mut frame).await?;
+    if frame[..TREE_MAGIC.len()] != TREE_MAGIC {
+        return Err(io::Error::other("invalid process supervision frame"));
+    }
+    let value = i32::from_le_bytes(
+        frame[9..]
+            .try_into()
+            .map_err(|_| io::Error::other("invalid process supervision frame"))?,
+    );
+    Ok((frame[8], value))
+}
+
+fn frame_error(frame: (u8, i32)) -> Option<io::Error> {
+    if frame.0 == TREE_PRE_EXEC_ERROR && frame.1 > 0 {
+        Some(io::Error::from_raw_os_error(frame.1))
+    } else {
+        None
+    }
+}
