+            let mut large = end.clone();
+            large.aggregated_output = "y".repeat(super::PERSISTED_COMMAND_OUTPUT_MAX_BYTES + 100);
+            let large = EventMsg::ExecCommandEnd(large);
+            let bounded = persisted_event_msg(&large, mode)
+                .ok_or_else(|| anyhow::anyhow!("bounded Native receipt"))?;
+            let EventMsg::ExecCommandEnd(bounded_end) = bounded.as_ref() else {
+                anyhow::bail!("original receipt kind");
+            };
+            assert!(
+                bounded_end.aggregated_output.len() <= super::PERSISTED_COMMAND_OUTPUT_MAX_BYTES
+            );
+            assert!(
+                bounded_end
+                    .aggregated_output
+                    .contains(super::PERSISTED_COMMAND_OUTPUT_TRUNCATION_MARKER)
+            );
+            assert_eq!(bounded_end.native_completion, end.native_completion);
+            assert_eq!(bounded_end.call_id, end.call_id);
+            assert_eq!(bounded_end.exit_code, 124);
+            let mut bounded_wire = serde_json::to_value(bounded.as_ref())?;
+            let original_wire = serde_json::to_value(&large)?;
+            bounded_wire["aggregated_output"] = original_wire["aggregated_output"].clone();
+            assert_eq!(bounded_wire, original_wire, "only stored output is bounded");
+        }
+    }
+    Ok(())
