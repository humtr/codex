+        let mut stream = session
+            .stream(
+                &prompt,
+                &test_model_info(),
+                &test_session_telemetry(),
+                None,
+                codex_protocol::config_types::ReasoningSummary::None,
+                None,
+                &metadata,
+                &InferenceTraceContext::disabled(),
+            )
+            .await?;
+        let mut completed = false;
+        while let Some(event) = stream.next().await {
+            completed |= matches!(event?, ResponseEvent::Completed { .. });
+        }
+        assert!(completed);
+        Ok(())
+    }
+
+    let server = MockServer::start().await;
+    let response = ResponseTemplate::new(200)
+        .insert_header("content-type", "text/event-stream")
+        .set_body_string(concat!(
+            "data: {\"type\":\"response.created\",\"response\":{\"id\":\"route-proof\"}}\n\n",
+            "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"route-proof\"}}\n\n",
+        ));
+    Mock::given(method("GET"))
+        .and(path("/v1/native/capabilities"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "schema":"codex-native-compatibility-v1",
+            "protocol_major":4,"protocol_minor":1,
+            "stable_ingress":"/v1/native/responses",
+            "transports":["http_sse"],
+            "capabilities":["tool_call_ids_v1","tool_result_binding_v1","native_turn_admission_v4"]
+        })))
+        .mount(&server)
+        .await;
+    for endpoint in ["/v1/responses", "/v1/native/responses"] {
+        Mock::given(method("POST"))
+            .and(path(endpoint))
+            .respond_with(response.clone())
+            .mount(&server)
+            .await;
+    }
+    let mut info =
+        create_oss_provider_with_base_url(&format!("{}/v1", server.uri()), WireApi::Responses);
+    info.name = "chatgpt_desktop".into();
+    info.supports_websockets = false;
+    let ordinary = test_model_client(SessionSource::Cli).with_provider("openai", info.clone());
+    let native = ordinary
+        .clone()
+        .with_native_provider_route("chatgpt_desktop");
+    let auxiliary = test_model_client(SessionSource::Internal(
+        InternalSessionSource::MemoryConsolidation,
+    ))
+    .with_provider("chatgpt_desktop", info.clone());
+    for (client, expected) in [
+        (ordinary, "/v1/responses"),
+        (native.clone(), "/v1/native/responses"),
+        (auxiliary, "/v1/native/responses"),
+        (
+            native.with_provider("openai", info.clone()),
+            "/v1/responses",
+        ),
+        (
+            native.with_provider("unrelated", info.clone()),
+            "/v1/responses",
+        ),
+    ] {
+        sample(&client).await?;
+        let requests = server
+            .received_requests()
+            .await
+            .ok_or_else(|| anyhow::anyhow!("missing captured response request"))?;
+        assert_eq!(
+            requests.last().map(|request| request.url.path()),
+            Some(expected)
+        );
+        if expected == "/v1/native/responses" {
+            let request = requests.last().unwrap();
+            assert_eq!(request.headers["x-codex-native-protocol"], "4");
+            assert_eq!(
+                request.headers["x-codex-native-required-capabilities"],
+                codex_model_provider::NATIVE_REQUIRED_CAPABILITIES_HEADER
+            );
+        }
+        assert_eq!(client.state.provider.info().base_url, info.base_url);
+    }
+    let setup = native
+        .current_client_setup(super::ClientRouting::Workspace)
+        .await?;
+    assert_eq!(
+        setup
+            .api_provider
+            .websocket_url_for_path("/responses")?
+            .path(),
+        "/v1/native/responses",
+    );
+    assert_eq!(
+        native
+            .current_client_setup(super::ClientRouting::ConfiguredProvider)
+            .await?
+            .api_provider
+            .base_url,
+        info.base_url
+            .clone()
+            .ok_or_else(|| anyhow::anyhow!("missing test base"))?,
+    );
+
+    let mut missing_base = info.clone();
+    missing_base.base_url = None;
+    let missing = native.with_provider("chatgpt_desktop", missing_base);
+    let error = sample(&missing).await.err().ok_or_else(|| {
+        anyhow::anyhow!("a Native route must not resolve the default OpenAI destination")
+    })?;
+    assert!(error.to_string().contains("requires an explicit base_url"));
+    assert!(missing.realtime_client_setup().await.is_err());
+
+    // An old Provider accepts only this unversioned route. Its 404 on the
+    // private route must remain a failure: no retry may use the old ingress.
+    let legacy = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(response)
+        .expect(0)
+        .mount(&legacy)
+        .await;
+    info.base_url = Some(format!("{}/v1", legacy.uri()));
+    let incompatible = native.with_provider("chatgpt_desktop", info);
+    let failure = sample(&incompatible).await.unwrap_err();
+    assert!(
+        failure
+            .to_string()
+            .contains("provider_protocol_incompatible")
+    );
+    let requests = legacy
+        .received_requests()
+        .await
+        .ok_or_else(|| anyhow::anyhow!("missing captured incompatible request"))?;
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0].method.as_str(), "GET");
+    assert_eq!(requests[0].url.path(), "/v1/native/capabilities");
+
+    // A service with a current-looking version but no required tool-result
+    // binding must be rejected before any model/tool submission.
+    let weak = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/v1/native/capabilities"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "schema":"codex-native-compatibility-v1",
+            "protocol_major":4,"protocol_minor":9,
+            "stable_ingress":"/v1/native/responses",
+            "transports":["http_sse"],
+            "capabilities":["tool_call_ids_v1"]
