+#[derive(Clone, Default)]
+struct TreeObservation {
+    root_status: Option<i32>,
+    complete_frame: bool,
+    helper_waited: Option<bool>,
+    failed: bool,
+}
+
+impl TreeObservation {
+    fn completed_status(&self) -> Option<std::process::ExitStatus> {
+        use std::os::unix::process::ExitStatusExt;
+
+        if self.complete_frame && self.helper_waited == Some(true) && !self.failed {
+            self.root_status.map(std::process::ExitStatus::from_raw)
+        } else {
+            None
+        }
+    }
+}
+
+struct TreeControl {
+    writer: std::sync::Mutex<UnixStream>,
+    observation: tokio::sync::watch::Sender<TreeObservation>,
+    #[cfg(test)]
+    target_pid: u32,
+    pty_master: Option<std::os::fd::OwnedFd>,
+}
+
+impl Drop for TreeControl {
+    fn drop(&mut self) {
+        use std::io::Write;
+
+        let writer = match self.writer.get_mut() {
+            Ok(writer) => writer,
+            Err(poisoned) => poisoned.into_inner(),
+        };
+        // Stop the owned subtree, never the supervising owner. Shutdown
+        // also wakes the helper if the one-byte write could not complete.
+        let _ = writer.write_all(&[TREE_STOP]);
+        let _ = writer.shutdown(std::net::Shutdown::Write);
+    }
+}
