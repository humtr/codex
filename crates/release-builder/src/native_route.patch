+        let p = proof(NativeCompletionOutcome::WaitCompleted);
+        let value = serde_json::to_value(&p)?;
+        assert_eq!(value["schema"], "codex-native-completion-v1");
+        assert_eq!(value["call_id"], "original-call");
+        assert_eq!(value["session_id"], 71);
+        assert_eq!(value["exit_code"], 137);
+        assert_eq!(value["hooks"], "absent");
+        assert_eq!(serde_json::from_value::<NativeEffectCompletion>(value)?, p);
+        let mut value = serde_json::to_value(p)?;
+        value["schema"] = serde_json::json!("unknown");
+        assert!(serde_json::from_value::<NativeEffectCompletion>(value).is_err());
+        Ok(())
+    }
