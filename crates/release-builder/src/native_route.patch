+#[test_case(ThreadHistoryMode::Legacy; "legacy")]
+#[test_case(ThreadHistoryMode::Paginated; "paginated")]
+#[tokio::test]
+async fn model_provider_roundtrip_preserves_jobs_history_observers_and_siblings(
+    history_mode: ThreadHistoryMode,
+) -> Result<()> {
+    let initial = responses::sse(vec![
+        responses::ev_response_created("start-job"),
+        responses::ev_function_call(
+            "start-job",
+            "exec_command",
+            &json!({
+                "cmd": "read value; printf 'SURVIVED:%s\\n' \"$value\"",
+                "tty": true, "yield_time_ms": 1000, "max_output_tokens": 2000,
+            })
+            .to_string(),
+        ),
+        responses::ev_completed("start-job"),
+    ]);
+    let first = create_mock_responses_server_sequence_unchecked(vec![
+        initial,
+        create_final_assistant_message_sse_response("job admitted")?,
+        create_final_assistant_message_sse_response("sibling unchanged")?,
+        create_final_assistant_message_sse_response("returned to original route")?,
+    ])
+    .await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(first.uri())
+        .with_sandbox_mode("danger-full-access")
+        .enable_feature(codex_features::Feature::UnifiedExec)
+        .with_provider_config("supports_websockets = false")
+        .write(home.path())?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let started = client
+        .start_thread(ThreadStartParams {
+            history_mode: Some(history_mode),
+            ..Default::default()
+        })
+        .await?;
+    let thread = started.thread.id;
+    let sibling = client
+        .start_thread(ThreadStartParams::default())
+        .await?
+        .thread
+        .id;
+    let input = || {
+        vec![V2UserInput::Text {
+            text: "continue this work".into(),
+            text_elements: Vec::new(),
+        }]
+    };
+    client
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread.clone(),
+            input: input(),
+            ..Default::default()
+        })
+        .await?;
+    let before: codex_app_server_protocol::ThreadBackgroundTerminalsListResponse = client
+        .request(|request_id| ClientRequest::ThreadBackgroundTerminalsList {
+            request_id,
+            params: codex_app_server_protocol::ThreadBackgroundTerminalsListParams {
+                thread_id: thread.clone(),
+                cursor: None,
+                limit: None,
+            },
+        })
+        .await?;
+    assert_eq!(
+        before.data.len(),
+        1,
+        "the first route must own a real running terminal"
+    );
+    let process = before.data[0].process_id.clone();
+    let finish_job = responses::sse(vec![
+        responses::ev_response_created("finish-job"),
+        responses::ev_function_call("finish-job", "write_stdin", &json!({
+            "session_id": process.parse::<i32>()?, "chars": "continued\n", "yield_time_ms": 1000, "max_output_tokens": 2000,
+        }).to_string()),
+        responses::ev_completed("finish-job"),
+    ]);
+    let second = create_mock_responses_server_sequence_unchecked(vec![
+        finish_job,
+        create_final_assistant_message_sse_response("second route completed original job")?,
+    ])
+    .await;
+    let sent_before_selection = received_response_bodies(&first).await?.len();
+    send_thread_settings_update(
+        &mut client,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.clone(),
+            model_provider: Some("alternate".into()),
+            config: Some(std::collections::HashMap::from([(
+                "model_providers".to_string(),
+                json!({"alternate": {
+                    "name": "Alternate", "base_url": format!("{}/v1", second.uri()),
+                    "wire_api": "responses", "requires_openai_auth": false,
+                    "supports_websockets": false,
+                }}),
+            )])),
+            ..Default::default()
+        },
+    )
+    .await?;
+    // Keep the original client subscription. No resume/restart is used to recover notifications.
+    let changed = timeout(
+        DEFAULT_TIMEOUT,
+        client.read_stream_until_matching_notification("provider transition", |notification| {
+            notification.method == "thread/settings/updated"
+                && notification.params.as_ref().is_some_and(|params| {
+                    params["threadId"] == thread
+                        && params["threadSettings"]["modelProvider"] == "alternate"
+                })
+        }),
+    )
+    .await??;
+    assert_eq!(changed.method, "thread/settings/updated");
+    assert_eq!(
+        received_response_bodies(&first).await?.len(),
+        sent_before_selection
+    );
+    assert!(
+        received_response_bodies(&second).await?.is_empty(),
+        "selection must submit no inference"
+    );
+    let after: codex_app_server_protocol::ThreadBackgroundTerminalsListResponse = client
+        .request(|request_id| ClientRequest::ThreadBackgroundTerminalsList {
+            request_id,
+            params: codex_app_server_protocol::ThreadBackgroundTerminalsListParams {
+                thread_id: thread.clone(),
+                cursor: None,
+                limit: None,
+            },
+        })
+        .await?;
+    assert_eq!(after.data[0].process_id, process);
+    client
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread.clone(),
+            input: input(),
+            ..Default::default()
+        })
+        .await?;
+    let requests = received_response_bodies(&second).await?;
+    assert_eq!(
+        requests.len(),
+        2,
+        "selected route did not receive the continuation"
+    );
+    let returned = requests[1]["input"].to_string();
+    assert!(
+        returned.contains("SURVIVED:continued"),
+        "the new route must receive the original terminal's real output: {returned}"
+    );
+    assert!(returned.contains("Process exited with code 0"));
+    // A sibling still uses its original route while this thread uses the alternate.
+    client
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: sibling,
+            input: input(),
+            ..Default::default()
+        })
+        .await?;
+    assert_eq!(received_response_bodies(&first).await?.len(), 3);
+    send_thread_settings_update(
+        &mut client,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.clone(),
+            model_provider: Some("mock_provider".into()),
+            ..Default::default()
+        },
+    )
+    .await?;
+    client
+        .start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: thread.clone(),
+            input: input(),
+            ..Default::default()
+        })
+        .await?;
+    assert_eq!(received_response_bodies(&first).await?.len(), 4);
+    assert_eq!(received_response_bodies(&second).await?.len(), 2);
+    let history: ThreadReadResponse = client
+        .request(|request_id| ClientRequest::ThreadRead {
+            request_id,
+            params: ThreadReadParams {
+                thread_id: thread.clone(),
+                include_turns: false,
+            },
+        })
+        .await?;
+    assert_eq!(history.thread.id, thread);
+    assert_eq!(history.thread.model_provider, "mock_provider");
+    let turns: codex_app_server_protocol::ThreadTurnsListResponse = client
+        .request(|request_id| ClientRequest::ThreadTurnsList {
+            request_id,
+            params: codex_app_server_protocol::ThreadTurnsListParams {
+                thread_id: thread.clone(),
+                cursor: None,
+                limit: Some(10),
+                sort_direction: None,
+                items_view: Some(codex_app_server_protocol::TurnItemsView::Full),
+            },
+        })
+        .await?;
+    assert_eq!(turns.data.len(), 3);
+    let recorded = serde_json::to_string(&turns)?;
+    assert!(recorded.contains("second route completed original job"));
+    assert!(recorded.contains("returned to original route"));
+    Ok(())
+}
