+    assert!(process.has_exited());
+    assert!(
+        !process.scope_has_exited(),
+        "the original descendant still lives"
+    );
+
+    let manager = UnifiedExecProcessManager::default();
+    let environment = turn
+        .initial_environments
+        .primary()
+        .ok_or_else(|| anyhow::anyhow!("original local environment"))?;
+    let entry = ProcessEntry {
+        process: Arc::clone(&process),
+        plugin_metrics_sidecar: None,
+        call_id: "original-tree-root".into(),
+        process_id: 71,
+        cwd: PathUri::from(AbsolutePathBuf::from_absolute_path(directory.path())?),
+        initial_exec_command_active: Arc::new(AtomicBool::new(false)),
+        hook_command: "original tree fixture".into(),
+        tty: false,
+        environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_owned(),
+        permissions: super::super::TerminalPermissions::for_launch(
+            environment,
+            &turn,
+            super::super::TerminalSandboxSource::Native,
+            crate::sandboxing::SandboxPermissions::UseDefault,
+            None,
+            None,
+        ),
+        network_approval: None,
+        session: Arc::downgrade(&session),
+        last_used: Instant::now(),
+    };
+    manager
+        .process_store
+        .lock()
+        .await
+        .processes
+        .insert(71, entry);
+    manager.release_process_id(71).await;
+    assert_eq!(manager.list_processes().await.len(), 1);
+    assert!(matches!(
+        manager
+            .refresh_process_state(71, &process, OutputRetention::UntilExit)
+            .await,
+        ProcessStatus::Alive {
+            exit_code: Some(7),
+            process_id: 71,
+            ..
+        }
+    ));
+    assert!(manager.terminate_process(71).await);
+    let proof = tokio::time::timeout(Duration::from_secs(5), process.native_wait_completion(71))
+        .await?
+        .ok_or_else(|| anyhow::anyhow!("actual original scope closure"))?;
+    assert_eq!(proof.outcome, NativeCompletionOutcome::ProcessTreeCompleted);
+    assert_eq!(proof.call_id, "original-tree-root");
+    assert_eq!(proof.session_id, Some(71));
+    assert_eq!(proof.exit_code, Some(7));
+    assert_eq!(
+        process.exit_code(),
+        Some(7),
+        "Stop does not rewrite the root"
+    );
+    assert!(process.scope_has_exited());
+    manager.release_process_id(71).await;
+    assert!(manager.list_processes().await.is_empty());
+    assert!(
+        !manager
+            .process_store
+            .lock()
+            .await
+            .processes
+            .contains_key(&71)
+    );
+    Ok(())
+}
