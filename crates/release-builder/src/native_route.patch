+    let root = tokio::time::timeout(DEADLINE, spawned.guard.wait_root()).await??;
+    assert_eq!(root.code(), Some(7));
+    assert!(spawned.guard.confirmed_tree_status().is_none());
+    assert_eq!(unsafe { libc::kill(descendant as i32, 0) }, 0);
+    drop(cleanup);
+    assert_eq!(finish(&mut spawned).await?.code(), Some(7));
+    Ok(())
+}
