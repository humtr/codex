+pub(super) const TREE_MAGIC: [u8; 8] = *b"CXTRv1\0\0";
+pub(super) const TREE_READY: u8 = 1;
+pub(super) const TREE_STARTED: u8 = 2;
+pub(super) const TREE_ROOT_EXIT: u8 = 3;
+pub(super) const TREE_COMPLETE: u8 = 4;
+pub(super) const TREE_PRE_EXEC_ERROR: u8 = 5;
+pub(super) const TREE_GO: u8 = 1;
+pub(super) const TREE_STOP: u8 = 2;
+pub(super) const TREE_INTERRUPT: u8 = 3;
+const TREE_FRAME_BYTES: usize = 13;
