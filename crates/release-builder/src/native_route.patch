+#[cfg(unix)]
+#[tokio::test]
+async fn native_completion_timeout_keeps_public_124_until_original_os_wait_proves_exit()
+-> anyhow::Result<()> {
+    use crate::native_completion::CallCompletion;
+    use crate::session::step_context::StepContext;
+    use codex_tools::ToolName;
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let step = StepContext::for_test(Arc::new(turn));
+    let completion = Arc::new(CallCompletion::default());
+    completion.capture(
+        &session,
+        &step,
+        "original-timeout",
+        &ToolName::plain("exec_command"),
+    );
+    completion.bind_exec_session(71);
+    let attempt = completion
+        .begin_attempt()
+        .ok_or_else(|| anyhow::anyhow!("backend attempt"))?;
+    let directory = tempfile::tempdir()?;
+    let shell = if cfg!(target_os = "android") {
+        "/system/bin/sh"
+    } else {
+        "/bin/sh"
+    };
+    let spawned = codex_utils_pty::spawn_pipe_process(
+        shell,
+        &["-c".into(), "read value".into()],
+        directory.path(),
+        &std::collections::HashMap::new(),
+        &None,
+        &[],
+    )
+    .await?;
+    let process = UnifiedExecProcess::from_spawned_with_native_attempt(
+        spawned,
+        codex_sandboxing::SandboxType::None,
+        Some(attempt),
+    )
+    .await?;
+    process.bind_native_origin(Some(Arc::clone(&completion)));
+    assert!(!process.has_exited());
+    process.mark_timed_out();
+    process.terminate_confirmed().await?;
+    assert_eq!(process.exit_code(), Some(124));
+    completion.finish(&session);
+    let proof = tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        process.native_wait_completion(71),
+    )
+    .await?
+    .ok_or_else(|| anyhow::anyhow!("actual local wait must prove this original process"))?;
+    assert_eq!(proof.call_id, "original-timeout");
+    assert_eq!(proof.session_id, Some(71));
+    assert_eq!(proof.exit_code, Some(137));
+    assert_eq!(
+        proof.outcome,
+        codex_protocol::protocol::NativeCompletionOutcome::WaitCompleted
+    );
+    assert_eq!(
+        process.exit_code(),
+        Some(124),
+        "the original public timeout receipt is immutable"
+    );
+    Ok(())
+}
