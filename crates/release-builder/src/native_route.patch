+#[tokio::test]
+async fn native_completion_network_permission_keeps_original_admitted_hooks() -> anyhow::Result<()>
+{
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let original = session.hooks();
+    let turn = Arc::new(turn);
+    let step = StepContext::for_test(Arc::clone(&turn));
+    let service = NetworkApprovalService::default();
+    service
+        .register_call(ActiveNetworkApprovalCall {
+            native_hooks: Some(Arc::clone(&original)),
+            registration_id: "native-owner".into(),
+            turn_id: turn.sub_id.clone(),
+            trigger: GuardianNetworkAccessTrigger {
+                call_id: "original-exec".into(),
+                tool_name: "exec_command".into(),
+                command: vec!["owned-command".into()],
+                cwd: PathUri::from_abs_path(&test_path_buf("/tmp").abs()),
+                sandbox_permissions: SandboxPermissions::UseDefault,
+                additional_permissions: None,
+                justification: None,
+                tty: None,
+            },
+            tool_name: ToolName::plain("exec_command"),
+            command: "owned-command".into(),
+            environment_id: "local".into(),
+            permission_profile: PermissionProfile::workspace_write(),
+            environments: step.environments.clone(),
+            cancellation_token: CancellationToken::new(),
+        })
+        .await;
+    session.services.hooks.store(Arc::new((*original).clone()));
+    let owner = service
+        .resolve_single_active_call()
+        .await
+        .ok_or_else(|| anyhow::anyhow!("original owner"))?;
+    let review = owner.review_context(Arc::clone(&turn), &step.settings);
+    let bound = review
+        .native_hooks
+        .as_ref()
+        .ok_or_else(|| anyhow::anyhow!("admitted hook identity"))?;
+    assert!(Arc::ptr_eq(bound, &original));
+    assert!(!Arc::ptr_eq(bound, &session.hooks()));
+    assert!(Arc::ptr_eq(&review.model_info, &step.settings.model_info));
+    assert_eq!(owner.trigger.call_id, "original-exec");
+    let unowned =
+        GuardianReviewContext::from_resolved_settings(turn, &step.settings, &step.environments);
+    assert!(
+        unowned.native_hooks.is_none(),
+        "unowned/ordinary review retains live hooks"
+    );
+    Ok(())
+}
