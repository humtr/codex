+impl GuardedSpawnError {
+    fn before_exec(error: io::Error) -> Self {
+        Self {
+            error,
+            target_not_started: true,
+        }
+    }
+
+    fn uncertain(error: io::Error) -> Self {
+        Self {
+            error,
+            target_not_started: false,
+        }
+    }
