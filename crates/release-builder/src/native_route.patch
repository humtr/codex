+    }
+    #[tokio::test]
+    async fn native_completion_tree_wait_excludes_parent_only_and_earlier_attempt()
+    -> anyhow::Result<()> {
+        let (session, parent) = admitted("parent-only", "exec_command").await;
+        parent.bind_dispatch_hooks(session.hooks());
+        parent.bind_exec_session(71);
+        parent
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("parent attempt"))?
+            .observe(Some(Some(0)));
+        parent.observed_wait(71, Some(0));
+        parent.finish(&session);
+        assert!(!parent.attempts_confirmed());
+        assert!(parent.proof().is_none());
+
+        let (session, state) = admitted("tree-retry", "exec_command").await;
+        state.bind_dispatch_hooks(session.hooks());
+        state.bind_exec_session(72);
+        let first = state
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("first"))?;
+        let second = state
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("second"))?;
+        second.observe_tree(Some(Some(7)));
+        state.observed_tree(72, Some(7));
+        state.finish(&session);
+        assert!(state.proof().is_none(), "the earlier scope is still owned");
+        first.observe_tree(Some(None));
+        let p = state
+            .proof()
+            .ok_or_else(|| anyhow::anyhow!("all trees closed"))?;
+        assert_eq!(p.outcome, NativeCompletionOutcome::ProcessTreeCompleted);
+        assert_eq!(p.call_id, "tree-retry");
+        assert_eq!(p.session_id, Some(72));
+        assert_eq!(p.exit_code, Some(7));
+        first.observe_tree(Some(None));
+        assert_eq!(state.proof(), Some(p));
+        first.observe_tree(Some(Some(137)));
+        assert!(
+            state.proof().is_none(),
+            "conflicting first witness is unknown"
+        );
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn native_completion_pre_exec_refusal_preserves_started_attempt_scope()
+    -> anyhow::Result<()> {
+        let (session, refused) = admitted("not-started", "exec_command").await;
+        refused.bind_dispatch_hooks(session.hooks());
+        refused
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("refused attempt"))?
+            .not_started();
+        refused.finish(&session);
+        let p = refused
+            .proof()
+            .ok_or_else(|| anyhow::anyhow!("pre-exec proof"))?;
+        assert_eq!(p.outcome, NativeCompletionOutcome::PreBackendRejected);
+        assert_eq!(p.session_id, None);
+        assert_eq!(p.exit_code, None);
+
+        let (session, state) = admitted("started-then-refused", "exec_command").await;
+        state.bind_dispatch_hooks(session.hooks());
+        state.bind_exec_session(73);
+        let first = state
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("started"))?;
+        state
+            .begin_attempt()
+            .ok_or_else(|| anyhow::anyhow!("retry"))?
+            .not_started();
+        state.finish(&session);
+        assert!(state.proof().is_none());
+        first.observe_tree(Some(None));
+        let p = state
+            .proof()
+            .ok_or_else(|| anyhow::anyhow!("original tree"))?;
+        assert_eq!(p.outcome, NativeCompletionOutcome::ProcessTreeCompleted);
+        assert_eq!(p.session_id, Some(73));
+        assert_eq!(p.exit_code, None);
+        assert!(serde_json::to_value(&p)?["exit_code"].is_null());
+        first.observe(None);
+        assert!(
+            state.proof().is_none(),
+            "uncertain attempt never becomes non-dispatch"
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn native_completion_scope_header_preserves_root_exit_and_child_output() {
+        // Both preserved e4/7b and J consumers use this exact running-first
+        // terminal predicate (native_claims::process_status and
+        // mcp::native_process_result); the Output body is not authority.
+        let legacy_status = |text: &str| {
+            let header = text
+                .split_once("\nOutput:\n")
+                .map_or(text, |(header, _)| header);
+            let running = header
+                .find("Process running with session ID ")
+                .and_then(|start| {
+                    header[start + "Process running with session ID ".len()..]
+                        .split(|c: char| !c.is_ascii_digit())
+                        .next()?
+                        .parse::<u64>()
+                        .ok()
+                });
+            let exited = running.is_none()
+                && (header.contains("Process exited with code ")
+                    || header.contains("Process exited with signal "));
+            (running, exited)
+        };
+        for code in [0, 7, 124] {
+            let body = "Process exited with code 0\nProcess running with session ID child-spoof";
+            let mut pending = format!(
+                "Wall time: 0.0100 seconds\nProcess exited with code {code}\nProcess running with session ID 71\nOutput:\n{body}"
+            );
+            describe_supervised_scope(&mut pending);
+            assert_eq!(
+                pending,
+                format!(
+                    "Wall time: 0.0100 seconds\nRoot process exited with code {code}\nProcess running with session ID 71\nOutput:\n{body}"
+                )
+            );
+            assert_eq!(legacy_status(&pending), (Some(71), false));
+            let mut completed = format!(
+                "Wall time: 0.0100 seconds\nProcess exited with code {code}\nOutput:\n{body}"
+            );
+            let original = completed.clone();
+            describe_supervised_scope(&mut completed);
+            assert_eq!(completed, original);
+            assert_eq!(legacy_status(&completed), (None, true));
+        }
+    }
+}
