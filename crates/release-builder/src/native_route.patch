diff --git a/codex-rs/core/src/native_execution.rs b/codex-rs/core/src/native_execution.rs
new file mode 100644
index 0000000..e8b20f5
--- /dev/null
+++ b/codex-rs/core/src/native_execution.rs
@@ -0,0 +1,167 @@
+//! Private execution facts for the local ChatGPT Provider's resource admission.
+//! Native remains the only executor. No tool arguments or environment values
+//! are rewritten, and no compiler or shell is run to obtain these facts.
+use crate::exec_env::create_env;
+use crate::session::session::Session;
+use crate::session::step_context::StepContext;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::HashMap;
+use std::path::Path;
+
+pub(crate) const METADATA_KEY: &str = "termux_native_execution";
+
+fn project(
+    env: &HashMap<String, String>,
+    cwd: &Path,
+    shell: &Path,
+    thread: &str,
+    turn: &str,
+) -> Option<Value> {
+    let pid = std::process::id();
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    let start = stat.rsplit_once(')')?.1.split_whitespace().nth(19)?;
+    let prefix = env.get("PREFIX")?;
+    let home = env.get("HOME")?;
+    let path = env.get("PATH")?;
+    if !cwd.is_absolute()
+        || !shell.is_absolute()
+        || !Path::new(prefix).is_absolute()
+        || !Path::new(home).is_absolute()
+        || path.len() > 16 * 1024
+        || env.len() > 512
+    {
+        return None;
+    }
+    let mut variables = env.keys().collect::<Vec<_>>();
+    variables.sort();
+    Some(
+        json!({"schema":1,"pid":pid,"start":start,"thread":thread,"turn":turn,
+        "cwd":cwd,"shell":shell,"prefix":prefix,"home":home,"path":path,
+        "variables":variables,"no_default_config":env.get("CLANG_NO_DEFAULT_CONFIG").is_some_and(|s|!s.is_empty())}),
+    )
+}
+
+pub(crate) fn capture(session: &Session, step: &StepContext) -> Option<Value> {
+    // This is private, model-invisible metadata for the qualified local route.
+    if step.turn.config.model_provider_id != "chatgpt_desktop"
+        || step.environments.turn_environments().count() != 1
+        || !step.executor_hook_sources.is_empty()
+        || !session
+            .hooks()
+            .list_with_environment_hooks(Vec::new())
+            .hooks
+            .is_empty()
+    {
+        return None;
+    }
+    let environment = step.environments.primary()?;
+    if environment.environment.is_remote()
+        || !environment.config().environment_hooks.is_empty()
+        || step
+            .turn
+            .config
+            .permissions
+            .network
+            .as_ref()
+            .is_some_and(|network| network.enabled() && network.credential_broker_enabled())
+    {
+        return None;
+    }
+    let cwd = environment.cwd().to_abs_path().ok()?;
+    let session_shell = session.user_shell();
+    let shell = environment.shell.as_ref().unwrap_or(session_shell.as_ref());
+    // Reuse UnifiedExec's selected policy and package PATH projection. Its
+    // remaining overlays add runtime IDs, permission labels and terminal
+    // defaults. This qualification is for login:false only, so shell snapshots
+    // are not applied; credential-broker snapshots and remote executors are
+    // excluded above.
+    let mut env = create_env(environment.shell_environment_policy(), None);
+    #[cfg(unix)]
+    crate::tools::runtimes::apply_package_path_prepend(
+        &mut env,
+        &mut crate::tools::runtimes::RuntimePathPrepends::default(),
+    );
+    project(
+        &env,
+        cwd.as_path(),
+        &shell.shell_path,
+        &session.thread_id.to_string(),
+        &step.turn.sub_id,
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn projection_uses_selected_policy_and_never_transports_secret_values() {
+        let env = HashMap::from([
+            ("PREFIX".into(), "/selected/prefix".into()),
+            ("HOME".into(), "/selected/home".into()),
+            ("PATH".into(), "/selected/prefix/bin".into()),
+            ("BASH_ENV".into(), "/private/startup".into()),
+            (
+                "OPENAI_API_KEY".into(),
+                "private-value-must-not-leave-native".into(),
+            ),
+        ]);
+        let value = project(
+            &env,
+            Path::new("/selected/work"),
+            Path::new("/selected/prefix/bin/bash"),
+            "thread",
+            "turn",
+        )
+        .unwrap();
+        assert_eq!(value["path"], "/selected/prefix/bin");
+        assert_eq!(value["prefix"], "/selected/prefix");
+        assert_eq!(value["no_default_config"], false);
+        assert!(
+            value["variables"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|name| name == "BASH_ENV")
+        );
+        let wire = value.to_string();
+        assert!(!wire.contains("/private/startup"));
+        assert!(!wire.contains("private-value-must-not-leave-native"));
+        assert!(
+            project(
+                &HashMap::new(),
+                Path::new("/work"),
+                Path::new("/bin/bash"),
+                "thread",
+                "turn"
+            )
+            .is_none()
+        );
+    }
+
+    #[test]
+    fn execution_facts_are_body_only_and_cannot_be_spoofed_by_extra_metadata() {
+        use crate::responses_metadata::CodexResponsesMetadata;
+        use crate::responses_metadata::filter_extra_metadata;
+        use crate::responses_metadata::validate_extra_metadata;
+        let mut metadata = CodexResponsesMetadata::new(
+            "installation".into(),
+            "session".into(),
+            "thread".into(),
+            "window".into(),
+        );
+        metadata.native_execution = Some(json!({"schema":1,"path":"/qualified/bin"}));
+        let forged = [(METADATA_KEY.to_owned(), "forged".to_owned())];
+        assert!(validate_extra_metadata(forged.iter().map(|(key, value)| (key, value))).is_err());
+        assert!(filter_extra_metadata(forged).is_empty());
+        assert!(metadata.client_metadata(false).contains_key(METADATA_KEY));
+        assert!(!metadata.compatibility_headers().contains_key(METADATA_KEY));
+        assert!(
+            !metadata
+                .turn_metadata_json()
+                .unwrap()
+                .contains(METADATA_KEY)
+        );
+    }
+}
