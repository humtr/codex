+                    .map(|config| &config.model_provider_id),
+            )
+            .field("turn_extension_init", &self.turn_extension_init)
+            .field("trace", &self.trace)
+            .field("parent_turn_id", &self.parent_turn_id)
+            .field("root_turn_id", &self.root_turn_id)
+            .field("residency_guard", &self.residency_guard)
+            .field("message_delivery", &self.message_delivery)
+            .finish()
+    }
+}
