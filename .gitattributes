# Unified Go patch context carries a space before source tabs and blank lines.
# git apply --whitespace=error still checks actual added source during the build.
transport/tunnel-client/termux.patch whitespace=-blank-at-eol,-space-before-tab
# Unified Rust patch context includes a space for otherwise empty source lines.
crates/release-builder/src/native_route.patch whitespace=-blank-at-eol
